[
{
"id": 3322,
"ko": "딱히 할 말은... 없어.",
"kind": "dialog",
"src": "scn:e0169_scn:1",
"speaker": "크레드",
"cap": 254
},
{
"id": 3323,
"ko": "장비 중인 걸 쓰려고?",
"kind": "dialog",
"src": "scn:e0169_scn:2",
"speaker": "크레드",
"cap": 254
},
{
"id": 3324,
"ko": "장신구가 필요해.",
"kind": "dialog",
"src": "scn:e0169_scn:3",
"speaker": "크레드",
"cap": 254
},
{
"id": 3325,
"ko": "아참... 내가 준 암즈에 깜빡하고 파츠를 하나 안 붙인 게 있었는데.",
"kind": "dialog",
"src": "scn:e0169_scn:4",
"speaker": "크레드",
"cap": 254
},
{
"id": 3326,
"ko": "...깜빡한 거였습니까?",
"kind": "dialog",
"src": "scn:e0169_scn:5",
"speaker": "티르",
"cap": 254
},
{
"id": 3327,
"ko": "파츠 슬롯을 늘리려고 했었는데 부품이 어디 갔는지 하나 없어져서 말이지.",
"kind": "dialog",
"src": "scn:e0169_scn:6",
"speaker": "크레드",
"cap": 254
},
{
"id": 3328,
"ko": "마력이 깃든 장신구가 하나 필요한데... 적당한 걸 가져오면 지금이라도 해줄게.",
"kind": "dialog",
"src": "scn:e0169_scn:7",
"speaker": "크레드",
"cap": 254
},
{
"id": 3329,
"ko": "&암즈개량;$...........{퀘스트 입수!",
"kind": "dialog",
"src": "scn:e0169_scn:8",
"cap": 254
},
{
"id": 3330,
"ko": "잠깐 기다려 봐.",
"kind": "dialog",
"src": "scn:e0169_scn:9",
"speaker": "크레드",
"cap": 254
},
{
"id": 3331,
"ko": "팔 내밀어 봐.",
"kind": "dialog",
"src": "scn:e0169_scn:10",
"speaker": "크레드",
"cap": 254
},
{
"id": 3332,
"ko": "후, 잘 됐군.",
"kind": "dialog",
"src": "scn:e0169_scn:11",
"speaker": "크레드",
"cap": 254
},
{
"id": 3333,
"ko": "내가 해줄 수 있는 건 이게 끝이니... 그럼 잘 해보라고.",
"kind": "dialog",
"src": "scn:e0169_scn:12",
"speaker": "크레드",
"cap": 254
},
{
"id": 3334,
"ko": "&암즈 개량 ;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:e0169_scn:13",
"cap": 254
},
{
"id": 3335,
"ko": "내켜서 개조하기는 했지만, 그 팔이 네베드를 해치는데 쓰인다면 좀 슬플거야...",
"kind": "dialog",
"src": "scn:e0169_scn:14",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3336,
"ko": "으음...",
"kind": "dialog",
"src": "scn:e0169_scn:15",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3337,
"ko": "도면을 가져와.",
"kind": "dialog",
"src": "scn:e0169_scn:16",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3338,
"ko": "당신이 티르로군?",
"kind": "dialog",
"src": "scn:e0169_scn:17",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3339,
"ko": "맞긴 한데... 잘 아는 것처럼 말하는군?",
"kind": "dialog",
"src": "scn:e0169_scn:18",
"speaker": "티르",
"cap": 254
},
{
"id": 3340,
"ko": "그 팔에 대해 들은 적이 있어서. 누아다 님과 같은 물건이라고.",
"kind": "dialog",
"src": "scn:e0169_scn:19",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3341,
"ko": "크래드가 처음에 제작할 때 마력이 들어가는 부분은 내가 도와줬으니까...",
"kind": "dialog",
"src": "scn:e0169_scn:20",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3342,
"ko": "좀 볼 수 있을까?",
"kind": "dialog",
"src": "scn:e0169_scn:21",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3343,
"ko": "이상한데...",
"kind": "dialog",
"src": "scn:e0169_scn:23",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3344,
"ko": "뭐가 이상하지?",
"kind": "dialog",
"src": "scn:e0169_scn:24",
"speaker": "티르",
"cap": 254
},
{
"id": 3345,
"ko": "나한테 주문해간 부품 중에 장착하지 않은 게 있는 거 같은데...?",
"kind": "dialog",
"src": "scn:e0169_scn:25",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3346,
"ko": "그런 이야기는 안했는데?",
"kind": "dialog",
"src": "scn:e0169_scn:26",
"speaker": "티르",
"cap": 254
},
{
"id": 3347,
"ko": "다른 파츠를 물려서 작동할 수 있게 하는 슬롯부분인데.",
"kind": "dialog",
"src": "scn:e0169_scn:27",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3348,
"ko": "...설마 부품을 잃어버렸나?",
"kind": "dialog",
"src": "scn:e0169_scn:28",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3349,
"ko": "그 친구라면 그랬을지도...",
"kind": "dialog",
"src": "scn:e0169_scn:29",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3350,
"ko": "크래드를... 잘 아나 보지?",
"kind": "dialog",
"src": "scn:e0169_scn:30",
"speaker": "티르",
"cap": 254
},
{
"id": 3351,
"ko": "가끔 이거저거 사러 오거나 누아다 님 팔을 점검한다고 왔었지. 내 쪽에서 찾아간 적은 없었어.",
"kind": "dialog",
"src": "scn:e0169_scn:31",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3352,
"ko": "어디 사는 지도 모르고. 데리고 다니던 여자애가 있었는데... 엘렌이었나.",
"kind": "dialog",
"src": "scn:e0169_scn:32",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3353,
"ko": "괜찮은 친구긴 했는데. 죽었다니 아쉽군.",
"kind": "dialog",
"src": "scn:e0169_scn:33",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3354,
"ko": "이야기가 엉뚱한 곳으로 샜는데...",
"kind": "dialog",
"src": "scn:e0169_scn:34",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3355,
"ko": "그렇군. 그 슬롯이라는 건 당신이 늘려볼 수도 있나?",
"kind": "dialog",
"src": "scn:e0169_scn:35",
"speaker": "티르",
"cap": 254
},
{
"id": 3356,
"ko": "부품이야 재료만 구해지면 다시 만들 수 있지만. 조립하는 건 그걸 다 분해하지 않으면 무리야.",
"kind": "dialog",
"src": "scn:e0169_scn:36",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3357,
"ko": "도면이라도 있으면 모를까...",
"kind": "dialog",
"src": "scn:e0169_scn:37",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3358,
"ko": "도면이라... 집에 다시 가본 적은 있지만 본 기억은 없는데.",
"kind": "dialog",
"src": "scn:e0169_scn:38",
"speaker": "티르",
"cap": 254
},
{
"id": 3359,
"ko": "어디 잘 숨겨 놨을지도 모르지. 튼튼한 상자 안에 넣고 잠궈놨다던가.",
"kind": "dialog",
"src": "scn:e0169_scn:39",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3360,
"ko": "그러고 보니 그런 걸 본 것 같은 기분이 들기도 하는데...",
"kind": "dialog",
"src": "scn:e0169_scn:40",
"speaker": "티르",
"cap": 254
},
{
"id": 3361,
"ko": "상자를 부수거나 하면 도면이 망가질지도 모르니까 자제하라고. 재료를 가져오면 열쇠를 만들어주지.",
"kind": "dialog",
"src": "scn:e0169_scn:41",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3362,
"ko": "&도면;$...........{퀘스트 입수!",
"kind": "dialog",
"src": "scn:e0169_scn:42",
"cap": 254
},
{
"id": 3363,
"ko": "&열쇠;$...........{퀘스트 입수!",
"kind": "dialog",
"src": "scn:e0169_scn:43",
"cap": 254
},
{
"id": 3364,
"ko": "도면도 준비되었고... 그럼 남은 건 부품인가.",
"kind": "dialog",
"src": "scn:e0169_scn:44",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3365,
"ko": "&도면;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:e0169_scn:45",
"cap": 254
},
{
"id": 3366,
"ko": "적당히 마법이 부여된 장신구가 있어야해. 준비해 오라고.",
"kind": "dialog",
"src": "scn:e0169_scn:47",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3367,
"ko": "만능열쇠 재료는 강철 10개야.",
"kind": "dialog",
"src": "scn:e0169_scn:48",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3368,
"ko": "열쇠는 여기 있으니까 도면을 가져와.",
"kind": "dialog",
"src": "scn:e0169_scn:49",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3369,
"ko": "이제 와서 이런 걸 묻는 것도 이상하긴 한데, 왜 도와주는 거지?",
"kind": "dialog",
"src": "scn:e0169_scn:50",
"speaker": "티르",
"cap": 254
},
{
"id": 3370,
"ko": "그건 뭐 크래드의 유작 같은 거니까... 조금은 완성을 보고 싶기도 하고.",
"kind": "dialog",
"src": "scn:e0169_scn:51",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3371,
"ko": "빠져 있는 걸 보면 찜찜한 기분이 드니까.",
"kind": "dialog",
"src": "scn:e0169_scn:52",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3372,
"ko": "별볼일 없는 이유군...",
"kind": "dialog",
"src": "scn:e0169_scn:53",
"speaker": "티르",
"cap": 254
},
{
"id": 3373,
"ko": "인간들이 보기는 그렇겠지.",
"kind": "dialog",
"src": "scn:e0169_scn:54",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3374,
"ko": "&열쇠;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:e0169_scn:55",
"cap": 254
},
{
"id": 3375,
"ko": "장신구를 가져오라고. 쓸데없이 말 걸지 말고.",
"kind": "dialog",
"src": "scn:e0169_scn:56",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3376,
"ko": "이제 준비가 다 되었나... 잠시 기다려.",
"kind": "dialog",
"src": "scn:e0169_scn:57",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3377,
"ko": "기계팔을 좀.",
"kind": "dialog",
"src": "scn:e0169_scn:58",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3378,
"ko": "됐군.",
"kind": "dialog",
"src": "scn:e0169_scn:59",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3379,
"ko": "고맙군.",
"kind": "dialog",
"src": "scn:e0169_scn:60",
"speaker": "티르",
"cap": 254
},
{
"id": 3380,
"ko": "됐어. 하고 싶어서 한 일이니.",
"kind": "dialog",
"src": "scn:e0169_scn:61",
"speaker": "스트레이츠",
"cap": 254
},
{
"id": 3383,
"ko": "뮤리아스로 돌아가시겠습니까?",
"kind": "dialog",
"src": "scn:e0171_scn:1",
"speaker": "남자",
"cap": 254
},
{
"id": 3384,
"ko": "그래. 보급이 좀 필요해.",
"kind": "dialog",
"src": "scn:e0171_scn:3",
"speaker": "티르",
"cap": 254
},
{
"id": 3385,
"ko": "돌아가지 않는다",
"kind": "dialog",
"src": "scn:e0171_scn:4",
"cap": 254
},
{
"id": 3386,
"ko": "북쪽으로 죽 올라가면 그 놈들의 소굴이 있습니다.",
"kind": "dialog",
"src": "scn:e0171_scn:5",
"speaker": "남자",
"cap": 254
},
{
"id": 3387,
"ko": "본보기 삼아 우두머리를 한 5마리 정도 처치하면 될 겁니다.",
"kind": "dialog",
"src": "scn:e0171_scn:6",
"speaker": "남자",
"cap": 254
},
{
"id": 3388,
"ko": "알겠어.",
"kind": "dialog",
"src": "scn:e0171_scn:7",
"speaker": "티르",
"cap": 254
},
{
"id": 3389,
"ko": "굉장하시군요... 혼자서.",
"kind": "dialog",
"src": "scn:e0171_scn:9",
"speaker": "남자",
"cap": 254
},
{
"id": 3390,
"ko": "됐고... 볼 일은 끝났으니 돌아가지.",
"kind": "dialog",
"src": "scn:e0171_scn:10",
"speaker": "티르",
"cap": 254
},
{
"id": 3391,
"ko": "예, 물론이죠.",
"kind": "dialog",
"src": "scn:e0171_scn:11",
"speaker": "남자",
"cap": 254
},
{
"id": 3392,
"ko": "&해적소굴;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:e0171_scn:12",
"cap": 254
},
{
"id": 3393,
"ko": "&해적소탕;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:e0171_scn:13",
"cap": 254
},
{
"id": 3398,
"ko": "보스룸에 들어가면 세이브 할 수 없습니다. 계속 하시겠습니까?",
"kind": "dialog",
"src": "scn:e0175_scn:1",
"cap": 254
},
{
"id": 3399,
"ko": "보스룸 진입",
"kind": "dialog",
"src": "scn:e0175_scn:2",
"cap": 254
},
{
"id": 3400,
"ko": "진입하지 않는다",
"kind": "dialog",
"src": "scn:e0175_scn:3",
"cap": 254
},
{
"id": 3402,
"ko": "흠... 뭐 이 정도면 당분간은 얌전히 있겠지.",
"kind": "dialog",
"src": "scn:e0176_scn:1",
"speaker": "티르",
"cap": 254
},
{
"id": 3403,
"ko": "그럼 이만 나가볼까...",
"kind": "dialog",
"src": "scn:e0176_scn:2",
"speaker": "티르",
"cap": 254
},
{
"id": 3404,
"ko": "겨우 고쳐놨더니! 이번엔 또 뭐냐!",
"kind": "dialog",
"src": "scn:e0176_scn:3",
"speaker": "고블린",
"cap": 254
},
{
"id": 3407,
"ko": "...어떻게 여기까지 온 거지?",
"kind": "dialog",
"src": "scn:e0178_scn:1",
"speaker": "티르",
"cap": 254
},
{
"id": 3408,
"ko": "말을 못하나? 음... 난 나쁜 사람이 아냐. 널 데려가려고 온거다. 알겠지?",
"kind": "dialog",
"src": "scn:e0178_scn:2",
"speaker": "티르",
"cap": 254
},
{
"id": 3409,
"ko": "그럼 따라와라.",
"kind": "dialog",
"src": "scn:e0178_scn:3",
"speaker": "티르",
"cap": 254
},
{
"id": 3410,
"ko": "우리의 수도, 공화국의 심장.. 다시는 못 볼 줄 알았는데.",
"kind": "dialog",
"src": "scn:e0179_scn:1",
"speaker": "티르",
"cap": 254
},
{
"id": 3411,
"ko": "왜 돌아온 거야?",
"kind": "dialog",
"src": "scn:e0179_scn:2",
"speaker": "이자벨",
"cap": 254
},
{
"id": 3412,
"ko": "루레인과 꽤 친해진 것 같던데. 그대로 눌러 앉지 그랬어?",
"kind": "dialog",
"src": "scn:e0179_scn:3",
"speaker": "이자벨",
"cap": 254
},
{
"id": 3413,
"ko": "죽이려고 한 주제에 이제와서 질투냐?",
"kind": "dialog",
"src": "scn:e0179_scn:4",
"speaker": "티르",
"cap": 254
},
{
"id": 3414,
"ko": "너희가 가짜 케프네스까지 내세워가며 날 반역자로 몰고 있으니 어쩔 수 없잖아.",
"kind": "dialog",
"src": "scn:e0179_scn:5",
"speaker": "티르",
"cap": 254
},
{
"id": 3415,
"ko": "그럼 항복해.",
"kind": "dialog",
"src": "scn:e0179_scn:6",
"speaker": "이자벨",
"cap": 254
},
{
"id": 3416,
"ko": "명예와 직위, 원한다면 능력도 회복시켜 줄 수 있어.",
"kind": "dialog",
"src": "scn:e0179_scn:7",
"speaker": "이자벨",
"cap": 254
},
{
"id": 3417,
"ko": "혹시나 했는데.. 아직도 계속할 셈인가?",
"kind": "dialog",
"src": "scn:e0179_scn:8",
"speaker": "티르",
"cap": 254
},
{
"id": 3418,
"ko": "세계멸망의 폭탄에 불을 붙여 놓고도 그걸 해체할 생각은 안하는 거야?",
"kind": "dialog",
"src": "scn:e0179_scn:9",
"speaker": "티르",
"cap": 254
},
{
"id": 3419,
"ko": "웨이드 가의 가주는 대체 무슨 생각을 하고 있는 거지?",
"kind": "dialog",
"src": "scn:e0179_scn:10",
"speaker": "티르",
"cap": 254
},
{
"id": 3420,
"ko": "언제나 공화국을 위해, 인간을 위해.",
"kind": "dialog",
"src": "scn:e0179_scn:11",
"speaker": "이자벨",
"cap": 254
},
{
"id": 3421,
"ko": "우리를 비난하러 돌아온 거야?",
"kind": "dialog",
"src": "scn:e0179_scn:12",
"speaker": "이자벨",
"cap": 254
},
{
"id": 3422,
"ko": "아니면 브리안의 복수라도 할 셈인가?",
"kind": "dialog",
"src": "scn:e0179_scn:13",
"speaker": "이자벨",
"cap": 254
},
{
"id": 3423,
"ko": "아니, 이건 그냥 재확인일 뿐이야.",
"kind": "dialog",
"src": "scn:e0179_scn:14",
"speaker": "티르",
"cap": 254
},
{
"id": 3424,
"ko": "너희는 내 적이라는 확인.",
"kind": "dialog",
"src": "scn:e0179_scn:15",
"speaker": "티르",
"cap": 254
},
{
"id": 3425,
"ko": "널 만나자고 한 건 선전포고를 하기 위해서야.",
"kind": "dialog",
"src": "scn:e0179_scn:16",
"speaker": "티르",
"cap": 254
},
{
"id": 3426,
"ko": "... 선전포고?",
"kind": "dialog",
"src": "scn:e0179_scn:17",
"speaker": "이자벨",
"cap": 254
},
{
"id": 3427,
"ko": "그래. 전쟁을 시작하자.",
"kind": "dialog",
"src": "scn:e0179_scn:18",
"speaker": "티르",
"cap": 254
},
{
"id": 3428,
"ko": "나는 케프네스가 남긴 유산, 듣는 자들을 정리할 거야.",
"kind": "dialog",
"src": "scn:e0179_scn:19",
"speaker": "티르",
"cap": 254
},
{
"id": 3429,
"ko": "하나도 남김없이 파괴하고 너희가 저지른 모든 기만과 싸울 거다.",
"kind": "dialog",
"src": "scn:e0179_scn:20",
"speaker": "티르",
"cap": 254
},
{
"id": 3430,
"ko": "그러기 위해 돌아왔어.",
"kind": "dialog",
"src": "scn:e0179_scn:21",
"speaker": "티르",
"cap": 254
},
{
"id": 3431,
"ko": "... 이길 수 있을 거라고 생각해?",
"kind": "dialog",
"src": "scn:e0179_scn:22",
"speaker": "이자벨",
"cap": 254
},
{
"id": 3432,
"ko": "이길거야.",
"kind": "dialog",
"src": "scn:e0179_scn:23",
"speaker": "티르",
"cap": 254
},
{
"id": 3433,
"ko": ".. 네 뜻이 그렇다면, 그렇게 전하겠어.",
"kind": "dialog",
"src": "scn:e0179_scn:24",
"speaker": "이자벨",
"cap": 254
},
{
"id": 3434,
"ko": "그럼, 이제 다시 볼 일은 없겠군.",
"kind": "dialog",
"src": "scn:e0179_scn:25",
"speaker": "이자벨",
"cap": 254
},
{
"id": 3435,
"ko": "곧 보게 될 거야.",
"kind": "dialog",
"src": "scn:e0179_scn:26",
"speaker": "티르",
"cap": 254
},
{
"id": 3436,
"ko": "너 역시 듣는 자니까.",
"kind": "dialog",
"src": "scn:e0179_scn:27",
"speaker": "티르",
"cap": 254
},
{
"id": 3437,
"ko": "... 혹독한 겨울이 될 것 같네.",
"kind": "dialog",
"src": "scn:e0179_scn:28",
"speaker": "이자벨",
"cap": 254
},
{
"id": 3438,
"ko": "이제 시작이야.",
"kind": "dialog",
"src": "scn:e0179_scn:29",
"speaker": "티르",
"cap": 254
},
{
"id": 3439,
"ko": "이제야 겨우.. 시작인거야.",
"kind": "dialog",
"src": "scn:e0179_scn:30",
"speaker": "티르",
"cap": 254
},
{
"id": 3440,
"ko": "오랜만이군. 균열은 어때? 난 전혀 알 수 없으니 답답한데.",
"kind": "dialog",
"src": "scn:e0179_scn:31",
"speaker": "티르",
"cap": 254
},
{
"id": 3441,
"ko": "계속 넓어지고 있어요. 아직까지는 특별한 변화는 없지만..",
"kind": "dialog",
"src": "scn:e0179_scn:32",
"speaker": "루레인",
"cap": 254
},
{
"id": 3442,
"ko": "균열을 막는 방법 같은 건?",
"kind": "dialog",
"src": "scn:e0179_scn:33",
"speaker": "티르",
"cap": 254
},
{
"id": 3443,
"ko": "별 성과는 없어요.",
"kind": "dialog",
"src": "scn:e0179_scn:34",
"speaker": "루레인",
"cap": 254
},
{
"id": 3444,
"ko": "티르. 혹시 크래드가 그 쪽으로 가지 않았나요?",
"kind": "dialog",
"src": "scn:e0179_scn:35",
"speaker": "루레인",
"cap": 254
},
{
"id": 3445,
"ko": "아니. 혹시나 해서 크래드의 집도 가봤지만 없었어.",
"kind": "dialog",
"src": "scn:e0179_scn:36",
"speaker": "티르",
"cap": 254
},
{
"id": 3446,
"ko": "당신은.. 그가 뭐일거라고 생각하나요?",
"kind": "dialog",
"src": "scn:e0179_scn:37",
"speaker": "루레인",
"cap": 254
},
{
"id": 3447,
"ko": "무슨 의미지?",
"kind": "dialog",
"src": "scn:e0179_scn:38",
"speaker": "티르",
"cap": 254
},
{
"id": 3448,
"ko": "최소한 50년 이상 살아왔고, 그러면서 조금도 늙지 않았고, 죽지도 않는 인간...",
"kind": "dialog",
"src": "scn:e0179_scn:39",
"speaker": "루레인",
"cap": 254
},
{
"id": 3449,
"ko": "아니, 인간이긴 한 걸까요? 그런 인간이 존재한다고 생각해요?",
"kind": "dialog",
"src": "scn:e0179_scn:40",
"speaker": "루레인",
"cap": 254
},
{
"id": 3450,
"ko": "네베드는 아니에요. 그리고 가디언... 고대신의 종복도 아니에요.",
"kind": "dialog",
"src": "scn:e0179_scn:41",
"speaker": "루레인",
"cap": 254
},
{
"id": 3451,
"ko": "그건 확실해. 가디언이었다면 케프네스나 브리안이 몰랐을 리가 없으니까.",
"kind": "dialog",
"src": "scn:e0179_scn:42",
"speaker": "티르",
"cap": 254
},
{
"id": 3452,
"ko": "그리고 크리스탈을 가지고 있고, 그 사용법을 아는 자라면...",
"kind": "dialog",
"src": "scn:e0179_scn:43",
"speaker": "루레인",
"cap": 254
},
{
"id": 3453,
"ko": "크리스탈은 케프네스가 봉인되어 있던 곳에서 찾은 거라고 하던데?",
"kind": "dialog",
"src": "scn:e0179_scn:44",
"speaker": "티르",
"cap": 254
},
{
"id": 3454,
"ko": "무슨 소리에요? }크래드의 일지{에는 그런 이야기는 한 마디도 없었어요. 그는 }내가 가지고 있던 크리스탈{ 이라고 했어요.",
"kind": "dialog",
"src": "scn:e0179_scn:45",
"speaker": "루레인",
"cap": 254
},
{
"id": 3455,
"ko": "그리고 봉인을 파괴하는 물건을 봉인 옆에 뒀을 리가 없잖아요?",
"kind": "dialog",
"src": "scn:e0179_scn:46",
"speaker": "루레인",
"cap": 254
},
{
"id": 3456,
"ko": "거짓말을.. 했다는 건가? 그렇다면 뭐지?",
"kind": "dialog",
"src": "scn:e0179_scn:47",
"speaker": "티르",
"cap": 254
},
{
"id": 3457,
"ko": "크리스탈을 가지고, 늙지도, 죽지도 않고. 네베드와 고대신에 대해 모두 잘 알고 있는 존재라면.. 하나뿐이에요.",
"kind": "dialog",
"src": "scn:e0179_scn:48",
"speaker": "루레인",
"cap": 254
},
{
"id": 3458,
"ko": ".. 강림자? 크래드가 강림자.. 그 }솔티안{인가 뭔가라고 말하려는 건 아니겠지?",
"kind": "dialog",
"src": "scn:e0179_scn:49",
"speaker": "티르",
"cap": 254
},
{
"id": 3459,
"ko": "전... 그렇게 생각해요.",
"kind": "dialog",
"src": "scn:e0179_scn:50",
"speaker": "루레인",
"cap": 254
},
{
"id": 3460,
"ko": "그가 강림자라면 왜 케프네스를 풀어준 거지? 왜 천년 전에 어렵게 싸워서 봉인한 존재를, 자신의 숙적을 다시 풀어줘서 세계를 멸망시키려는 거지?",
"kind": "dialog",
"src": "scn:e0179_scn:51",
"speaker": "티르",
"cap": 254
},
{
"id": 3461,
"ko": "풀어주지는 않았죠. 그를 조종하는 연구를 했을 뿐… 케프네스가 풀려난 건 인간들 사이의 암투 때문이 아니었나요?",
"kind": "dialog",
"src": "scn:e0179_scn:52",
"speaker": "루레인",
"cap": 254
},
{
"id": 3462,
"ko": "만일 그렇다면..",
"kind": "dialog",
"src": "scn:e0179_scn:53",
"speaker": "티르",
"cap": 254
},
{
"id": 3463,
"ko": "결국 그가 모든 일의 시작이에요.",
"kind": "dialog",
"src": "scn:e0179_scn:54",
"speaker": "루레인",
"cap": 254
},
{
"id": 3464,
"ko": "아마.. 왠지 모르지만, 이 일의 끝 에서도… 그가 있을 것 같은, 그런 예감이 들어요. 이 일의 열쇠를 가지고 있는 사람은 그 일거라고...",
"kind": "dialog",
"src": "scn:e0179_scn:55",
"speaker": "루레인",
"cap": 254
},
{
"id": 3465,
"ko": "답은 맞지만, 추리에 너무 억지가 많아, 루레인. 60점 정도 밖에 못 주겠군.",
"kind": "dialog",
"src": "scn:e0179_scn:56",
"speaker": "크레드",
"cap": 254
},
{
"id": 3466,
"ko": "그리고.. 인간의 멸종도, 네베드의 멸종도 }세계의 멸망{은 아니라고.",
"kind": "dialog",
"src": "scn:e0179_scn:57",
"speaker": "크레드",
"cap": 254
},
{
"id": 3467,
"ko": "케프네스 덕분에 예정이 상당히 틀어지기는 했지만.. 어떻게든 되려나. 그걸 막은 건 저 둘이었지.",
"kind": "dialog",
"src": "scn:e0179_scn:58",
"speaker": "크레드",
"cap": 254
},
{
"id": 3468,
"ko": "나중에 따로 감사 선물을 줘야겠군.",
"kind": "dialog",
"src": "scn:e0179_scn:59",
"speaker": "크레드",
"cap": 254
},
{
"id": 3469,
"ko": "그럼.. 다시 시작해 볼까.. 늦지 않았어야 하는데.",
"kind": "dialog",
"src": "scn:e0179_scn:60",
"speaker": "크레드",
"cap": 254
},
{
"id": 3471,
"ko": "배를 옮겨타면 세이브를 할 수 없습니다. 계속하시겠습니까?",
"kind": "dialog",
"src": "scn:e0016_scn:3",
"cap": 254
},
{
"id": 3472,
"ko": "현재 슬롯이 자동저장되고 네트워크 창고에 접속됩니다. 계속하시겠습니까?",
"kind": "dialog",
"src": "scn:e0027_scn:1",
"speaker": "네트워크",
"cap": 254
},
{
"id": 3473,
"ko": "네트워크 접속",
"kind": "dialog",
"src": "scn:e0027_scn:2",
"cap": 254
},
{
"id": 3474,
"ko": "네트워크 이용에 대한 설명을 들으시겠습니까?",
"kind": "dialog",
"src": "scn:e0049_scn:102",
"speaker": "네트워크",
"cap": 254
},
{
"id": 3475,
"ko": "네트워크 창고는 아이템을 보관하거나, 보관 중인 아이템을 현재 캐릭터의 인벤토리로 내려 받을 수 있는 창고입니다.",
"kind": "dialog",
"src": "scn:e0049_scn:104",
"cap": 254
},
{
"id": 3476,
"ko": "네트워크 창고를 이용하기 위해서는 마을에 있는 네트워크 NPC에게 말을 거시면 됩니다.",
"kind": "dialog",
"src": "scn:e0049_scn:105",
"cap": 254
},
{
"id": 3477,
"ko": "별도로 네트워크 상점을 이용하시기 위해서는 메뉴 키를 눌러주세요.",
"kind": "dialog",
"src": "scn:e0049_scn:106",
"cap": 254
},
{
"id": 3478,
"ko": "네트워크 상점에서는 게임에 도움이 되는 다양한 아이템을 구매하실 수 있습니다.",
"kind": "dialog",
"src": "scn:e0049_scn:107",
"cap": 254
},
{
"id": 3479,
"ko": "&네트워크 설명;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:e0049_scn:113",
"cap": 254
},
{
"id": 3480,
"ko": "음.. 무슨 일이 생길지 몰라. 좀더 확실히 준비해서 가자.",
"kind": "dialog",
"src": "scn:e0064_scn:66",
"speaker": "티르",
"cap": 254
},
{
