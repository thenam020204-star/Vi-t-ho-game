[
{
"id": 2062,
"ko": "<선착장{에 있는 <배{ 안에서 만나자고 하십니다.",
"kind": "dialog",
"src": "scn:e0065_scn:1",
"speaker": "여관관리인",
"cap": 254
},
{
"id": 2063,
"ko": "}이자벨{ 님 말씀이십니까?",
"kind": "dialog",
"src": "scn:e0065_scn:2",
"speaker": "여관관리인",
"cap": 254
},
{
"id": 2064,
"ko": "어떻게 알고 오셨습니까?",
"kind": "dialog",
"src": "scn:e0065_scn:3",
"speaker": "여관관리인",
"cap": 254
},
{
"id": 2065,
"ko": "연락할 일이 있으면 이쪽으로 연락하라고 했어. 뭐가 문제지?",
"kind": "dialog",
"src": "scn:e0065_scn:4",
"speaker": "티르",
"cap": 254
},
{
"id": 2066,
"ko": "아닙니다. 뭐라고 전해드릴까요?",
"kind": "dialog",
"src": "scn:e0065_scn:5",
"speaker": "여관관리인",
"cap": 254
},
{
"id": 2067,
"ko": "종이와 펜을 주지 않겠나? 편지를 쓸테니.",
"kind": "dialog",
"src": "scn:e0065_scn:6",
"speaker": "티르",
"cap": 254
},
{
"id": 2068,
"ko": "손님 왼편에 메모지가 있습니다.",
"kind": "dialog",
"src": "scn:e0065_scn:7",
"speaker": "여관관리인",
"cap": 254
},
{
"id": 2069,
"ko": "믿을 수 없겠지만;지금 뮤리아스에 있는 티르는;진짜가 아니야.",
"kind": "dialog",
"src": "scn:e0065_scn:8",
"cap": 254
},
{
"id": 2070,
"ko": "케프네스 사령관을;만나고 싶어.;도움이 필요해.;=           &티르{",
"kind": "dialog",
"src": "scn:e0065_scn:9",
"cap": 254
},
{
"id": 2071,
"ko": "이 정도면 되려나...",
"kind": "dialog",
"src": "scn:e0065_scn:10",
"speaker": "티르",
"cap": 254
},
{
"id": 2072,
"ko": "흠.. 잠시만 기다려 주십시오.",
"kind": "dialog",
"src": "scn:e0065_scn:11",
"speaker": "여관관리인",
"cap": 254
},
{
"id": 2073,
"ko": "좋아..",
"kind": "dialog",
"src": "scn:e0065_scn:12",
"speaker": "티르",
"cap": 254
},
{
"id": 2074,
"ko": "아직은 경계태세 일거야.. 조심하자.",
"kind": "dialog",
"src": "scn:e0067_scn:1",
"speaker": "티르",
"cap": 254
},
{
"id": 2075,
"ko": "티르. 제대로 찾아왔구나.",
"kind": "dialog",
"src": "scn:e0068_scn:1",
"speaker": "남자",
"cap": 254
},
{
"id": 2076,
"ko": "놀랄 것 없다. }케프네스{다.",
"kind": "dialog",
"src": "scn:e0068_scn:2",
"speaker": "남자",
"cap": 254
},
{
"id": 2077,
"ko": "대... 장?",
"kind": "dialog",
"src": "scn:e0068_scn:3",
"speaker": "티르",
"cap": 254
},
{
"id": 2078,
"ko": "그래. 이 남자를 }정신 제압{해서 내 말을 전하고 있다.",
"kind": "dialog",
"src": "scn:e0068_scn:4",
"speaker": "남자",
"cap": 254
},
{
"id": 2079,
"ko": "무슨 일이 있었던 겁니까?",
"kind": "dialog",
"src": "scn:e0068_scn:5",
"speaker": "티르",
"cap": 254
},
{
"id": 2080,
"ko": "<반란{이 일어났다. 아직 일반에는 알려지지 않았지만..",
"kind": "dialog",
"src": "scn:e0068_scn:6",
"speaker": "남자",
"cap": 254
},
{
"id": 2081,
"ko": "반란 세력은 <브리안{을 주축으로 해서 나를 감금한 상태다. 너는 브리안에게 몸을 빼앗긴거지..?",
"kind": "dialog",
"src": "scn:e0068_scn:7",
"speaker": "남자",
"cap": 254
},
{
"id": 2082,
"ko": "미안하다.",
"kind": "dialog",
"src": "scn:e0068_scn:8",
"speaker": "남자",
"cap": 254
},
{
"id": 2083,
"ko": "브리안이 그런 야망을 품고 있는 줄 알아차렸어야 했는데. 덕분에 너까지 말려들게 했어.",
"kind": "dialog",
"src": "scn:e0068_scn:9",
"speaker": "남자",
"cap": 254
},
{
"id": 2084,
"ko": "유적 조사에서 돌아온 이후에 이상한 점을 느끼고 널 찾으려고 했는데 찾을 수가 없엇다.",
"kind": "dialog",
"src": "scn:e0068_scn:10",
"speaker": "남자",
"cap": 254
},
{
"id": 2085,
"ko": "여태 어디에 있었던 거냐?",
"kind": "dialog",
"src": "scn:e0068_scn:11",
"speaker": "남자",
"cap": 254
},
{
"id": 2086,
"ko": "브리안에게 당하면서 }듣는 능력{을 잃어버렸습니다. 게다가 부상까지 입은 상태여서..",
"kind": "dialog",
"src": "scn:e0068_scn:12",
"speaker": "티르",
"cap": 254
},
{
"id": 2087,
"ko": "회복되자 마자 바로 대장을 찾아 왔습니다만.. 늦어졌습니다..",
"kind": "dialog",
"src": "scn:e0068_scn:13",
"speaker": "티르",
"cap": 254
},
{
"id": 2088,
"ko": "지금은, 브리안이 군을 장악하고 있는 겁니까?",
"kind": "dialog",
"src": "scn:e0068_scn:14",
"speaker": "티르",
"cap": 254
},
{
"id": 2089,
"ko": "그래.. 대부분은 너의 이름을 빌린 브리안의 회유에 넘어갔고 반대파들은 제거되었다.",
"kind": "dialog",
"src": "scn:e0068_scn:15",
"speaker": "남자",
"cap": 254
},
{
"id": 2090,
"ko": "빌어먹을... }이자벨{도 한 패입니까?",
"kind": "dialog",
"src": "scn:e0068_scn:16",
"speaker": "티르",
"cap": 254
},
{
"id": 2091,
"ko": "그렇다. 현재 군에 남아있는 자들은 <대부분 적{이라고 생각하면 된다.",
"kind": "dialog",
"src": "scn:e0068_scn:17",
"speaker": "남자",
"cap": 254
},
{
"id": 2092,
"ko": "지금 어디에 감금되어 계신 겁니까? 제가 당장 구하러 가겠습니다.",
"kind": "dialog",
"src": "scn:e0068_scn:18",
"speaker": "티르",
"cap": 254
},
{
"id": 2093,
"ko": "아직은 때가 아니다.",
"kind": "dialog",
"src": "scn:e0068_scn:19",
"speaker": "남자",
"cap": 254
},
{
"id": 2094,
"ko": "대장이 다시 모습을 드러내면 군을 움직일 수 있을 겁니다.",
"kind": "dialog",
"src": "scn:e0068_scn:20",
"speaker": "티르",
"cap": 254
},
{
"id": 2095,
"ko": "그러면 진짜 내전이 일어나게 된다. 아직 선주종과의 전쟁이 끝난 게 아냐.",
"kind": "dialog",
"src": "scn:e0068_scn:21",
"speaker": "남자",
"cap": 254
},
{
"id": 2096,
"ko": "티르, 다시 한번 날 도와주겠나?",
"kind": "dialog",
"src": "scn:e0068_scn:22",
"speaker": "남자",
"cap": 254
},
{
"id": 2097,
"ko": "어떻게 하면 됩니까?",
"kind": "dialog",
"src": "scn:e0068_scn:23",
"speaker": "티르",
"cap": 254
},
{
"id": 2098,
"ko": "일단은 브리안을 제압해야 하겠지. <검은 바위 섬{으로 가라.",
"kind": "dialog",
"src": "scn:e0068_scn:24",
"speaker": "남자",
"cap": 254
},
{
"id": 2099,
"ko": "거기에 믿을 만한, 내 <다른 부하{가 있다. 브리안이 가둬놓고 있지만..",
"kind": "dialog",
"src": "scn:e0068_scn:25",
"speaker": "남자",
"cap": 254
},
{
"id": 2100,
"ko": "그 자를 구해서 전력으로 삼아라. 브리안을 제압하면 네몸을 되찾을 방법도 찾을 수 있을거야.",
"kind": "dialog",
"src": "scn:e0068_scn:26",
"speaker": "남자",
"cap": 254
},
{
"id": 2101,
"ko": "부탁한다, 티르. 이 몸을 이용하는 건.. 여기까지 인 것 같다.",
"kind": "dialog",
"src": "scn:e0068_scn:27",
"speaker": "남자",
"cap": 254
},
{
"id": 2102,
"ko": "&케프네스;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:e0068_scn:28",
"cap": 254
},
{
"id": 2103,
"ko": "<검은 바위 섬{이라.. 배를 타야겠는데.",
"kind": "dialog",
"src": "scn:e0068_scn:29",
"speaker": "티르",
"cap": 254
},
{
"id": 2104,
"ko": "위험하지만 }프로비던스{로 돌아가는 수 밖에 없군.",
"kind": "dialog",
"src": "scn:e0068_scn:30",
"speaker": "티르",
"cap": 254
},
{
"id": 2105,
"ko": "&검은바위섬;$...........{퀘스트 입수!",
"kind": "dialog",
"src": "scn:e0068_scn:31",
"cap": 254
},
{
"id": 2106,
"ko": "허가증이 없으면 팔지 못합니다.",
"kind": "dialog",
"src": "scn:e0069_scn:5",
"speaker": "엔지니어",
"cap": 254
},
{
"id": 2107,
"ko": "출입 통제 구역입니다. 물러나 주세요.",
"kind": "dialog",
"src": "scn:e0069_scn:6",
"speaker": "병사",
"cap": 254
},
{
"id": 2108,
"ko": "들어가십시오.",
"kind": "dialog",
"src": "scn:e0069_scn:7",
"speaker": "병사",
"cap": 254
},
{
"id": 2109,
"ko": "호위가 매일 바뀌는 구만, 저 인간은..",
"kind": "dialog",
"src": "scn:e0069_scn:8",
"speaker": "병사",
"cap": 254
},
{
"id": 2110,
"ko": "}전부 다 같은 사람{이라는 소문이 있는데 사실일까나..?",
"kind": "dialog",
"src": "scn:e0069_scn:9",
"speaker": "병사",
"cap": 254
},
{
"id": 2111,
"ko": "원하는 물건이 있으신가요?",
"kind": "dialog",
"src": "scn:e0069_scn:10",
"speaker": "상인",
"cap": 254
},
{
"id": 2112,
"ko": "물건들을 놔두고 도망칠 수는 없잖아요...?",
"kind": "dialog",
"src": "scn:e0069_scn:11",
"speaker": "상인",
"cap": 254
},
{
"id": 2113,
"ko": "제련석을 많이 넣으면 성공률이 올라갑니다.",
"kind": "dialog",
"src": "scn:e0069_scn:12",
"speaker": "대장장이",
"cap": 254
},
{
"id": 2114,
"ko": "왜 남아 있냐니... 못 도망간거죠...",
"kind": "dialog",
"src": "scn:e0069_scn:13",
"speaker": "대장장이",
"cap": 254
},
{
"id": 2115,
"ko": "그냥 좀 잊어줘요...",
"kind": "dialog",
"src": "scn:e0069_scn:14",
"speaker": "안톤",
"cap": 254
},
{
"id": 2116,
"ko": "그럼, 잠시만 기다려보세요. 호송선에 군수물자를 등록하고 올게요.",
"kind": "dialog",
"src": "scn:e0069_scn:15",
"speaker": "안톤",
"cap": 254
},
{
"id": 2117,
"ko": "이제 이 <통행증{을 가져가시면 호송선에 탑승할 수 있을거예요.",
"kind": "dialog",
"src": "scn:e0069_scn:16",
"speaker": "안톤",
"cap": 254
},
{
"id": 2118,
"ko": "원래 네가 배치되었던 자리에 말이지?",
"kind": "dialog",
"src": "scn:e0069_scn:17",
"speaker": "티르",
"cap": 254
},
{
"id": 2119,
"ko": "그... 뭐, 좋은 게 좋은 거 아니겠어요? 당신도 <뮤리아스{에 가야하니..",
"kind": "dialog",
"src": "scn:e0069_scn:18",
"speaker": "안톤",
"cap": 254
},
{
"id": 2120,
"ko": "다물어. 기억해두겠어, 너.",
"kind": "dialog",
"src": "scn:e0069_scn:19",
"speaker": "티르",
"cap": 254
},
{
"id": 2121,
"ko": "&추가병력 합류;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:e0069_scn:20",
"cap": 254
},
{
"id": 2122,
"ko": "오호.. 조금 부족한 것도 같은데... 생각보다 강하진 않으시군요?",
"kind": "dialog",
"src": "scn:e0069_scn:21",
"speaker": "안톤",
"cap": 254
},
{
"id": 2123,
"ko": "모자르면 네가 빼돌린 것들로 충당하라고 전해줄까?",
"kind": "dialog",
"src": "scn:e0069_scn:22",
"speaker": "티르",
"cap": 254
},
{
"id": 2124,
"ko": "아.. 아녜요. 제가 어떻게든 해볼게요.",
"kind": "dialog",
"src": "scn:e0069_scn:23",
"speaker": "안톤",
"cap": 254
},
{
"id": 2125,
"ko": "&고블린 약탈;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:e0069_scn:24",
"cap": 254
},
{
"id": 2126,
"ko": "오오, 이 정도면 충분하겠는데요? 이렇게 짧은 시간에..",
"kind": "dialog",
"src": "scn:e0069_scn:25",
"speaker": "안톤",
"cap": 254
},
{
"id": 2127,
"ko": "고블린 따위를 상대로 무슨.. 네 놈은 지옥훈련이 필요하겠어.",
"kind": "dialog",
"src": "scn:e0069_scn:26",
"speaker": "티르",
"cap": 254
},
{
"id": 2128,
"ko": "하.. 하.. 엄격하시기는..",
"kind": "dialog",
"src": "scn:e0069_scn:27",
"speaker": "안톤",
"cap": 254
},
{
"id": 2129,
"ko": "워.. 원더풀! 이건 뭐 고블린 부락이 초토화되었겠군요!",
"kind": "dialog",
"src": "scn:e0069_scn:28",
"speaker": "안톤",
"cap": 254
},
{
"id": 2130,
"ko": "이 정도면 지원물자 보내고 남은 걸로..",
"kind": "dialog",
"src": "scn:e0069_scn:29",
"speaker": "안톤",
"cap": 254
},
{
"id": 2131,
"ko": "빼돌릴 생각은 하지마.",
"kind": "dialog",
"src": "scn:e0069_scn:30",
"speaker": "티르",
"cap": 254
},
{
"id": 2132,
"ko": "나중에 확인해보고 1그램이라도 모자르면 7명의 죄인과 함께 검은 방에 쳐넣어버린다.",
"kind": "dialog",
"src": "scn:e0069_scn:31",
"speaker": "티르",
"cap": 254
},
{
"id": 2133,
"ko": "헉! 심판자 허강민이 있다는 죽음의 감옥?!",
"kind": "dialog",
"src": "scn:e0069_scn:32",
"speaker": "안톤",
"cap": 254
},
{
"id": 2134,
"ko": "제발 그것만은.. 일처리 완벽하게 할테니...",
"kind": "dialog",
"src": "scn:e0069_scn:33",
"speaker": "안톤",
"cap": 254
},
{
"id": 2135,
"ko": "|(... 이거 약빨 죽이는군 그래...)",
"kind": "dialog",
"src": "scn:e0069_scn:34",
"speaker": "티르",
"cap": 254
},
{
"id": 2136,
"ko": "지원군이 출발할 때까진 아직 시간이 좀 있지만, 서두르셔야 할 겁니다.",
"kind": "dialog",
"src": "scn:e0069_scn:35",
"speaker": "안톤",
"cap": 254
},
{
"id": 2137,
"ko": "어이, 잠깐 나 좀 보지.",
"kind": "dialog",
"src": "scn:e0069_scn:36",
"speaker": "티르",
"cap": 254
},
{
"id": 2138,
"ko": "다.. 당신 뭐야? 왜이래?",
"kind": "dialog",
"src": "scn:e0069_scn:37",
"speaker": "안톤",
"cap": 254
},
{
"id": 2139,
"ko": "}수레바퀴 섬{에서 근무한 적 있지?",
"kind": "dialog",
"src": "scn:e0069_scn:38",
"speaker": "티르",
"cap": 254
},
{
"id": 2140,
"ko": ".. 그.. 그게 왜.. 마.. 말로 하자고..",
"kind": "dialog",
"src": "scn:e0069_scn:39",
"speaker": "안톤",
"cap": 254
},
{
"id": 2141,
"ko": "군수품 빼돌린 거 다 알고 왔어. 곱게 넘어갈 생각하지 말라고.",
"kind": "dialog",
"src": "scn:e0069_scn:40",
"speaker": "티르",
"cap": 254
},
{
"id": 2142,
"ko": "어.. 그걸.. 어떻게..",
"kind": "dialog",
"src": "scn:e0069_scn:41",
"speaker": "안톤",
"cap": 254
},
{
"id": 2143,
"ko": "급하니까 용건만 말하지.. 앞으로 잠시동안만 내 말을 잘 들어주면 그냥 넘어가 줄 수 있어.",
"kind": "dialog",
"src": "scn:e0069_scn:42",
"speaker": "티르",
"cap": 254
},
{
"id": 2144,
"ko": "자.. 잠시만요.. 저도 다 사정이...",
"kind": "dialog",
"src": "scn:e0069_scn:43",
"speaker": "안톤",
"cap": 254
},
{
"id": 2145,
"ko": "}뮤리아스 섬{으로 가는 }지원 병력{에 합류하고 싶다. 방법이 있나?",
"kind": "dialog",
"src": "scn:e0069_scn:45",
"speaker": "티르",
"cap": 254
},
{
"id": 2146,
"ko": "저.. 정말인가요? 뮤리아스에 가고 싶다구요?",
"kind": "dialog",
"src": "scn:e0069_scn:46",
"speaker": "안톤",
"cap": 254
},
{
"id": 2147,
"ko": "|(뭐지 이놈.. 이 구원받았다는 듯한 표정은.. 불길한데..)",
"kind": "dialog",
"src": "scn:e0069_scn:47",
"speaker": "티르",
"cap": 254
},
{
"id": 2148,
"ko": "도와 드립죠! 도와 드리고 말구요! 방법은 있습니다!",
"kind": "dialog",
"src": "scn:e0069_scn:48",
"speaker": "안톤",
"cap": 254
},
{
"id": 2149,
"ko": "... 말해봐.",
"kind": "dialog",
"src": "scn:e0069_scn:49",
"speaker": "티르",
"cap": 254
},
{
"id": 2150,
"ko": "일단 통행증은 제 것을 쓰시면 되구요! 문제는 }군수물자{죠!",
"kind": "dialog",
"src": "scn:e0069_scn:50",
"speaker": "안톤",
"cap": 254
},
{
"id": 2151,
"ko": "이번 지원군이 대규모의 군수물자를 뮤리아스에 보내주기러 했거든요.",
"kind": "dialog",
"src": "scn:e0069_scn:51",
"speaker": "안톤",
"cap": 254
},
{
"id": 2152,
"ko": "그런데 그 군수물자를 망할 }고블린{ 들이 훔쳐간 겁니다! 완전 낭패인거죠!",
"kind": "dialog",
"src": "scn:e0069_scn:52",
"speaker": "안톤",
"cap": 254
},
{
"id": 2153,
"ko": "그러니까 당신이 <고블린{들로부터 그 <군수물자{를 되찾아..",
"kind": "dialog",
"src": "scn:e0069_scn:53",
"speaker": "안톤",
"cap": 254
},
{
"id": 2154,
"ko": "그러니까.",
"kind": "dialog",
"src": "scn:e0069_scn:54",
"speaker": "티르",
"cap": 254
},
{
"id": 2155,
"ko": "군수물자 담당인데 그걸 잃어버려서 네놈도 못 돌아가고 있다는 거로구나?",
"kind": "dialog",
"src": "scn:e0069_scn:55",
"speaker": "티르",
"cap": 254
},
{
"id": 2156,
"ko": "그게.. 사실 전 별로 가고 싶지 않기도 하고.. 헤헤헤..",
"kind": "dialog",
"src": "scn:e0069_scn:56",
"speaker": "안톤",
"cap": 254
},
{
"id": 2157,
"ko": "|(이 자식... 어머니 어쩌고 하는 것도 다 거짓말이었구만!)",
"kind": "dialog",
"src": "scn:e0069_scn:57",
"speaker": "티르",
"cap": 254
},
{
"id": 2158,
"ko": "|(어쨌든.. 지금은 케프네스님의 명이 우선이다. 이놈을 족치는 건 나중으로 미루자.)",
"kind": "dialog",
"src": "scn:e0069_scn:58",
"speaker": "티르",
"cap": 254
},
{
"id": 2159,
"ko": "좋아. 내가 군수물자를 되찾아 너 대신 뮤리아스에 가겠다.",
"kind": "dialog",
"src": "scn:e0069_scn:59",
"speaker": "티르",
"cap": 254
},
{
"id": 2160,
"ko": "그럼 ^출<동}하'세`요{!! <고블린{들이 훔쳐간 <10개의 군수물자{를 찾아오시면 통행증을 드립니다!",
"kind": "dialog",
"src": "scn:e0069_scn:60",
"speaker": "안톤",
"cap": 254
},
{
"id": 2161,
"ko": "|(이 놈은 기억해두자...)",
"kind": "dialog",
"src": "scn:e0069_scn:61",
"speaker": "티르",
"cap": 254
},
{
"id": 2162,
"ko": "&고블린 약탈;$...........{퀘스트 입수!",
"kind": "dialog",
"src": "scn:e0069_scn:62",
"cap": 254
},
{
"id": 2163,
"ko": "원래 여긴 병력이 별로 없어요. 이미 점령이 끝난 구역이니까요.",
"kind": "dialog",
"src": "scn:e0069_scn:63",
"speaker": "병사",
"cap": 254
},
{
"id": 2164,
"ko": "아, 출입제한 구역은 예외군요. 거기는 지하에 뭐가 있나봐요. 안으로 사람들이 꾸역꾸역... 아차",
"kind": "dialog",
"src": "scn:e0069_scn:64",
"speaker": "병사",
"cap": 254
},
{
"id": 2165,
"ko": "방금 이야기는 못 들은 걸로 해주세요.",
"kind": "dialog",
"src": "scn:e0069_scn:65",
"speaker": "병사",
"cap": 254
},
{
"id": 2166,
"ko": "저 곳이 가장 의심스럽군... 어떻게 들어간다.",
"kind": "dialog",
"src": "scn:e0069_scn:66",
"speaker": "티르",
"cap": 254
},
{
"id": 2167,
"ko": "얼굴이.. 낯이 익은데.",
"kind": "dialog",
"src": "scn:e0069_scn:67",
"speaker": "티르",
"cap": 254
},
{
"id": 2168,
"ko": "}이자벨{을 찾을 때 <여관에 있던 놈{이잖아? 그냥 단순한 똘마니는 아닌건가..",
"kind": "dialog",
"src": "scn:e0069_scn:68",
"speaker": "티르",
"cap": 254
},
{
"id": 2169,
"ko": "좋아, 저 놈을 잡아서 족쳐보자.",
"kind": "dialog",
"src": "scn:e0069_scn:69",
"speaker": "티르",
"cap": 254
},
{
"id": 2170,
"ko": "&주둔지 침입;$...........{퀘스트 입수!",
"kind": "dialog",
"src": "scn:e0069_scn:70",
"cap": 254
},
{
"id": 2171,
"ko": "멈춰라아아아아! 넌 ^포&위'됐<다{! 공화국의 }정의{와 `평화{를 위해..",
"kind": "dialog",
"src": "scn:e0069_scn:71",
"speaker": "그라함",
"cap": 254
},
{
"id": 2172,
"ko": "바.. 반역자의 말은 듣지 않겠다! 너의 반역 사실을 안뒤부터 얼마나 애타게 네놈의 뒤를...",
"kind": "dialog",
"src": "scn:e0069_scn:72",
"speaker": "그라함",
"cap": 254
},
{
"id": 2173,
"ko": "다물라고.",
"kind": "dialog",
"src": "scn:e0069_scn:73",
"speaker": "티르",
"cap": 254
},
{
"id": 2174,
"ko": "난 }케프네스{님의 대리로 움직이고 있다. 그래도 내 앞을 가로막을 건가?",
"kind": "dialog",
"src": "scn:e0069_scn:74",
"speaker": "티르",
"cap": 254
},
{
"id": 2175,
"ko": "너희들의 손으로 뽑은 정당한 지도자를 따르는 것이 네 놈이 말하는 정의냐?",
"kind": "dialog",
"src": "scn:e0069_scn:75",
"speaker": "티르",
"cap": 254
},
{
"id": 2176,
"ko": "저놈 왜 저렇게 당당하지..?",
"kind": "dialog",
"src": "scn:e0069_scn:76",
"speaker": "그라함",
"cap": 254
},
{
"id": 2177,
"ko": "그.. 그라함님, 브리안님의 말이 옳은 것 같은데요?",
"kind": "dialog",
"src": "scn:e0069_scn:77",
"speaker": "병사",
"cap": 254
},
{
"id": 2178,
"ko": "무슨 소리야! <티르{님을 못 믿는 거냐?",
"kind": "dialog",
"src": "scn:e0069_scn:78",
"speaker": "그라함",
"cap": 254
},
{
"id": 2179,
"ko": "공화국의 군인은 }지휘체계{에 }절대 복종{하며, 그것은 <인간{의 }평화{와 }안녕{을 위함이다!",
"kind": "dialog",
"src": "scn:e0069_scn:79",
"speaker": "그라함",
"cap": 254
},
{
"id": 2180,
"ko": "변장한 채 공화국 곳곳을 돌며 혼란을 조장했던 자가 자신의 정당성을 주장해 봤자 ^어&불'성<설{!",
"kind": "dialog",
"src": "scn:e0069_scn:80",
"speaker": "그라함",
"cap": 254
},
{
"id": 2181,
"ko": "그리고 그런 잘못된 길을 가는 자를 막는 것이 나의 ^성&스'러<운 }의`무{다!!",
"kind": "dialog",
"src": "scn:e0069_scn:81",
"speaker": "그라함",
"cap": 254
},
{
"id": 2182,
"ko": "오.. 오옷..",
"kind": "dialog",
"src": "scn:e0069_scn:82",
"speaker": "병사",
"cap": 254
},
{
"id": 2183,
"ko": "가.. 감동적이다..!",
"kind": "dialog",
"src": "scn:e0069_scn:83",
"speaker": "병사",
"cap": 254
},
{
"id": 2184,
"ko": "좋은 마음가짐이다. 다만 그러려면 수련을 더 해야겠군, 그라함.",
"kind": "dialog",
"src": "scn:e0069_scn:84",
"speaker": "티르",
"cap": 254
},
{
"id": 2185,
"ko": "그.. 그라함님! }바지{가..",
"kind": "dialog",
"src": "scn:e0069_scn:85",
"speaker": "병사",
"cap": 254
},
{
"id": 2186,
"ko": "그.. 그라함님! }물'방<울 `팬{...",
"kind": "dialog",
"src": "scn:e0069_scn:86",
"speaker": "병사",
"cap": 254
},
{
"id": 2187,
"ko": "시.. 시끄러! 일단 후퇴한다!",
"kind": "dialog",
"src": "scn:e0069_scn:87",
"speaker": "그라함",
"cap": 254
},
{
"id": 2190,
"ko": "허익후.. 완전 망했구만.",
"kind": "dialog",
"src": "scn:e0072_scn:1",
"speaker": "루칸",
"cap": 254
},
{
"id": 2191,
"ko": "게다가 상당히 제 정신이 아닌 듯 한데?",
"kind": "dialog",
"src": "scn:e0072_scn:2",
"speaker": "루칸",
"cap": 254
},
{
"id": 2192,
"ko": "쟤네 왜 저러고 사는지 혹시 아냐?",
"kind": "dialog",
"src": "scn:e0072_scn:3",
"speaker": "루칸",
"cap": 254
},
{
"id": 2193,
"ko": "난 저것들이 뭐하는 생물인지도 몰라.",
"kind": "dialog",
"src": "scn:e0072_scn:4",
"speaker": "티르",
"cap": 254
},
{
"id": 2194,
"ko": "엥?",
"kind": "dialog",
"src": "scn:e0072_scn:5",
"speaker": "루칸",
"cap": 254
},
{
"id": 2195,
"ko": "아하, 너 그 뭐시기냐. }인간{, 이라는 거로구나?",
"kind": "dialog",
"src": "scn:e0072_scn:6",
"speaker": "루칸",
"cap": 254
},
{
"id": 2196,
"ko": "... 뭐 문제있나?",
"kind": "dialog",
"src": "scn:e0072_scn:7",
"speaker": "티르",
"cap": 254
},
{
"id": 2197,
"ko": "아냐, 아냐. 내가 워낙 오랜만에 빛을 봐서...",
"kind": "dialog",
"src": "scn:e0072_scn:8",
"speaker": "루칸",
"cap": 254
},
{
"id": 2198,
"ko": "됐으니까 아는 데로 말해줘 봐. 저것들이 뭔지.",
"kind": "dialog",
"src": "scn:e0072_scn:9",
"speaker": "티르",
"cap": 254
},
{
"id": 2199,
"ko": "저것들은 }적{이야. 네베드.. 너희는 선주종이라고 불렀던가? 그것들의 }적{.",
"kind": "dialog",
"src": "scn:e0072_scn:10",
"speaker": "루칸",
"cap": 254
},
{
"id": 2200,
"ko": "옛날옛적에 선주종 녀석들이 와르르 }바다{에 쓸어넣었는데, 재주껏 잘 살아남은 거야.",
"kind": "dialog",
"src": "scn:e0072_scn:11",
"speaker": "루칸",
"cap": 254
},
{
"id": 2201,
"ko": "바다에.. 그런데 왜 여기에 있지?",
"kind": "dialog",
"src": "scn:e0072_scn:12",
"speaker": "티르",
"cap": 254
},
{
"id": 2202,
"ko": "니들이 건져낸거야. }정신지배{에 약하니까 날 통해서 조종해 보려고 한거지.",
"kind": "dialog",
"src": "scn:e0072_scn:13",
"speaker": "루칸",
"cap": 254
},
{
"id": 2203,
"ko": "그런 게 가능하다는 이야기는 처음 듣는데? 도대체 누가..",
"kind": "dialog",
"src": "scn:e0072_scn:14",
"speaker": "티르",
"cap": 254
},
{
"id": 2204,
"ko": "내가 알게 뭐야. 어쨌든 그러다가 니네 대장 덕에 풀려난거니, 그걸 봐서 티르님은 살려둔 건 줄 아세요. 오케이?",
"kind": "dialog",
"src": "scn:e0072_scn:15",
"speaker": "루칸",
"cap": 254
},
{
"id": 2205,
"ko": "언제까지 살려둘 지는 내 맘이지만..",
"kind": "dialog",
"src": "scn:e0072_scn:16",
"speaker": "루칸",
"cap": 254
},
{
"id": 2206,
"ko": "피곤하다, 그만 다물어라.",
"kind": "dialog",
"src": "scn:e0072_scn:17",
"speaker": "티르",
"cap": 254
},
{
"id": 2207,
"ko": "그럴까?",
"kind": "dialog",
"src": "scn:e0072_scn:18",
"speaker": "루칸",
"cap": 254
},
{
"id": 2208,
"ko": "괴물의 목에서 달 펜던트를 발견했다.",
"kind": "dialog",
"src": "scn:e0073_scn:1",
"cap": 254
},
{
"id": 2209,
"ko": "왠지 그럴 것 같은 기분이 들더라니... 역시나 괴물이 되어 있었군...",
"kind": "dialog",
"src": "scn:e0073_scn:2",
"speaker": "티르",
"cap": 254
},
{
"id": 2211,
"ko": "...돌아가겠어?",
"kind": "dialog",
"src": "scn:e0074_scn:1",
"speaker": "에리나",
"cap": 254
},
{
"id": 2212,
"ko": "돌아간다",
"kind": "dialog",
"src": "scn:e0074_scn:2",
"cap": 254
},
{
"id": 2213,
"ko": "아직이다",
"kind": "dialog",
"src": "scn:e0074_scn:3",
"cap": 254
},
{
"id": 2214,
"ko": "그럼 잘 부탁해.",
"kind": "dialog",
"src": "scn:e0074_scn:4",
"speaker": "에리나",
"cap": 254
},
{
"id": 2215,
"ko": "이봐... 어떤 놈인지는 이야기 해줘야지.",
"kind": "dialog",
"src": "scn:e0074_scn:5",
"speaker": "티르",
"cap": 254
},
{
"id": 2216,
"ko": "보면 알거야. 나랑 거의 똑같이 생겼어.",
"kind": "dialog",
"src": "scn:e0074_scn:6",
"speaker": "에리나",
"cap": 254
},
{
"id": 2217,
"ko": "|(누아다 같은 꼴을 당했을지도 모르는데...)",
"kind": "dialog",
"src": "scn:e0074_scn:7",
"speaker": "티르",
"cap": 254
},
{
"id": 2218,
"ko": "너희들은 다 비슷하게 생겨서 구분하기 어렵다고.",
"kind": "dialog",
"src": "scn:e0074_scn:8",
"speaker": "티르",
"cap": 254
},
{
"id": 2219,
"ko": "인간들이랑 별로 다르게 생기지도 않았잖아?",
"kind": "dialog",
"src": "scn:e0074_scn:9",
"speaker": "에리나",
"cap": 254
},
{
"id": 2220,
"ko": "아, 뭐 좋아. 하얀색 돌로 된 달모양의 펜던트를 차고 있어.",
"kind": "dialog",
"src": "scn:e0074_scn:10",
"speaker": "에리나",
"cap": 254
},
{
"id": 2221,
"ko": "달은 어떻게 생겼는지 알겠지?",
"kind": "dialog",
"src": "scn:e0074_scn:11",
"speaker": "에리나",
"cap": 254
},
{
"id": 2222,
"ko": "알았어.",
"kind": "dialog",
"src": "scn:e0074_scn:12",
"speaker": "티르",
"cap": 254
},
{
"id": 2223,
"ko": "에리나의 부탁;$...........{퀘스트 입수!",
"kind": "dialog",
"src": "scn:e0074_scn:13",
"cap": 254
},
{
"id": 2224,
"ko": "뭔가 찾았어?",
"kind": "dialog",
"src": "scn:e0074_scn:14",
"speaker": "에리나",
"cap": 254
},
{
"id": 2225,
"ko": "아직.",
"kind": "dialog",
"src": "scn:e0074_scn:15",
"speaker": "티르",
"cap": 254
},
{
"id": 2226,
"ko": "하나만 물어보지. 그런데 왜 나한테 부탁하지?",
"kind": "dialog",
"src": "scn:e0074_scn:16",
"speaker": "티르",
"cap": 254
},
{
"id": 2227,
"ko": "이런 위험한 장소에 동족을 보낼 수는 없잖아?",
"kind": "dialog",
"src": "scn:e0074_scn:17",
"speaker": "에리나",
"cap": 254
},
{
"id": 2228,
"ko": "너라면 죽는다고 해도 양심의 가책 같은 건 하나도 안 느낄테니까.",
"kind": "dialog",
"src": "scn:e0074_scn:18",
"speaker": "에리나",
"cap": 254
},
{
"id": 2229,
"ko": "알만하군 그거...",
"kind": "dialog",
"src": "scn:e0074_scn:19",
"speaker": "티르",
"cap": 254
},
{
"id": 2230,
"ko": "자꾸 말 걸지마. 뭔가 찾으면 말해 달라고.",
"kind": "dialog",
"src": "scn:e0074_scn:20",
"speaker": "에리나",
"cap": 254
},
{
"id": 2231,
"ko": "뭐야... 왜 이것만 가져온 거야?",
"kind": "dialog",
"src": "scn:e0074_scn:21",
"speaker": "에리나",
"cap": 254
},
{
"id": 2232,
"ko": "그거 밖에 없더군.",
"kind": "dialog",
"src": "scn:e0074_scn:22",
"speaker": "티르",
"cap": 254
},
{
"id": 2233,
"ko": "웃기지 마!",
"kind": "dialog",
"src": "scn:e0074_scn:23",
"speaker": "에리나",
"cap": 254
},
{
"id": 2234,
"ko": "뭐 하는 짓이야!",
"kind": "dialog",
"src": "scn:e0074_scn:24",
"speaker": "에리나",
"cap": 254
},
{
"id": 2235,
"ko": "그것 밖에 없었다고 하잖아.",
"kind": "dialog",
"src": "scn:e0074_scn:25",
"speaker": "티르",
"cap": 254
},
{
"id": 2236,
"ko": "어이.",
"kind": "dialog",
"src": "scn:e0074_scn:27",
"speaker": "티르",
"cap": 254
},
{
"id": 2237,
"ko": "...싸구려 동정은... 집어치워.",
"kind": "dialog",
"src": "scn:e0074_scn:28",
"speaker": "에리나",
"cap": 254
},
{
"id": 2238,
"ko": "미안하군.",
"kind": "dialog",
"src": "scn:e0074_scn:29",
"speaker": "티르",
"cap": 254
},
{
"id": 2239,
"ko": "&에리나의 부탁;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:e0074_scn:30",
"cap": 254
},
{
"id": 2240,
"ko": "뭐지?",
"kind": "dialog",
"src": "scn:e0074_scn:31",
"speaker": "티르",
"cap": 254
},
{
"id": 2241,
"ko": "뭐야, 공간이동 처음 해보나?",
"kind": "dialog",
"src": "scn:e0074_scn:32",
"speaker": "루칸",
"cap": 254
},
{
"id": 2242,
"ko": "공간이동?",
"kind": "dialog",
"src": "scn:e0074_scn:33",
"speaker": "티르",
"cap": 254
},
{
"id": 2243,
"ko": "아까 그 소환수에 마법을 걸어 놓은 거겠지. 배로 바로 이동하게.",
"kind": "dialog",
"src": "scn:e0074_scn:34",
"speaker": "루칸",
"cap": 254
},
{
"id": 2244,
"ko": "참 쓸데없는 곳까지 마법을 쓰는군...",
"kind": "dialog",
"src": "scn:e0074_scn:35",
"speaker": "티르",
"cap": 254
},
{
"id": 2245,
"ko": "... <타륜{이 없다.. 선주종의 배는 우리와 다른건가..?",
"kind": "dialog",
"src": "scn:e0074_scn:36",
"speaker": "티르",
"cap": 254
},
{
"id": 2246,
"ko": "내가 알던 네베드의 배라면, 원래 그 자리에 <타륜{이 있는게 맞아.",
"kind": "dialog",
"src": "scn:e0074_scn:37",
"speaker": "루칸",
"cap": 254
},
{
"id": 2247,
"ko": "밖에 저 녀석들이 무슨 장식인줄 알고 떼어간 모양인데? 너 엿먹으라고.",
"kind": "dialog",
"src": "scn:e0074_scn:38",
"speaker": "루칸",
"cap": 254
},
{
"id": 2248,
"ko": "대체 저 괴물들은 다 어디서 이만큼이나 기어나온 거지?",
"kind": "dialog",
"src": "scn:e0074_scn:39",
"speaker": "티르",
"cap": 254
},
{
"id": 2249,
"ko": "낸들 아나? 배를 움직일 방법이나 찾아보라고.",
"kind": "dialog",
"src": "scn:e0074_scn:40",
"speaker": "루칸",
"cap": 254
},
{
"id": 2250,
"ko": "확실히, 사람의 손으로 떼어간 것 같지는 않아.",
"kind": "dialog",
"src": "scn:e0074_scn:41",
"speaker": "티르",
"cap": 254
},
{
"id": 2251,
"ko": "음.. <마법{을 사용한 듯한 흔적인데, 그 괴물들 중에.. <마법을 쓰는 놈{도 있는건가?",
"kind": "dialog",
"src": "scn:e0074_scn:42",
"speaker": "티르",
"cap": 254
},
{
"id": 2252,
"ko": "&선주종의 배;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:e0074_scn:43",
"cap": 254
},
{
"id": 2253,
"ko": "&배의 부품;$...........{퀘스트 입수!",
"kind": "dialog",
"src": "scn:e0074_scn:44",
"cap": 254
},
{
"id": 2254,
"ko": "음... 이걸로 되는 건가?",
"kind": "dialog",
"src": "scn:e0074_scn:45",
"speaker": "티르",
"cap": 254
},
{
"id": 2255,
"ko": "움직인다.",
"kind": "dialog",
"src": "scn:e0074_scn:46",
"speaker": "티르",
"cap": 254
},
{
"id": 2256,
"ko": "&배의 부품;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:e0074_scn:47",
"speaker": "티르",
"cap": 254
},
{
"id": 2257,
"ko": "좋아.. 이대로 <팔리아스{로 간다.",
"kind": "dialog",
"src": "scn:e0074_scn:48",
"speaker": "티르",
"cap": 254
},
{
"id": 2258,
"ko": "조타기를 찾아야 배를 움직일 수 있겠어.",
"kind": "dialog",
"src": "scn:e0074_scn:49",
"speaker": "티르",
"cap": 254
},
{
"id": 2259,
"ko": "어디로 가는 것입니까요?",
"kind": "dialog",
"src": "scn:e0074_scn:50",
"speaker": "루칸",
"cap": 254
},
{
"id": 2260,
"ko": "일단 }검은 바위섬{으로 돌아가는 중이다. 선주종의 해역은 벗어나야 하니까.",
"kind": "dialog",
"src": "scn:e0074_scn:51",
"speaker": "티르",
"cap": 254
},
{
"id": 2261,
"ko": "그보다 지금 대장과 말할 수 있을까?",
"kind": "dialog",
"src": "scn:e0074_scn:52",
"speaker": "티르",
"cap": 254
},
{
"id": 2262,
"ko": "되기야 합니다만, 그냥 말해. 전해줄테니.",
"kind": "dialog",
"src": "scn:e0074_scn:53",
"speaker": "루칸",
"cap": 254
},
{
"id": 2263,
"ko": "아니.. 이전에 했던 것처럼 대장과 }직접{ 말을 하게 해줘.",
"kind": "dialog",
"src": "scn:e0074_scn:54",
"speaker": "티르",
"cap": 254
},
{
"id": 2264,
"ko": "아 귀찮게... 내가 무슨 대리인이냐. 죽을라고..",
"kind": "dialog",
"src": "scn:e0074_scn:55",
"speaker": "루칸",
"cap": 254
},
{
"id": 2265,
"ko": "기다려봐.",
"kind": "dialog",
"src": "scn:e0074_scn:56",
"speaker": "루칸",
"cap": 254
},
{
"id": 2266,
"ko": "그래. 무슨 말이 하고 싶은거지?",
"kind": "dialog",
"src": "scn:e0074_scn:58",
"speaker": "루칸",
"cap": 254
},
{
"id": 2267,
"ko": "대장, 솔직하게 대답해 줄 수 있어요? 이 }루칸{과 }래비{라는 자들의 정체가 뭡니까?",
"kind": "dialog",
"src": "scn:e0074_scn:59",
"speaker": "티르",
"cap": 254
},
{
"id": 2268,
"ko": "인간을 처음 본다는 듯이 말하는 데다가, 어딜봐도 정상으로 안 보입니다.",
"kind": "dialog",
"src": "scn:e0074_scn:60",
"speaker": "티르",
"cap": 254
},
{
"id": 2269,
"ko": "대장, 저한테 숨기는 게 있습니까?",
"kind": "dialog",
"src": "scn:e0074_scn:61",
"speaker": "티르",
"cap": 254
},
{
"id": 2270,
"ko": "아니, 언젠가 때가 되면 이야기 할 생각이었다... 슬슬 때가 된 것 같군.",
"kind": "dialog",
"src": "scn:e0074_scn:62",
"speaker": "루칸",
"cap": 254
},
{
"id": 2271,
"ko": "티르, <매도우 힐{로 와서 날 구해다오. 설명은 그때 직접 하겠다.",
"kind": "dialog",
"src": "scn:e0074_scn:63",
"speaker": "루칸",
"cap": 254
},
{
"id": 2272,
"ko": "알겠습니다. 매도우 힐의 어딥니까?",
"kind": "dialog",
"src": "scn:e0074_scn:64",
"speaker": "티르",
"cap": 254
},
{
"id": 2273,
"ko": "<주둔지 안{에 있는 <지하시설{에 유폐되어 있다. 브리안의 부하들이 지키고 있어.",
"kind": "dialog",
"src": "scn:e0074_scn:65",
"speaker": "루칸",
"cap": 254
},
{
"id": 2274,
"ko": "부탁한다.",
"kind": "dialog",
"src": "scn:e0074_scn:66",
"speaker": "루칸",
"cap": 254
},
{
"id": 2275,
"ko": "다시는 이런거 시키지 마십쇼? 영 기분 나쁘니까.",
"kind": "dialog",
"src": "scn:e0074_scn:67",
"speaker": "루칸",
"cap": 254
},
{
"id": 2276,
"ko": "그래서, 다음 목적지는 <매도우 힐{이냐?",
"kind": "dialog",
"src": "scn:e0074_scn:68",
"speaker": "루칸",
"cap": 254
},
{
"id": 2277,
"ko": "그래. 이 배를 몰고 갈 수는 없으니 검은 바위 섬에서 갈아타도록 하지.",
"kind": "dialog",
"src": "scn:e0074_scn:69",
"speaker": "티르",
"cap": 254
},
{
"id": 2279,
"ko": "뭐야?",
"kind": "dialog",
"src": "scn:e0075_scn:1",
"speaker": "루칸",
"cap": 254
},
{
"id": 2280,
"ko": "보급이 필요하다",
"kind": "dialog",
"src": "scn:e0075_scn:2",
"cap": 254
},
{
"id": 2281,
"ko": "보급이 필요해. 검은 바위 섬으로 돌아가야겠어.",
"kind": "dialog",
"src": "scn:e0075_scn:3",
"speaker": "티르",
"cap": 254
},
{
"id": 2282,
"ko": "진짜 귀찮게 하는구만...",
"kind": "dialog",
"src": "scn:e0075_scn:4",
"speaker": "루칸",
"cap": 254
},
{
"id": 2283,
"ko": "아무 것도 아니다",
"kind": "dialog",
"src": "scn:e0075_scn:5",
"cap": 254
},
{
"id": 2284,
"ko": "일 없으면 말 걸지 말라고, 앙?",
"kind": "dialog",
"src": "scn:e0075_scn:6",
"speaker": "루칸",
"cap": 254
},
{
"id": 2285,
"ko": "들키지 않았으면 좋겠는데...",
"kind": "dialog",
"src": "scn:e0075_scn:7",
"speaker": "티르",
"cap": 254
},
{
"id": 2286,
"ko": "배를 잃어버리면 돌아갈 길이 없으니 잘 지키고 있어.",
"kind": "dialog",
"src": "scn:e0075_scn:8",
"speaker": "티르",
"cap": 254
},
{
"id": 2287,
"ko": "오냐, 잘 받들어 모셔 주마.",
"kind": "dialog",
"src": "scn:e0075_scn:9",
"speaker": "루칸",
"cap": 254
},
{
"id": 2288,
"ko": "늦었잖아. }래비{는?",
"kind": "dialog",
"src": "scn:e0075_scn:10",
"speaker": "루칸",
"cap": 254
},
{
"id": 2289,
"ko": "오, 때마침 등장. 오랜만이유?",
"kind": "dialog",
"src": "scn:e0075_scn:11",
"speaker": "루칸",
"cap": 254
},
{
"id": 2290,
"ko": "생까냐? 하나도 안 변했구만.",
"kind": "dialog",
"src": "scn:e0075_scn:12",
"speaker": "루칸",
"cap": 254
},
{
"id": 2291,
"ko": "안타깝지만 <여자{는 놓쳤소. 일단 이곳을 떠나도록 합시다.",
"kind": "dialog",
"src": "scn:e0075_scn:13",
"speaker": "래비",
"cap": 254
},
{
"id": 2292,
"ko": "난 더 있어도 좋은데. 여기 죽이고 싶은 놈들이 잔뜩 있다고.",
"kind": "dialog",
"src": "scn:e0075_scn:14",
"speaker": "루칸",
"cap": 254
},
{
"id": 2293,
"ko": "쓸데없는 소리 하지 마라.",
"kind": "dialog",
"src": "scn:e0075_scn:15",
"speaker": "래비",
"cap": 254
},
{
"id": 2294,
"ko": "&탈출;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:e0075_scn:16",
"cap": 254
},
{
"id": 2297,
"ko": "}천년{..? 잘못 들은 거겠지?",
"kind": "dialog",
"src": "scn:e0077_scn:1",
"speaker": "티르",
"cap": 254
},
{
"id": 2298,
"ko": "하지만 저 자, 인간을 처음 보는 종족이라고 했고.. }오랜 싸움{은 또 뭐야..?",
"kind": "dialog",
"src": "scn:e0077_scn:2",
"speaker": "티르",
"cap": 254
},
{
"id": 2299,
"ko": "우선은 배를 지키러 가자. 배가 없어지면 빠져나갈 길이 없으니...",
"kind": "dialog",
"src": "scn:e0077_scn:3",
"speaker": "티르",
"cap": 254
},
{
"id": 2300,
"ko": "&팔리아스;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:e0077_scn:4",
"cap": 254
},
{
"id": 2301,
"ko": "&탈출;$...........{퀘스트 입수!",
"kind": "dialog",
"src": "scn:e0077_scn:5",
"cap": 254
},
{
"id": 2303,
"ko": "젠장.. 연구실의 화장실은 냄새가 심...",
"kind": "dialog",
"src": "scn:e0079_scn:1",
"speaker": "여관관리인",
"cap": 254
},
{
"id": 2304,
"ko": "저번에는 신세를 많이 졌다. 친절하게도 }이.자.벨.{과 만나게 해주었더군.",
"kind": "dialog",
"src": "scn:e0079_scn:2",
"speaker": "티르",
"cap": 254
},
{
"id": 2305,
"ko": "더러운 반역자 놈이...! 잘도 살아 돌아다니는구나!",
"kind": "dialog",
"src": "scn:e0079_scn:3",
"speaker": "여관관리인",
"cap": 254
},
{
"id": 2306,
"ko": "사태 파악이 안되나 보군. 반역자는 네 놈이고, 지금 너는 나를 케프네스님에게 안내해야할 <포로{가 된거야.",
"kind": "dialog",
"src": "scn:e0079_scn:4",
"speaker": "티르",
"cap": 254
},
{
"id": 2307,
"ko": "너는 그 }악마{의 두려움을 몰라! 그 악마는 마땅히 가둬져야 했다! 우리는 해야 할 일을 한 것 뿐이야!",
"kind": "dialog",
"src": "scn:e0079_scn:5",
"speaker": "여관관리인",
"cap": 254
},
{
"id": 2308,
"ko": "우리? 너도 }이자벨{과 같은 }웨이즈 가문{의 일원이군? 브리안의 협력자는 웨이즈 가문인가?",
"kind": "dialog",
"src": "scn:e0079_scn:6",
"speaker": "티르",
"cap": 254
},
{
"id": 2309,
"ko": "넘겨짚어 본건데 반응을 보니 틀림없군. 케프네스님을 지도자로 추대한 건 너희들이 아니었나? 지금은 대체 뭘 하려는 거지?",
"kind": "dialog",
"src": "scn:e0079_scn:7",
"speaker": "티르",
"cap": 254
},
{
"id": 2310,
"ko": "나는 아무것도 모른다! 내가 널 도와줄거라고 생각한다면..",
"kind": "dialog",
"src": "scn:e0079_scn:8",
"speaker": "여관관리인",
"cap": 254
},
{
"id": 2311,
"ko": "덜덜 떨면서 강한 척 하기는..",
"kind": "dialog",
"src": "scn:e0079_scn:9",
"speaker": "티르",
"cap": 254
},
{
"id": 2312,
"ko": "됐다, 그냥 입다물고 날 <주둔지의 지하시설{로 들여보내주기만 하면 돼.",
"kind": "dialog",
"src": "scn:e0079_scn:10",
"speaker": "티르",
"cap": 254
},
{
"id": 2313,
"ko": "크윽...",
"kind": "dialog",
"src": "scn:e0079_scn:11",
"speaker": "여관관리인",
"cap": 254
},
{
"id": 2314,
"ko": "따라와.",
"kind": "dialog",
"src": "scn:e0079_scn:12",
"speaker": "티르",
"cap": 254
},
{
"id": 2316,
"ko": "...잘은 모르겠지만 저걸 다 부숴보자.",
"kind": "dialog",
"src": "scn:e0082_scn:1",
"speaker": "티르",
"cap": 254
},
{
"id": 2317,
"ko": "^침입자 발생. ;1급 경계태세에 들어갑니다.",
"kind": "dialog",
"src": "scn:e0082_scn:2",
"cap": 254
},
{
"id": 2318,
"ko": "^모든 비전투원은;경보가 해제될 때까지;쉘터로 피신해 주십시오.",
"kind": "dialog",
"src": "scn:e0082_scn:3",
"cap": 254
},
{
"id": 2319,
"ko": "이 자식이!",
"kind": "dialog",
"src": "scn:e0082_scn:4",
"speaker": "티르",
"cap": 254
},
{
"id": 2320,
"ko": "하하핫! 이곳의 경계태세는 완벽해! 누구도 이 시스템에서 살아나갈 수 없다!",
"kind": "dialog",
"src": "scn:e0082_scn:5",
"speaker": "여관관리인",
"cap": 254
},
{
"id": 2321,
"ko": "아, 안돼! 난 아냐! 저 녀석, 저 녀석을 죽여! 누구를 쏘려는 거야!",
"kind": "dialog",
"src": "scn:e0082_scn:6",
"speaker": "여관관리인",
"cap": 254
},
{
"id": 2322,
"ko": "끄아아아아악~~~!!",
"kind": "dialog",
"src": "scn:e0082_scn:7",
"speaker": "여관관리인",
"cap": 254
},
{
"id": 2323,
"ko": "제대로 바보로군. 덕분에 일만 복잡해 졌잖아.",
"kind": "dialog",
"src": "scn:e0082_scn:8",
"speaker": "티르",
"cap": 254
},
{
"id": 2324,
"ko": "&주둔지 잠입;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:e0082_scn:9",
"cap": 254
},
{
"id": 2326,
"ko": "안녕하세요, 남부주둔군 PX입니다.",
"kind": "dialog",
"src": "scn:e0083_scn:1",
"speaker": "상인",
"cap": 254
},
{
"id": 2327,
"ko": "위에서 굉장한 소리가 났는데 무슨 일이 있었나요?",
"kind": "dialog",
"src": "scn:e0083_scn:2",
"speaker": "상인",
"cap": 254
},
{
"id": 2328,
"ko": "기분 탓이야. 신경쓰지마.",
"kind": "dialog",
"src": "scn:e0083_scn:3",
"speaker": "티르",
"cap": 254
},
{
"id": 2332,
"ko": "|(이러고 있을 시간이 없어. 여길 빠져 나가야 해.)",
"kind": "dialog",
"src": "scn:e0088_scn:4",
"speaker": "티르",
"cap": 254
},
{
"id": 2333,
"ko": "얘들은 왜 이렇게 늦어...",
"kind": "dialog",
"src": "scn:e0088_scn:5",
"speaker": "제임스",
"cap": 254
},
{
"id": 2334,
"ko": "혹시 생각이 바뀌셨습니까?",
"kind": "dialog",
"src": "scn:e0088_scn:6",
"speaker": "남자",
"cap": 254
},
{
"id": 2335,
"ko": "음...",
"kind": "dialog",
"src": "scn:e0088_scn:7",
"cap": 254
},
{
"id": 2336,
"ko": "한다",
"kind": "dialog",
"src": "scn:e0088_scn:8",
"cap": 254
},
{
"id": 2337,
"ko": "&해적소탕;$...........{퀘스트 입수!",
"kind": "dialog",
"src": "scn:e0088_scn:9",
"cap": 254
},
{
"id": 2338,
"ko": "그럼 제가 해적 소굴까지 태워다 드리죠. 해도에도 없는 곳이라 그냥은 못가니.",
"kind": "dialog",
"src": "scn:e0088_scn:10",
"speaker": "남자",
"cap": 254
},
{
"id": 2339,
"ko": "준비가 끝나면 말씀해 주세요.",
"kind": "dialog",
"src": "scn:e0088_scn:11",
"speaker": "남자",
"cap": 254
},
{
"id": 2340,
"ko": "하지 않는다",
"kind": "dialog",
"src": "scn:e0088_scn:12",
"cap": 254
},
{
"id": 2341,
"ko": "미안하군. 지금은 바빠서.",
"kind": "dialog",
"src": "scn:e0088_scn:13",
"speaker": "티르",
"cap": 254
},
{
"id": 2342,
"ko": "그럼 어쩔 수 없죠.",
"kind": "dialog",
"src": "scn:e0088_scn:14",
"speaker": "남자",
"cap": 254
},
{
"id": 2343,
"ko": "도와주셔서 정말 감사합니다.",
"kind": "dialog",
"src": "scn:e0088_scn:15",
"speaker": "남자",
"cap": 254
},
{
"id": 2344,
"ko": "혹시 그 해적 소굴에 다시 가실 겁니까?",
"kind": "dialog",
"src": "scn:e0088_scn:16",
"speaker": "남자",
"cap": 254
},
{
"id": 2345,
"ko": "가본다",
"kind": "dialog",
"src": "scn:e0088_scn:17",
"cap": 254
},
{
"id": 2346,
"ko": "안간다",
"kind": "dialog",
"src": "scn:e0088_scn:18",
"cap": 254
},
{
"id": 2347,
"ko": "출발해도 될까요?",
"kind": "dialog",
"src": "scn:e0088_scn:19",
"speaker": "남자",
"cap": 254
},
{
"id": 2348,
"ko": "출발한다",
"kind": "dialog",
"src": "scn:e0088_scn:20",
"cap": 254
},
{
"id": 2349,
"ko": "조금 있다가 가지.",
"kind": "dialog",
"src": "scn:e0088_scn:22",
"speaker": "티르",
"cap": 254
},
{
"id": 2350,
"ko": "요새 매도우 힐 쪽 항로에서 고블린들이 해적질을 하고 있어서 골치입니다.",
"kind": "dialog",
"src": "scn:e0088_scn:23",
"speaker": "남자",
"cap": 254
},
{
"id": 2351,
"ko": "고블린들이? 공화국 배는 안건드리기로 협정을 하지 않았었나?",
"kind": "dialog",
"src": "scn:e0088_scn:24",
"speaker": "티르",
"cap": 254
},
{
"id": 2352,
"ko": "어라? 그걸 어떻게 아십니까?",
"kind": "dialog",
"src": "scn:e0088_scn:25",
"speaker": "남자",
"cap": 254
},
{
"id": 2353,
"ko": "음, 뭐... 소문으로.",
"kind": "dialog",
"src": "scn:e0088_scn:26",
"speaker": "티르",
"cap": 254
},
{
"id": 2354,
"ko": "그런가요. 뭐, 그랬었는데... 갑자기 태도를 바꿨어요. 무슨 일이 있었는지 모르겠지만.",
"kind": "dialog",
"src": "scn:e0088_scn:27",
"speaker": "남자",
"cap": 254
},
{
"id": 2355,
"ko": "덕분에 아주 골치 아픕니다. 소탕을 요청해도 당장은 거기 파견할 인원이 없다고 하고.",
"kind": "dialog",
"src": "scn:e0088_scn:28",
"speaker": "남자",
"cap": 254
},
{
"id": 2356,
"ko": "본거지는 알고 있는데 손도 못 쓰고 있어요.",
"kind": "dialog",
"src": "scn:e0088_scn:29",
"speaker": "남자",
"cap": 254
},
{
"id": 2357,
"ko": "상인 길드에서 해적 소탕에 대해 현상금도 걸었는데, 혹시 생각 있으십니까?",
"kind": "dialog",
"src": "scn:e0088_scn:30",
"speaker": "남자",
"cap": 254
},
{
"id": 2358,
"ko": "배 한 척, 서둘러!",
"kind": "dialog",
"src": "scn:e0088_scn:31",
"speaker": "티르",
"cap": 254
},
{
"id": 2359,
"ko": "상점에서 파는 물건은 마을에 따라 다를 수도 있어요.",
"kind": "dialog",
"src": "scn:e0088_scn:32",
"speaker": "상인",
"cap": 254
},
{
"id": 2360,
"ko": "오브 결합 시에 제물을 넣으면 성공률이 올라가지요.",
"kind": "dialog",
"src": "scn:e0088_scn:33",
"speaker": "대장장이",
"cap": 254
},
{
"id": 2361,
"ko": "볼 일이 있어서 오신 거라면, 빨리 처리하시는게 좋을 겁니다.",
"kind": "dialog",
"src": "scn:e0088_scn:34",
"speaker": "병사",
"cap": 254
},
{
"id": 2362,
"ko": "&반응이 없다.; 그냥 시체같다.",
"kind": "dialog",
"src": "scn:e0088_scn:35",
"cap": 254
},
{
"id": 2363,
"ko": "여긴 뭐하러 오셨습니까? 곧 철수 명령이 떨어질텐데.",
"kind": "dialog",
"src": "scn:e0088_scn:36",
"speaker": "병사",
"cap": 254
},
{
"id": 2364,
"ko": "철수?",
"kind": "dialog",
"src": "scn:e0088_scn:37",
"speaker": "티르",
"cap": 254
},
{
"id": 2365,
"ko": "곧 군인들만 남기고 민간인은 모두 퇴거시킬 겁니다. 티르님의 명령이라서요.",
"kind": "dialog",
"src": "scn:e0088_scn:38",
"speaker": "병사",
"cap": 254
},
{
"id": 2366,
"ko": "전투가 있을지도 모른다고 하더군요.",
"kind": "dialog",
"src": "scn:e0088_scn:39",
"speaker": "병사",
"cap": 254
},
{
"id": 2367,
"ko": "티르가 이 곳에 있나?",
"kind": "dialog",
"src": "scn:e0088_scn:40",
"speaker": "티르",
"cap": 254
},
{
"id": 2368,
"ko": "잠깐 들렀다가 북쪽으로 가셨습니다.",
"kind": "dialog",
"src": "scn:e0088_scn:41",
"speaker": "병사",
"cap": 254
},
{
"id": 2369,
"ko": "|(이 태도를 보건데... 매도우 힐의 일은 아직 알려지지 않은 것 같군.)",
"kind": "dialog",
"src": "scn:e0088_scn:42",
"speaker": "티르",
"cap": 254
},
{
"id": 2370,
"ko": "아무튼 여기 볼 일이 있어서 오신 거라면, 빨리 처리하시는게 좋을 겁니다.",
"kind": "dialog",
"src": "scn:e0088_scn:43",
"speaker": "병사",
"cap": 254
},
{
"id": 2371,
"ko": "요즘 북쪽 들판에는 괴물들이 나타나서 무섭습니다.",
"kind": "dialog",
"src": "scn:e0088_scn:44",
"speaker": "병사",
"cap": 254
},
{
"id": 2372,
"ko": "선주종을 숨겨주다니... 미친 것 아닐까요?",
"kind": "dialog",
"src": "scn:e0088_scn:45",
"speaker": "병사",
"cap": 254
},
{
"id": 2373,
"ko": "혹시 알렉스라는 이름의 금발머리, 20대 남성을 발견하시거나, 선주종 여자를 발견하시면 즉각 신고해 주시기 바랍니다.",
"kind": "dialog",
"src": "scn:e0088_scn:46",
"speaker": "병사",
"cap": 254
},
{
"id": 2374,
"ko": "무슨 일이지?",
"kind": "dialog",
"src": "scn:e0088_scn:47",
"speaker": "티르",
"cap": 254
},
{
"id": 2375,
"ko": "반역자입니다. 선주종 여성을 숨겨주고 있다가 발각되었는데 잡기 전에 도망쳐 버려서...",
"kind": "dialog",
"src": "scn:e0088_scn:48",
"speaker": "병사",
"cap": 254
},
{
"id": 2376,
"ko": "포상금도 걸려 있으니 꼭 신고 바랍니다.  마을 어딘가에 있을 겁니다.",
"kind": "dialog",
"src": "scn:e0088_scn:49",
"speaker": "병사",
"cap": 254
},
{
"id": 2377,
"ko": "&배반자;$...........{퀘스트 입수!",
"kind": "dialog",
"src": "scn:e0088_scn:50",
"cap": 254
},
{
"id": 2378,
"ko": "찾아내셨습니까?",
"kind": "dialog",
"src": "scn:e0088_scn:51",
"speaker": "병사",
"cap": 254
},
{
"id": 2379,
"ko": "어떻게 할까...",
"kind": "dialog",
"src": "scn:e0088_scn:52",
"cap": 254
},
{
"id": 2380,
"ko": "알려준다",
"kind": "dialog",
"src": "scn:e0088_scn:53",
"cap": 254
},
{
"id": 2381,
"ko": "저기 있는 커다란 건물 3층에 숨어 있더군.",
"kind": "dialog",
"src": "scn:e0088_scn:54",
"speaker": "티르",
"cap": 254
},
{
"id": 2382,
"ko": "거긴 막혀서 들어가지 못하는...",
"kind": "dialog",
"src": "scn:e0088_scn:55",
"speaker": "병사",
"cap": 254
},
{
"id": 2383,
"ko": "스트렝스 이어링이 있으면 들어갈 수 있어.",
"kind": "dialog",
"src": "scn:e0088_scn:56",
"speaker": "티르",
"cap": 254
},
{
"id": 2384,
"ko": "즉각 상부에 보고하겠습니다! 공화국의 군인으로서 시민의 의무를 다해주신 것에 대해 정말 감사드립니다!",
"kind": "dialog",
"src": "scn:e0088_scn:57",
"speaker": "병사",
"cap": 254
},
{
"id": 2385,
"ko": "&배반자;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:e0088_scn:58",
"cap": 254
},
{
"id": 2386,
"ko": "알려주지 않는다",
"kind": "dialog",
"src": "scn:e0088_scn:59",
"cap": 254
},
{
"id": 2387,
"ko": "아직 찾지 못했어.",
"kind": "dialog",
"src": "scn:e0088_scn:60",
"speaker": "티르",
"cap": 254
},
{
"id": 2388,
"ko": "사람이 별로 없군..",
"kind": "dialog",
"src": "scn:e0088_scn:61",
"speaker": "티르",
"cap": 254
},
{
"id": 2389,
"ko": "여기는.. 뮤리아스?",
"kind": "dialog",
"src": "scn:e0088_scn:62",
"speaker": "티르",
"cap": 254
},
{
"id": 2390,
"ko": "포로수용소라고 했지. 여기로 전이시켜 준 건가...",
"kind": "dialog",
"src": "scn:e0088_scn:63",
"speaker": "티르",
"cap": 254
},
{
"id": 2391,
"ko": "지체할 시간이 없어, 바로 <아눈 섬{으로 간다!",
"kind": "dialog",
"src": "scn:e0088_scn:65",
"speaker": "크레드",
"cap": 254
},
{
"id": 2396,
"ko": "일단은 계산대로 움직여 주는군...",
"kind": "dialog",
"src": "scn:e0092_scn:1",
"speaker": "티르",
"cap": 254
},
{
"id": 2398,
"ko": "'패스코드;B.T.C.;A.B.L.",
"kind": "dialog",
"src": "scn:e0093_scn:1",
"cap": 254
},
{
"id": 2399,
"ko": "'잘못된 코드입니다.;전원을 차단합니다.",
"kind": "dialog",
"src": "scn:e0093_scn:2",
"cap": 254
},
{
"id": 2400,
"ko": "'패스코드를;입력하시겠습니까?",
"kind": "dialog",
"src": "scn:e0093_scn:3",
"cap": 254
},
{
"id": 2401,
"ko": "'코드 입력이 완료되었습니다.",
"kind": "dialog",
"src": "scn:e0093_scn:16",
"cap": 254
},
{
"id": 2402,
"ko": "'전원이 차단되어 있습니다.",
"kind": "dialog",
"src": "scn:e0093_scn:17",
"cap": 254
},
{
"id": 2403,
"ko": "'전원을 복구하기 위해서는;지침에 따라;2층의 차단기를;모두 연결하십시오.",
"kind": "dialog",
"src": "scn:e0093_scn:18",
"cap": 254
},
{
"id": 2405,
"ko": "'전원 공급이 재개됩니다.",
"kind": "dialog",
"src": "scn:e0094_scn:1",
"cap": 254
},
{
"id": 2406,
"ko": "'코드 입력이;완료되었습니다.",
"kind": "dialog",
"src": "scn:e0094_scn:16",
"cap": 254
},
{
"id": 2408,
"ko": "어이, 정신차려. 이봐!",
"kind": "dialog",
"src": "scn:e0095_scn:4",
"speaker": "티르",
"cap": 254
},
{
"id": 2409,
"ko": "젠장.. 일단은 크래드한테 가자.",
"kind": "dialog",
"src": "scn:e0095_scn:5",
"speaker": "티르",
"cap": 254
},
{
"id": 2410,
"ko": "&도주;$...........{퀘스트 입수!",
"kind": "dialog",
"src": "scn:e0095_scn:7",
"cap": 254
},
{
"id": 2412,
"ko": "이건 못 지나가겠군...",
"kind": "dialog",
"src": "scn:e0097_scn:1",
"speaker": "티르",
"cap": 254
},
{
"id": 2413,
"ko": "이놈이었나.. 왜 이 녀석들은 기계를 뜯어가지...?",
"kind": "dialog",
"src": "scn:e0098_scn:1",
"speaker": "티르",
"cap": 254
},
{
"id": 2415,
"ko": "집은 이미 점령당했을 거야, 돌아가면 위험해.",
"kind": "dialog",
"src": "scn:e0099_scn:1",
"speaker": "티르",
"cap": 254
},
{
"id": 2416,
"ko": "이미 고대종들이 들어와 있어.. 다른 출구를 찾자.",
"kind": "dialog",
"src": "scn:e0099_scn:2",
"speaker": "티르",
"cap": 254
},
{
"id": 2417,
"ko": "앞에 있는 몬스터들을 좀 치워줘.",
"kind": "dialog",
"src": "scn:e0099_scn:3",
"speaker": "크레드",
"cap": 254
},
{
"id": 2418,
"ko": "이 상황에서도 장사를 합니까?",
"kind": "dialog",
"src": "scn:e0099_scn:5",
"speaker": "티르",
"cap": 254
},
{
"id": 2419,
"ko": "세상에 공짜가 어딨나. 등가교환이야 등가교환. 자네도 언젠가는 알게 될거야.",
"kind": "dialog",
"src": "scn:e0099_scn:6",
"speaker": "크레드",
"cap": 254
},
{
"id": 2420,
"ko": "그럴싸한 말로 얼버무리려고 해봤자 소용없습니다.",
"kind": "dialog",
"src": "scn:e0099_scn:7",
"speaker": "티르",
"cap": 254
},
{
"id": 2421,
"ko": "어쨌든.",
"kind": "dialog",
"src": "scn:e0099_scn:8",
"speaker": "크레드",
"cap": 254
},
{
"id": 2422,
"ko": "뭔가 필요한가?",
"kind": "dialog",
"src": "scn:e0099_scn:11",
"speaker": "크레드",
"cap": 254
},
{
"id": 2423,
"ko": "잠깐 기다리세요.",
"kind": "dialog",
"src": "scn:e0099_scn:12",
"speaker": "루레인",
"cap": 254
},
{
"id": 2424,
"ko": "아무도 없어요, 들어오... 잠깐!",
"kind": "dialog",
"src": "scn:e0099_scn:13",
"speaker": "루레인",
"cap": 254
},
{
"id": 2425,
"ko": "적이 있어요! 조심...",
"kind": "dialog",
"src": "scn:e0099_scn:14",
"speaker": "루레인",
"cap": 254
},
{
"id": 2426,
"ko": "무너졌어.. 젠장.",
"kind": "dialog",
"src": "scn:e0099_scn:15",
"speaker": "크레드",
"cap": 254
},
{
"id": 2427,
"ko": "다른 출구가 있다고 했죠? 그쪽으로 가야 겠습니다.",
"kind": "dialog",
"src": "scn:e0099_scn:16",
"speaker": "티르",
"cap": 254
},
{
"id": 2428,
"ko": "이미 }고대종{들이 침입해 있을텐데.. 할 수 없지.",
"kind": "dialog",
"src": "scn:e0099_scn:17",
"speaker": "크레드",
"cap": 254
},
{
"id": 2429,
"ko": "루레인이 걱정 되나? 이거 의외인데. 엘렌이 실망하겠어.",
"kind": "dialog",
"src": "scn:e0099_scn:18",
"speaker": "크레드",
"cap": 254
},
{
"id": 2430,
"ko": "다물고 엘렌이나 잘 챙겨요. 싸우고 있으면 제가 일일이 보호해 줄 수 없으니.",
"kind": "dialog",
"src": "scn:e0099_scn:19",
"speaker": "티르",
"cap": 254
},
{
"id": 2431,
"ko": "왜 안 깨어나는거죠?",
"kind": "dialog",
"src": "scn:e0099_scn:20",
"speaker": "티르",
"cap": 254
},
{
"id": 2432,
"ko": "나도 모르겠..",
"kind": "dialog",
"src": "scn:e0099_scn:21",
"speaker": "크레드",
"cap": 254
},
{
"id": 2433,
"ko": "아차...",
"kind": "dialog",
"src": "scn:e0099_scn:22",
"speaker": "크레드",
"cap": 254
},
{
"id": 2434,
"ko": "왜 그러죠?",
"kind": "dialog",
"src": "scn:e0099_scn:23",
"speaker": "티르",
"cap": 254
},
{
"id": 2435,
"ko": "}약{을 안 챙겨왔어. 집은 이미 점령당했을 텐데..",
"kind": "dialog",
"src": "scn:e0099_scn:24",
"speaker": "크레드",
"cap": 254
},
{
"id": 2436,
"ko": "일단은 빠져나가는 것만 생각해요. 약은 나중에 찾던가, 재료를 다시 구하면 되니까.",
"kind": "dialog",
"src": "scn:e0099_scn:25",
"speaker": "티르",
"cap": 254
},
{
"id": 2437,
"ko": "할 수 없군..",
"kind": "dialog",
"src": "scn:e0099_scn:26",
"speaker": "크레드",
"cap": 254
},
{
"id": 2438,
"ko": "나가는 길은 저쪽이야.",
"kind": "dialog",
"src": "scn:e0099_scn:27",
"speaker": "크레드",
"cap": 254
},
{
"id": 2439,
"ko": "다른 길도 있지만.. 선착장과 이어져 있어서 위험할 거야.",
"kind": "dialog",
"src": "scn:e0099_scn:28",
"speaker": "크레드",
"cap": 254
},
{
"id": 2440,
"ko": "&비밀통로;$...........{퀘스트 입수!",
"kind": "dialog",
"src": "scn:e0099_scn:29",
"cap": 254
},
{
"id": 2442,
"ko": "크래드의 시체가.. 없다.. 놈들이 없앤 건가?",
"kind": "dialog",
"src": "scn:e0100_scn:1",
"speaker": "티르",
"cap": 254
},
{
"id": 2443,
"ko": "서두르는게 좋겠어.",
"kind": "dialog",
"src": "scn:e0100_scn:5",
"speaker": "크레드",
"cap": 254
},
{
"id": 2444,
"ko": "보급이 필요합니다.",
"kind": "dialog",
"src": "scn:e0100_scn:6",
"cap": 254
},
{
"id": 2445,
"ko": "알겠습니다.",
"kind": "dialog",
"src": "scn:e0100_scn:7",
"cap": 254
},
{
"id": 2446,
"ko": "그러죠.",
"kind": "dialog",
"src": "scn:e0100_scn:8",
"speaker": "티르",
"cap": 254
},
{
"id": 2447,
"ko": "으아아악!",
"kind": "dialog",
"src": "scn:e0100_scn:9",
"speaker": "???",
"cap": 254
},
{
"id": 2448,
"ko": "도망쳐! 도망쳐라!",
"kind": "dialog",
"src": "scn:e0100_scn:10",
"speaker": "그라함",
"cap": 254
},
{
"id": 2449,
"ko": "저 목소리는...",
"kind": "dialog",
"src": "scn:e0100_scn:11",
"speaker": "티르",
"cap": 254
},
{
"id": 2451,
"ko": "루레인의 부탁이니 태워는 주지만, 허락된 곳 외에는 태워다 줄 수 없어, 인간.",
"kind": "dialog",
"src": "scn:e0101_scn:1",
"speaker": "선장",
"cap": 254
},
{
"id": 2452,
"ko": "... 알고 있다.",
"kind": "dialog",
"src": "scn:e0101_scn:2",
"speaker": "티르",
"cap": 254
},
{
"id": 2453,
"ko": "|(노골적으로 싫다는 티를 내는군, 아주...)",
"kind": "dialog",
"src": "scn:e0101_scn:4",
"speaker": "티르",
"cap": 254
},
{
"id": 2454,
"ko": "사람을 무슨 벌레보듯 하지 말라고.",
"kind": "dialog",
"src": "scn:e0101_scn:5",
"speaker": "티르",
"cap": 254
},
{
"id": 2455,
"ko": "벌레는 보는 대로 죽여버리면 되지만 넌 루레인 님의 손님이니까 그러지도 못하고...",
"kind": "dialog",
"src": "scn:e0101_scn:6",
"speaker": "에리나",
"cap": 254
},
{
"id": 2456,
"ko": "벌레보다 질이 나빠.",
"kind": "dialog",
"src": "scn:e0101_scn:7",
"speaker": "에리나",
"cap": 254
},
{
"id": 2457,
"ko": "그거 참 미안하군 그래.",
"kind": "dialog",
"src": "scn:e0101_scn:8",
"speaker": "티르",
"cap": 254
},
{
"id": 2458,
"ko": "그래서 용건이 뭐지? 빨리 말해줬으면 좋겠는데.",
"kind": "dialog",
"src": "scn:e0101_scn:9",
"speaker": "에리나",
"cap": 254
},
{
"id": 2459,
"ko": "검은 바위 섬으로는 안가나? 배가?",
"kind": "dialog",
"src": "scn:e0101_scn:10",
"speaker": "티르",
"cap": 254
},
{
"id": 2460,
"ko": "저 선장이 운행하는 배는 위험한 곳으로는 가지 않아. 검은 바위 섬은 진지가 없어졌으니까.",
"kind": "dialog",
"src": "scn:e0101_scn:11",
"speaker": "에리나",
"cap": 254
},
{
"id": 2461,
"ko": "그렇군...",
"kind": "dialog",
"src": "scn:e0101_scn:12",
"speaker": "티르",
"cap": 254
},
{
"id": 2462,
"ko": "꼭 원한다면 내가 데려가 줄 수도 있기는 한데...",
"kind": "dialog",
"src": "scn:e0101_scn:13",
"speaker": "에리나",
"cap": 254
},
{
"id": 2463,
"ko": "호오... 그건 무슨 바람이 불어서?",
"kind": "dialog",
"src": "scn:e0101_scn:14",
"speaker": "티르",
"cap": 254
},
{
"id": 2464,
"ko": "물론 공짜는 아니고. 동생이 검은 바위 섬 주둔지에 있었는데, 주둔지가 날아가며 소식이 끊겼어.",
"kind": "dialog",
"src": "scn:e0101_scn:15",
"speaker": "에리나",
"cap": 254
},
{
"id": 2465,
"ko": "동생의 소식을 알아봐 준다면 보내주겠어.",
"kind": "dialog",
"src": "scn:e0101_scn:16",
"speaker": "에리나",
"cap": 254
},
{
"id": 2466,
"ko": "생각해보지.",
"kind": "dialog",
"src": "scn:e0101_scn:18",
"cap": 254
},
{
"id": 2467,
"ko": "한번 생각해 보지.",
"kind": "dialog",
"src": "scn:e0101_scn:19",
"speaker": "티르",
"cap": 254
},
{
"id": 2468,
"ko": "생각은 끝났나?",
"kind": "dialog",
"src": "scn:e0101_scn:20",
"cap": 254
},
{
"id": 2469,
"ko": "승낙한다.",
"kind": "dialog",
"src": "scn:e0101_scn:21",
"cap": 254
},
{
"id": 2470,
"ko": "좀 더 생각해 본다.",
"kind": "dialog",
"src": "scn:e0101_scn:22",
"cap": 254
},
{
"id": 2471,
"ko": "...적당히 해두라고.",
"kind": "dialog",
"src": "scn:e0101_scn:23",
"speaker": "에리나",
"cap": 254
},
{
"id": 2472,
"ko": "다시 가려고?",
"kind": "dialog",
"src": "scn:e0101_scn:24",
"speaker": "에리나",
"cap": 254
},
{
"id": 2473,
"ko": "간다.",
"kind": "dialog",
"src": "scn:e0101_scn:25",
"cap": 254
},
{
"id": 2474,
"ko": "안간다.",
"kind": "dialog",
"src": "scn:e0101_scn:26",
"cap": 254
},
{
"id": 2475,
"ko": "말 걸지 마.",
"kind": "dialog",
"src": "scn:e0101_scn:28",
"speaker": "에리나",
"cap": 254
},
{
"id": 2476,
"ko": "이 애를... 어디 쉴만한 곳에 좀 데려다 줘.",
"kind": "dialog",
"src": "scn:e0101_scn:29",
"speaker": "루레인",
"cap": 254
},
{
"id": 2477,
"ko": "어머.. 엘렌이잖아? 여관이면 될까?",
"kind": "dialog",
"src": "scn:e0101_scn:30",
"speaker": "디어드리",
"cap": 254
},
{
"id": 2478,
"ko": "응, 부탁해.",
"kind": "dialog",
"src": "scn:e0101_scn:31",
"speaker": "루레인",
"cap": 254
},
{
"id": 2479,
"ko": "누아다는...?",
"kind": "dialog",
"src": "scn:e0101_scn:32",
"speaker": "디어드리",
"cap": 254
},
{
"id": 2480,
"ko": "미안.. 알았어.",
"kind": "dialog",
"src": "scn:e0101_scn:33",
"speaker": "디어드리",
"cap": 254
},
{
"id": 2481,
"ko": "아니, 괜찮아. 엘렌을 부탁해.",
"kind": "dialog",
"src": "scn:e0101_scn:34",
"speaker": "루레인",
"cap": 254
},
{
"id": 2482,
"ko": "전 일단 장로님을 보고 올게요. 엘렌은 여관에 있을 거예요.",
"kind": "dialog",
"src": "scn:e0101_scn:35",
"speaker": "루레인",
"cap": 254
},
{
"id": 2483,
"ko": "제가 드린 증표가 있으면 공격 당하는 일은 없겠지만...",
"kind": "dialog",
"src": "scn:e0101_scn:36",
"speaker": "루레인",
"cap": 254
},
{
"id": 2484,
"ko": "인간들이 우리한테 한 일을 생각하면 조심하는 게 좋을 거예요.",
"kind": "dialog",
"src": "scn:e0101_scn:37",
"speaker": "루레인",
"cap": 254
},
{
"id": 2485,
"ko": "명심하지...",
"kind": "dialog",
"src": "scn:e0101_scn:38",
"speaker": "티르",
"cap": 254
},
{
"id": 2486,
"ko": "그리고.. 무슨 일이 있거나 마을을 떠나기 전에 잠깐 절 만나고 가세요.",
"kind": "dialog",
"src": "scn:e0101_scn:39",
"speaker": "루레인",
"cap": 254
},
{
"id": 2487,
"ko": "그건 보장 못하겠군.",
"kind": "dialog",
"src": "scn:e0101_scn:40",
"speaker": "티르",
"cap": 254
},
{
"id": 2488,
"ko": "&엘렌;$...........{퀘스트 입수!",
"kind": "dialog",
"src": "scn:e0101_scn:41",
"cap": 254
},
{
"id": 2489,
"ko": "출발해요.",
"kind": "dialog",
"src": "scn:e0101_scn:42",
"speaker": "디어드리",
"cap": 254
}
]