[
{
"id": 439,
"ko": "... 그럼 출발해 볼까..?",
"kind": "dialog",
"src": "scn:e0007_scn:1",
"speaker": "크레드",
"cap": 254
},
{
"id": 440,
"ko": "산딸기가 있을 것 같은 동네는 아닌데..",
"kind": "dialog",
"src": "scn:e0007_scn:2",
"speaker": "티르",
"cap": 254
},
{
"id": 441,
"ko": "저.. 저리가!",
"kind": "dialog",
"src": "scn:e0007_scn:3",
"speaker": "엘렌",
"cap": 254
},
{
"id": 442,
"ko": "징그러어, 왜 오늘따라 난폭한거야?",
"kind": "dialog",
"src": "scn:e0007_scn:4",
"speaker": "엘렌",
"cap": 254
},
{
"id": 443,
"ko": "왠지 이럴 것 같더라니..!",
"kind": "dialog",
"src": "scn:e0007_scn:5",
"speaker": "티르",
"cap": 254
},
{
"id": 444,
"ko": "사.. 살았다아...",
"kind": "dialog",
"src": "scn:e0007_scn:6",
"speaker": "엘렌",
"cap": 254
},
{
"id": 445,
"ko": "고마워요!!",
"kind": "dialog",
"src": "scn:e0007_scn:7",
"speaker": "엘렌",
"cap": 254
},
{
"id": 446,
"ko": "고, 고맙긴. 나야말로 고맙다고 해야하는데.",
"kind": "dialog",
"src": "scn:e0007_scn:8",
"speaker": "티르",
"cap": 254
},
{
"id": 447,
"ko": "내가 누워있는 동안 간호해 줬다며?",
"kind": "dialog",
"src": "scn:e0007_scn:9",
"speaker": "티르",
"cap": 254
},
{
"id": 448,
"ko": "아, 헤헤.. 오빠가 이야기 했어요?",
"kind": "dialog",
"src": "scn:e0007_scn:10",
"speaker": "엘렌",
"cap": 254
},
{
"id": 449,
"ko": "나, 오빠 이외의 사람을 보는건 처음이에요.",
"kind": "dialog",
"src": "scn:e0007_scn:11",
"speaker": "엘렌",
"cap": 254
},
{
"id": 450,
"ko": "뭐?",
"kind": "dialog",
"src": "scn:e0007_scn:12",
"speaker": "티르",
"cap": 254
},
{
"id": 451,
"ko": "계~속 여기서 오빠랑 둘만 살았거든요. 아, 인간은 처음이라는 거예요.",
"kind": "dialog",
"src": "scn:e0007_scn:13",
"speaker": "엘렌",
"cap": 254
},
{
"id": 452,
"ko": "}누아다 오빠{나 }노덴스 할아버지{는 어쩌다 왔는데.. 둘 다 엄청 무서워요.",
"kind": "dialog",
"src": "scn:e0007_scn:14",
"speaker": "엘렌",
"cap": 254
},
{
"id": 453,
"ko": "인간은 본 적이 없다니.. 부모님은?",
"kind": "dialog",
"src": "scn:e0007_scn:15",
"speaker": "티르",
"cap": 254
},
{
"id": 454,
"ko": "안 계셔요. 두 분 다 어릴 적에 돌아가셨대요.",
"kind": "dialog",
"src": "scn:e0007_scn:16",
"speaker": "엘렌",
"cap": 254
},
{
"id": 455,
"ko": "그런가. 미안하다.",
"kind": "dialog",
"src": "scn:e0007_scn:17",
"speaker": "티르",
"cap": 254
},
{
"id": 456,
"ko": "괜찮아요. 전 기억도 안 나고..",
"kind": "dialog",
"src": "scn:e0007_scn:18",
"speaker": "엘렌",
"cap": 254
},
{
"id": 457,
"ko": "어떤 분들이었는지 궁금하긴 한데 오빠한테 물어봐도 <좋은 친구{였다고 밖에 안 해줘요.",
"kind": "dialog",
"src": "scn:e0007_scn:19",
"speaker": "엘렌",
"cap": 254
},
{
"id": 458,
"ko": "친구? 크래드 씨는 친 오빠가 아냐?",
"kind": "dialog",
"src": "scn:e0007_scn:20",
"speaker": "티르",
"cap": 254
},
{
"id": 459,
"ko": "와, 저 오빠랑 닮았어요?",
"kind": "dialog",
"src": "scn:e0007_scn:21",
"speaker": "엘렌",
"cap": 254
},
{
"id": 460,
"ko": ".. 실례를 범했군.",
"kind": "dialog",
"src": "scn:e0007_scn:22",
"speaker": "티르",
"cap": 254
},
{
"id": 461,
"ko": "그러고보니 아직 오빠 이름은 못 들었는데요? 제 이름은 알죠? }엘렌{.",
"kind": "dialog",
"src": "scn:e0007_scn:23",
"speaker": "엘렌",
"cap": 254
},
{
"id": 462,
"ko": "난.. }티르{. 티르라고 해.",
"kind": "dialog",
"src": "scn:e0007_scn:24",
"speaker": "티르",
"cap": 254
},
{
"id": 463,
"ko": "그럼 티르 오빠.",
"kind": "dialog",
"src": "scn:e0007_scn:25",
"speaker": "엘렌",
"cap": 254
},
{
"id": 464,
"ko": "음. 그럼 난 엘렌이라고 부르면 되나?",
"kind": "dialog",
"src": "scn:e0007_scn:26",
"speaker": "티르",
"cap": 254
},
{
"id": 465,
"ko": "네!",
"kind": "dialog",
"src": "scn:e0007_scn:27",
"speaker": "엘렌",
"cap": 254
},
{
"id": 466,
"ko": "일단 돌아가자. 몬스터도 나오고 위험하니.",
"kind": "dialog",
"src": "scn:e0007_scn:28",
"speaker": "티르",
"cap": 254
},
{
"id": 467,
"ko": "여기예요, 여기~",
"kind": "dialog",
"src": "scn:e0007_scn:29",
"speaker": "???",
"cap": 254
},
{
"id": 468,
"ko": "당신은 누구지? 루레인은?",
"kind": "dialog",
"src": "scn:e0007_scn:30",
"speaker": "티르",
"cap": 254
},
{
"id": 469,
"ko": "저는 }디어드리{라고 하고요, 루레인은 기다릴 수 없다고 먼저 갔어요.",
"kind": "dialog",
"src": "scn:e0007_scn:31",
"speaker": "???",
"cap": 254
},
{
"id": 470,
"ko": "티르 맞죠? 오면 배를 빌려주라고 했어요.",
"kind": "dialog",
"src": "scn:e0007_scn:32",
"speaker": "디어드리",
"cap": 254
},
{
"id": 471,
"ko": "젠장... 떠난 지 얼마나 됐지?",
"kind": "dialog",
"src": "scn:e0007_scn:33",
"speaker": "티르",
"cap": 254
},
{
"id": 472,
"ko": "글쎄요오... 아무튼 배는 저기에 있어요. 항로를 기억시켜 놨으니까 바로 <뮤리아스{로 갈 거예요.",
"kind": "dialog",
"src": "scn:e0007_scn:34",
"speaker": "디어드리",
"cap": 254
},
{
"id": 473,
"ko": "&선착장으로;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:e0007_scn:35",
"cap": 254
},
{
"id": 474,
"ko": "이제 정신이 좀 드나? 마땅히 도망칠 곳이 없어서 }크래드{가 있는 곳으로 왔어.",
"kind": "dialog",
"src": "scn:e0007_scn:37",
"speaker": "티르",
"cap": 254
},
{
"id": 475,
"ko": "오.. 오라버니는! 오라버니는 어떻게 되었죠?",
"kind": "dialog",
"src": "scn:e0007_scn:38",
"speaker": "루레인",
"cap": 254
},
{
"id": 476,
"ko": "이미 죽었어. 정신차려.. 꿈도 착각도 아냐.",
"kind": "dialog",
"src": "scn:e0007_scn:39",
"speaker": "티르",
"cap": 254
},
{
"id": 477,
"ko": "아...",
"kind": "dialog",
"src": "scn:e0007_scn:40",
"speaker": "루레인",
"cap": 254
},
{
"id": 478,
"ko": "나는 지금부터 <크래드{를 만나러 갈 건데, 당신은 어쩔거지?",
"kind": "dialog",
"src": "scn:e0007_scn:41",
"speaker": "티르",
"cap": 254
},
{
"id": 479,
"ko": "그는 왜...?",
"kind": "dialog",
"src": "scn:e0007_scn:42",
"speaker": "루레인",
"cap": 254
},
{
"id": 480,
"ko": "케프네스가 크래드를 찾고 있었어. <경고{를 해줘야 해.",
"kind": "dialog",
"src": "scn:e0007_scn:43",
"speaker": "티르",
"cap": 254
},
{
"id": 481,
"ko": "케프네스가 크래드를 알고 있어요? 어째서?",
"kind": "dialog",
"src": "scn:e0007_scn:44",
"speaker": "루레인",
"cap": 254
},
{
"id": 482,
"ko": "잘은 모르지만.. 아마 }크래드가 숨기는 사실{이 케프네스와 관련이 있는 거겠지.",
"kind": "dialog",
"src": "scn:e0007_scn:45",
"speaker": "티르",
"cap": 254
},
{
"id": 483,
"ko": "그렇다면, 저도 들어야 겠어요. 아니, 들을 권리가 있어요.",
"kind": "dialog",
"src": "scn:e0007_scn:46",
"speaker": "루레인",
"cap": 254
},
{
"id": 484,
"ko": "마음대로 해.",
"kind": "dialog",
"src": "scn:e0007_scn:47",
"speaker": "티르",
"cap": 254
},
{
"id": 485,
"ko": "결국 }크래드{는... 지키지 못했군요..",
"kind": "dialog",
"src": "scn:e0007_scn:48",
"speaker": "루레인",
"cap": 254
},
{
"id": 486,
"ko": "너무 순식간에 습격을 해와서.. 일격에 당해버렸어..",
"kind": "dialog",
"src": "scn:e0007_scn:49",
"speaker": "티르",
"cap": 254
},
{
"id": 487,
"ko": "엘렌이 깨어나면.. 뭐라고 말해줘야 하죠..",
"kind": "dialog",
"src": "scn:e0007_scn:50",
"speaker": "루레인",
"cap": 254
},
{
"id": 488,
"ko": "일단 여기를 떠나게 해줘, 그건.. 내가 알아서 할 테니.",
"kind": "dialog",
"src": "scn:e0007_scn:51",
"speaker": "티르",
"cap": 254
},
{
"id": 489,
"ko": "엘렌을 노리고 있었으니 분명히 쫓아올거야.",
"kind": "dialog",
"src": "scn:e0007_scn:52",
"speaker": "티르",
"cap": 254
},
{
"id": 490,
"ko": "알겠어요.",
"kind": "dialog",
"src": "scn:e0007_scn:53",
"speaker": "루레인",
"cap": 254
},
{
"id": 491,
"ko": "&비밀통로;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:e0007_scn:54",
"cap": 254
},
{
"id": 492,
"ko": "흠, 이건 엄청난 걸 봐버린 것 같은데...",
"kind": "dialog",
"src": "scn:e0007_scn:55",
"speaker": "???",
"cap": 254
},
{
"id": 493,
"ko": "뭐, 어쨌든 보고하지 않 수 없네.",
"kind": "dialog",
"src": "scn:e0007_scn:56",
"speaker": "???",
"cap": 254
},
{
"id": 495,
"ko": "티... 르?",
"kind": "dialog",
"src": "scn:e0008_scn:1",
"speaker": "이자벨",
"cap": 254
},
{
"id": 496,
"ko": "정말 당신인가요?",
"kind": "dialog",
"src": "scn:e0008_scn:2",
"speaker": "이자벨",
"cap": 254
},
{
"id": 497,
"ko": "어떻게 해야 믿을지 모르겠어. }마법{ 같은 것에 당해서 몸을 빼앗긴 상태야.",
"kind": "dialog",
"src": "scn:e0008_scn:3",
"speaker": "티르",
"cap": 254
},
{
"id": 498,
"ko": "그런 터무니 없는... <브리안{이 그런 일을 할 이유가..",
"kind": "dialog",
"src": "scn:e0008_scn:4",
"speaker": "이자벨",
"cap": 254
},
{
"id": 499,
"ko": "믿지 않아도 좋아. 어쨌든 }케프네스님{을 만나게만 해줘.",
"kind": "dialog",
"src": "scn:e0008_scn:5",
"speaker": "티르",
"cap": 254
},
{
"id": 500,
"ko": "그 분이라면 내가 하는 말을 이해할 수 있을거야.",
"kind": "dialog",
"src": "scn:e0008_scn:6",
"speaker": "티르",
"cap": 254
},
{
"id": 501,
"ko": "당신 말을 믿는다면.. 최근에 }티르{가 보인 이상한 행동들이 이해가 가긴 해요.",
"kind": "dialog",
"src": "scn:e0008_scn:7",
"speaker": "이자벨",
"cap": 254
},
{
"id": 502,
"ko": "좋아요, 케프네스님을 만나게 해드리죠.",
"kind": "dialog",
"src": "scn:e0008_scn:8",
"speaker": "이자벨",
"cap": 254
},
{
"id": 503,
"ko": "혼자서 큰 일을 낼 수 있을것 같지도 않고..",
"kind": "dialog",
"src": "scn:e0008_scn:9",
"speaker": "이자벨",
"cap": 254
},
{
"id": 504,
"ko": "그런데 내가 있는 곳은 어떻게 알아냈죠?",
"kind": "dialog",
"src": "scn:e0008_scn:10",
"speaker": "이자벨",
"cap": 254
},
{
"id": 505,
"ko": "... 당신의 사촌인 <맥도걸{이 내 부관으로 왔을 때 말해줬어.",
"kind": "dialog",
"src": "scn:e0008_scn:11",
"speaker": "티르",
"cap": 254
},
{
"id": 506,
"ko": "나중에 제대로 입 단속을 시켜야겠군요.",
"kind": "dialog",
"src": "scn:e0008_scn:12",
"speaker": "이자벨",
"cap": 254
},
{
"id": 507,
"ko": "누구냐, 넌.",
"kind": "dialog",
"src": "scn:e0008_scn:13",
"speaker": "티르",
"cap": 254
},
{
"id": 508,
"ko": "무슨 소리인가요? 역시 아까의 이야기는 거짓말..",
"kind": "dialog",
"src": "scn:e0008_scn:14",
"speaker": "이자벨",
"cap": 254
},
{
"id": 509,
"ko": "나는 <브리안{에게 당했다고 말한 기억이 없는데.",
"kind": "dialog",
"src": "scn:e0008_scn:15",
"speaker": "티르",
"cap": 254
},
{
"id": 510,
"ko": "당신의 얼굴이 브리안이니까, 그걸보고 추측..",
"kind": "dialog",
"src": "scn:e0008_scn:16",
"speaker": "이자벨",
"cap": 254
},
{
"id": 511,
"ko": "그리고 이자벨의 사촌은 <그라함{이야.",
"kind": "dialog",
"src": "scn:e0008_scn:17",
"speaker": "티르",
"cap": 254
},
{
"id": 512,
"ko": "넌 누구냐.. 이자벨에게 무슨 짓을 한거지?",
"kind": "dialog",
"src": "scn:e0008_scn:18",
"speaker": "티르",
"cap": 254
},
{
"id": 513,
"ko": "말실수를 했네. 쓸데없는 것을 물어서...",
"kind": "dialog",
"src": "scn:e0008_scn:19",
"speaker": "이자벨",
"cap": 254
},
{
"id": 514,
"ko": "그래도 생각보다 예리한데?",
"kind": "dialog",
"src": "scn:e0008_scn:20",
"speaker": "이자벨",
"cap": 254
},
{
"id": 515,
"ko": "자신의 둔함을 상대의 예리함으로 포장하려 하지마.",
"kind": "dialog",
"src": "scn:e0008_scn:21",
"speaker": "티르",
"cap": 254
},
{
"id": 516,
"ko": "뭐, 케프네스를 만나게 해주겠다는 건 거짓말이 아니었다구.",
"kind": "dialog",
"src": "scn:e0008_scn:22",
"speaker": "이자벨",
"cap": 254
},
{
"id": 517,
"ko": "감옥 안에서지만!",
"kind": "dialog",
"src": "scn:e0008_scn:23",
"speaker": "이자벨",
"cap": 254
},
{
"id": 518,
"ko": "젠장.. 뭐가 어떻게 된거지... 이자벨까지..",
"kind": "dialog",
"src": "scn:e0008_scn:24",
"speaker": "티르",
"cap": 254
},
{
"id": 519,
"ko": "이러고 있을 때가 아냐!",
"kind": "dialog",
"src": "scn:e0008_scn:25",
"speaker": "티르",
"cap": 254
},
{
"id": 520,
"ko": "&이자벨;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:e0008_scn:26",
"cap": 254
},
{
"id": 522,
"ko": "젠장.. 쥐구멍은 없는건가..",
"kind": "dialog",
"src": "scn:e0009_scn:1",
"speaker": "티르",
"cap": 254
},
{
"id": 523,
"ko": "이쪽으로 오세요!",
"kind": "dialog",
"src": "scn:e0009_scn:2",
"speaker": "???",
"cap": 254
},
{
"id": 524,
"ko": "설명할 시간이 없습니다! 전 }케프네스님{이 보낸 사람이에요! 어서!",
"kind": "dialog",
"src": "scn:e0009_scn:3",
"speaker": "???",
"cap": 254
},
{
"id": 525,
"ko": "이런 어처구니 없는...",
"kind": "dialog",
"src": "scn:e0009_scn:4",
"speaker": "티르",
"cap": 254
},
{
"id": 526,
"ko": "도시에서의 추격전이면 출구는 전부 봉쇄하라고 그렇게 강조했는데.",
"kind": "dialog",
"src": "scn:e0009_scn:5",
"speaker": "티르",
"cap": 254
},
{
"id": 527,
"ko": "덕분에 살았지만.. 교육상태가 엉망이었군 그래.",
"kind": "dialog",
"src": "scn:e0009_scn:6",
"speaker": "티르",
"cap": 254
},
{
"id": 528,
"ko": "아저씨를 처음 만난 곳이라면.. 잊을 수 없지.",
"kind": "dialog",
"src": "scn:e0009_scn:7",
"speaker": "티르",
"cap": 254
},
{
"id": 529,
"ko": "<매도우 힐의 북동지역{... 일단 그쪽으로 가자.",
"kind": "dialog",
"src": "scn:e0009_scn:8",
"speaker": "티르",
"cap": 254
},
{
"id": 530,
"ko": "&케프네스;$...........{퀘스트 입수!",
"kind": "dialog",
"src": "scn:e0009_scn:9",
"cap": 254
},
{
"id": 531,
"ko": ".. 아직 봉쇄중인가?",
"kind": "dialog",
"src": "scn:e0009_scn:10",
"speaker": "티르",
"cap": 254
},
{
"id": 532,
"ko": "저기 병사들은 어디로 가는 겁니까?",
"kind": "dialog",
"src": "scn:e0009_scn:11",
"speaker": "티르",
"cap": 254
},
{
"id": 533,
"ko": "저 병사들요? }뮤리아스{에 추가병력{을 파병하는 거라고 하던데요. <검은 바위 섬{을 경유해서 간다고...",
"kind": "dialog",
"src": "scn:e0009_scn:12",
"speaker": "상인",
"cap": 254
},
{
"id": 534,
"ko": "덕분에 또 민항선은 출항 금지 당했어요. 장사하는 사람은 어쩌라고...",
"kind": "dialog",
"src": "scn:e0009_scn:13",
"speaker": "상인",
"cap": 254
},
{
"id": 535,
"ko": "언제 풀린답니까?",
"kind": "dialog",
"src": "scn:e0009_scn:14",
"speaker": "티르",
"cap": 254
},
{
"id": 536,
"ko": "모르죠...",
"kind": "dialog",
"src": "scn:e0009_scn:15",
"speaker": "상인",
"cap": 254
},
{
"id": 537,
"ko": "|(어쨌든 군함은 다닌다는 거군... <검은 바위 섬|을 경유한다면 병력수송선에 타면 되겠는데...)",
"kind": "dialog",
"src": "scn:e0009_scn:16",
"speaker": "티르",
"cap": 254
},
{
"id": 538,
"ko": "|(어떻게 병력수송선에 탄다..?)",
"kind": "dialog",
"src": "scn:e0009_scn:17",
"speaker": "티르",
"cap": 254
},
{
"id": 539,
"ko": "잠깐 기다려요! 아직 이쪽 주둔지에서 물자가 덜 왔어요! 저도 타야 해요!",
"kind": "dialog",
"src": "scn:e0009_scn:18",
"speaker": "안톤",
"cap": 254
},
{
"id": 540,
"ko": "|(... 저 녀석... 수레바퀴 섬 주둔지에서 <군수품을 빼돌리던 녀석|이잖아?)",
"kind": "dialog",
"src": "scn:e0009_scn:19",
"speaker": "티르",
"cap": 254
},
{
"id": 541,
"ko": "|(미안하지만 저 놈을 어떻게 이용해봐야겠군..)",
"kind": "dialog",
"src": "scn:e0009_scn:20",
"speaker": "티르",
"cap": 254
},
{
"id": 542,
"ko": "&추가병력 합류;$...........{퀘스트 입수!",
"kind": "dialog",
"src": "scn:e0009_scn:21",
"cap": 254
},
{
"id": 544,
"ko": "휴, 다행히 들키진 않은 것 같군요. 안 따라오시면 어쩌나 했습니다.",
"kind": "dialog",
"src": "scn:e0010_scn:1",
"speaker": "남자",
"cap": 254
},
{
"id": 545,
"ko": "아저.. 케프네스 님이 보냈다고 했나?",
"kind": "dialog",
"src": "scn:e0010_scn:2",
"speaker": "티르",
"cap": 254
},
{
"id": 546,
"ko": "맞습니다. 그 분께서 브리안 님이 도시로 찾아오면 이 말을 전하라고 하셨어요.",
"kind": "dialog",
"src": "scn:e0010_scn:3",
"speaker": "남자",
"cap": 254
},
{
"id": 547,
"ko": "<날 처음 만난 곳{으로 찾아와라..",
"kind": "dialog",
"src": "scn:e0010_scn:4",
"speaker": "남자",
"cap": 254
},
{
"id": 548,
"ko": "이게 그분의 메시지입니다. 분명히 전했어요.",
"kind": "dialog",
"src": "scn:e0010_scn:5",
"speaker": "남자",
"cap": 254
},
{
"id": 549,
"ko": "... 그분은 지금 어디에 계시지?",
"kind": "dialog",
"src": "scn:e0010_scn:6",
"speaker": "티르",
"cap": 254
},
{
"id": 550,
"ko": "모릅니다. 저도 }꿈{ 속에서 메시지를 전해 받은 것 뿐이에요.",
"kind": "dialog",
"src": "scn:e0010_scn:7",
"speaker": "남자",
"cap": 254
},
{
"id": 551,
"ko": "}듣는 자{.. 인가.",
"kind": "dialog",
"src": "scn:e0010_scn:8",
"speaker": "티르",
"cap": 254
},
{
"id": 552,
"ko": "뭐, 일단은 그렇습니다.",
"kind": "dialog",
"src": "scn:e0010_scn:9",
"speaker": "남자",
"cap": 254
},
{
"id": 553,
"ko": "자, 그 얼굴은 알려졌으니 가면을 저에게 주시고 이걸 사용하세요.",
"kind": "dialog",
"src": "scn:e0010_scn:10",
"speaker": "남자",
"cap": 254
},
{
"id": 554,
"ko": "&새로운 가면 획득!",
"kind": "dialog",
"src": "scn:e0010_scn:11",
"cap": 254
},
{
"id": 555,
"ko": "제가 시선을 끄는 동안 밖으로 탈출하세요.",
"kind": "dialog",
"src": "scn:e0010_scn:12",
"speaker": "남자",
"cap": 254
},
{
"id": 556,
"ko": "괜찮겠나? 잡히면...",
"kind": "dialog",
"src": "scn:e0010_scn:13",
"speaker": "티르",
"cap": 254
},
{
"id": 557,
"ko": "그보다는 <케프네스님을 구하는 게{ 더 중요합니다.",
"kind": "dialog",
"src": "scn:e0010_scn:14",
"speaker": "남자",
"cap": 254
},
{
"id": 558,
"ko": "구하다니? 무슨 소리야?",
"kind": "dialog",
"src": "scn:e0010_scn:15",
"speaker": "티르",
"cap": 254
},
{
"id": 559,
"ko": "가 보시면 알 겁니다.",
"kind": "dialog",
"src": "scn:e0010_scn:16",
"speaker": "남자",
"cap": 254
},
{
"id": 560,
"ko": "저기다!",
"kind": "dialog",
"src": "scn:e0010_scn:17",
"speaker": "병사",
"cap": 254
},
{
"id": 561,
"ko": "서쪽 통로다! 전 병력 서쪽 입구를 봉쇄해!",
"kind": "dialog",
"src": "scn:e0010_scn:18",
"speaker": "병사",
"cap": 254
},
{
"id": 563,
"ko": "다들 비켜라.",
"kind": "dialog",
"src": "scn:e0011_scn:1",
"speaker": "티르",
"cap": 254
},
{
"id": 564,
"ko": "당신은! 여기가 뭐 하는 곳인 줄은 알고 온 건가?",
"kind": "dialog",
"src": "scn:e0011_scn:2",
"speaker": "노인",
"cap": 254
},
{
"id": 565,
"ko": "아, 안돼! 그만둬!!",
"kind": "dialog",
"src": "scn:e0011_scn:3",
"speaker": "노인",
"cap": 254
},
{
"id": 566,
"ko": "이 버러지 같은 생물들이...",
"kind": "dialog",
"src": "scn:e0011_scn:4",
"speaker": "???",
"cap": 254
},
{
"id": 567,
"ko": "어이..",
"kind": "dialog",
"src": "scn:e0011_scn:5",
"speaker": "티르",
"cap": 254
},
{
"id": 568,
"ko": "야. 뭐냐? 일어나봐?",
"kind": "dialog",
"src": "scn:e0011_scn:6",
"speaker": "???",
"cap": 254
},
{
"id": 569,
"ko": "이 정도로 죽어버리면 재미없지? 야, 야?",
"kind": "dialog",
"src": "scn:e0011_scn:7",
"speaker": "???",
"cap": 254
},
{
"id": 570,
"ko": "니들이 날 가지고 논 것만큼은 나도 놀게 해줘야 할 것 아냐?",
"kind": "dialog",
"src": "scn:e0011_scn:8",
"speaker": "???",
"cap": 254
},
{
"id": 571,
"ko": "세 놈이 아닌데.. 밖에 더 있다는 얘기로군?",
"kind": "dialog",
"src": "scn:e0011_scn:9",
"speaker": "???",
"cap": 254
},
{
"id": 572,
"ko": "어마? 깜짝야.",
"kind": "dialog",
"src": "scn:e0011_scn:10",
"speaker": "???",
"cap": 254
},
{
"id": 573,
"ko": "이 자식, 이게 뭐하는 짓이지?",
"kind": "dialog",
"src": "scn:e0011_scn:11",
"speaker": "티르",
"cap": 254
},
{
"id": 574,
"ko": "어하하 무셔라, 넌 뭐하는 놈이세요?",
"kind": "dialog",
"src": "scn:e0011_scn:12",
"speaker": "???",
"cap": 254
},
{
"id": 575,
"ko": "널 풀어준 사람이다.",
"kind": "dialog",
"src": "scn:e0011_scn:13",
"speaker": "티르",
"cap": 254
},
{
"id": 576,
"ko": "어마 감사해요? 근데 이제 용무가 끝난 거 같은데요?",
"kind": "dialog",
"src": "scn:e0011_scn:14",
"speaker": "???",
"cap": 254
},
{
"id": 577,
"ko": "시체 옆에 얌전히 누워계시면 살려드릴테니 저리 가서 누워 있을래?",
"kind": "dialog",
"src": "scn:e0011_scn:15",
"speaker": "???",
"cap": 254
},
{
"id": 578,
"ko": "... 다물어.",
"kind": "dialog",
"src": "scn:e0011_scn:16",
"speaker": "티르",
"cap": 254
},
{
"id": 579,
"ko": "하.. 내 말이 시끄럽니? 장난으로 들려?",
"kind": "dialog",
"src": "scn:e0011_scn:17",
"speaker": "???",
"cap": 254
},
{
"id": 580,
"ko": "어허헛쭈구리? 제법 아파요?",
"kind": "dialog",
"src": "scn:e0011_scn:18",
"speaker": "???",
"cap": 254
},
{
"id": 581,
"ko": ".. 약자를 괴롭히는 건 나쁜 짓이라는 게 느껴지나?",
"kind": "dialog",
"src": "scn:e0011_scn:19",
"speaker": "티르",
"cap": 254
},
{
"id": 582,
"ko": "어머나 건방진 모습. 그럼요 괴롭히는 건 나쁜 짓이죠.",
"kind": "dialog",
"src": "scn:e0011_scn:20",
"speaker": "???",
"cap": 254
},
{
"id": 583,
"ko": "하지만 죽이는 건 나쁘지 않잖아.. 응?",
"kind": "dialog",
"src": "scn:e0011_scn:21",
"speaker": "???",
"cap": 254
},
{
"id": 584,
"ko": "계속 할 생각이냐!",
"kind": "dialog",
"src": "scn:e0011_scn:22",
"speaker": "티르",
"cap": 254
},
{
"id": 585,
"ko": "걱정마, 나쁜 짓 안하고 죽여줄테... 크윽?!",
"kind": "dialog",
"src": "scn:e0011_scn:23",
"speaker": "???",
"cap": 254
},
{
"id": 586,
"ko": "넌 또 뭐야! 간섭하지... 크아아아악!",
"kind": "dialog",
"src": "scn:e0011_scn:24",
"speaker": "???",
"cap": 254
},
{
"id": 587,
"ko": "티르, 괜찮나?",
"kind": "dialog",
"src": "scn:e0011_scn:25",
"speaker": "???",
"cap": 254
},
{
"id": 588,
"ko": "겨우 }정신 제압{에 성공했군. 나다.",
"kind": "dialog",
"src": "scn:e0011_scn:26",
"speaker": "???",
"cap": 254
},
{
"id": 589,
"ko": "아저.. 대장?",
"kind": "dialog",
"src": "scn:e0011_scn:27",
"speaker": "티르",
"cap": 254
},
{
"id": 590,
"ko": "아무래도 너와 직접 링크가 되지 않으니 영 불편하군. 타이밍을 맞추기가 힘들었다.",
"kind": "dialog",
"src": "scn:e0011_scn:28",
"speaker": "???",
"cap": 254
},
{
"id": 591,
"ko": "이 자는 괜찮은 겁니까? 미친 듯이 사람들을 공격하는데..",
"kind": "dialog",
"src": "scn:e0011_scn:29",
"speaker": "티르",
"cap": 254
},
{
"id": 592,
"ko": "잠깐 이성을 잃었던 것 뿐일거다. 그보다, <다음 지시{를 전해 놓았으니 이 자가 깨어나면 뒷일을 부탁한다.",
"kind": "dialog",
"src": "scn:e0011_scn:30",
"speaker": "???",
"cap": 254
},
{
"id": 593,
"ko": "아오오 머리통 터지겠네, 왜 그냥 말하면 되지 머릿속에 들어오고 난리셔!",
"kind": "dialog",
"src": "scn:e0011_scn:31",
"speaker": "???",
"cap": 254
},
{
"id": 594,
"ko": "네가 너무 말을 잘 들어서 그러셨겠지.",
"kind": "dialog",
"src": "scn:e0011_scn:32",
"speaker": "티르",
"cap": 254
},
{
"id": 595,
"ko": "}티르{라고 했나? 네 놈 차아아암 맘에 든다.",
"kind": "dialog",
"src": "scn:e0011_scn:33",
"speaker": "???",
"cap": 254
},
{
"id": 596,
"ko": "됐으니까 대장의 지령만 말하고, 다물어.",
"kind": "dialog",
"src": "scn:e0011_scn:34",
"speaker": "티르",
"cap": 254
},
{
"id": 597,
"ko": "네네 명령 받들어모십죠, 대장님께서 }팔리아스{로 꺼지랍시는 군요.",
"kind": "dialog",
"src": "scn:e0011_scn:35",
"speaker": "???",
"cap": 254
},
{
"id": 598,
"ko": "팔리아스? 거긴 선주종 영역이잖아? 거기서 뭘하라고?",
"kind": "dialog",
"src": "scn:e0011_scn:36",
"speaker": "티르",
"cap": 254
},
{
"id": 599,
"ko": "팔리아스 유적지에 있는 <동굴{에 <내 동료{가 하나 있어. <래비{라고. 그놈도 좀 구해달라시는군.",
"kind": "dialog",
"src": "scn:e0011_scn:37",
"speaker": "???",
"cap": 254
},
{
"id": 600,
"ko": "왜 선주종 영역에... 인간은 들어가지도 못할텐데?",
"kind": "dialog",
"src": "scn:e0011_scn:38",
"speaker": "티르",
"cap": 254
},
{
"id": 601,
"ko": "아하. 지령 전했으니 다물어드립죠. 대장이 티르님 말 잘 들으랬으니까.",
"kind": "dialog",
"src": "scn:e0011_scn:39",
"speaker": "???",
"cap": 254
},
{
"id": 602,
"ko": "좀 쉴테니까 할 말있으면 네가 찾아와라잉?",
"kind": "dialog",
"src": "scn:e0011_scn:40",
"speaker": "???",
"cap": 254
},
{
"id": 603,
"ko": "언제쯤 죽이면 되지 저거.. 열 뻗치네..",
"kind": "dialog",
"src": "scn:e0011_scn:41",
"speaker": "???",
"cap": 254
},
{
"id": 604,
"ko": "|(이런 난폭하고 앞뒤 없는 놈이 대장의 부하라니.. 믿어도 될까?)",
"kind": "dialog",
"src": "scn:e0011_scn:42",
"speaker": "티르",
"cap": 254
},
{
"id": 605,
"ko": "|(게다가 팔리아스에 있다는 동료는? 아직 인간은 거기에 발을 디딘 적이 없을텐데.)",
"kind": "dialog",
"src": "scn:e0011_scn:43",
"speaker": "티르",
"cap": 254
},
{
"id": 606,
"ko": "|(아냐, 아냐. 일단 대장을 구하고 몸을 되찾는 것만 생각하자.)",
"kind": "dialog",
"src": "scn:e0011_scn:44",
"speaker": "티르",
"cap": 254
},
{
"id": 607,
"ko": "어이, 넌 뭐라고 부르면 되지?",
"kind": "dialog",
"src": "scn:e0011_scn:45",
"speaker": "티르",
"cap": 254
},
{
"id": 608,
"ko": "}루칸{이라고 불러.",
"kind": "dialog",
"src": "scn:e0011_scn:46",
"speaker": "???",
"cap": 254
},
{
"id": 609,
"ko": "대장과 연락할 수 있나?",
"kind": "dialog",
"src": "scn:e0011_scn:47",
"speaker": "티르",
"cap": 254
},
{
"id": 610,
"ko": "필요하다면. 왜, 팔리아스로 가는 법이라도 물어봐 줄..",
"kind": "dialog",
"src": "scn:e0011_scn:48",
"speaker": "루칸",
"cap": 254
},
{
"id": 611,
