[
{
"id": 3717,
"ko": "아무도 없어요. 나오..",
"kind": "dialog",
"src": "scn:n0015_scn:1",
"speaker": "루레인",
"cap": 254
},
{
"id": 3718,
"ko": "잠깐!",
"kind": "dialog",
"src": "scn:n0015_scn:2",
"speaker": "루레인",
"cap": 254
},
{
"id": 3719,
"ko": "놓아 보낼 수는 없소.",
"kind": "dialog",
"src": "scn:n0015_scn:3",
"speaker": "래비",
"cap": 254
},
{
"id": 3720,
"ko": "적이 있어요! 조심해요!",
"kind": "dialog",
"src": "scn:n0015_scn:4",
"speaker": "루레인",
"cap": 254
},
{
"id": 3721,
"ko": "강하군..",
"kind": "dialog",
"src": "scn:n0015_scn:5",
"speaker": "래비",
"cap": 254
},
{
"id": 3722,
"ko": "그대의 강함에 응답해주도록 하겠소!",
"kind": "dialog",
"src": "scn:n0015_scn:6",
"speaker": "래비",
"cap": 254
},
{
"id": 3723,
"ko": "비켜요!",
"kind": "dialog",
"src": "scn:n0015_scn:7",
"speaker": "루레인",
"cap": 254
},
{
"id": 3724,
"ko": "흠.. 이 정도인가. 남은 건 }루칸{이 잘 해주기를 빌어야겠구려.",
"kind": "dialog",
"src": "scn:n0015_scn:8",
"speaker": "래비",
"cap": 254
},
{
"id": 3725,
"ko": "루칸이라니.. 무슨 소리죠?",
"kind": "dialog",
"src": "scn:n0015_scn:9",
"speaker": "루레인",
"cap": 254
},
{
"id": 3726,
"ko": "글쎄.. 무슨 소리라 생각하시오?",
"kind": "dialog",
"src": "scn:n0015_scn:10",
"speaker": "래비",
"cap": 254
},
{
"id": 3727,
"ko": "미안하지만 이 길은 사용할 수 없을 거요.",
"kind": "dialog",
"src": "scn:n0015_scn:11",
"speaker": "래비",
"cap": 254
},
{
"id": 3728,
"ko": "무너뜨렸나.. 두 세명이라면 텔레포트 할 수 있겠지만..",
"kind": "dialog",
"src": "scn:n0015_scn:12",
"speaker": "루레인",
"cap": 254
},
{
"id": 3729,
"ko": "일단.. 그들에게 돌아가자. 그 인간은 아무래도 상관없지만.. <크래드{는 보호해야 해.",
"kind": "dialog",
"src": "scn:n0015_scn:14",
"speaker": "루레인",
"cap": 254
},
{
"id": 3730,
"ko": "아직 그 이야기를 듣지 못했으니까..",
"kind": "dialog",
"src": "scn:n0015_scn:15",
"speaker": "루레인",
"cap": 254
},
{
"id": 3731,
"ko": "&다시 비밀통로;$...........{퀘스트 입수!",
"kind": "dialog",
"src": "scn:n0015_scn:17",
"cap": 254
},
{
"id": 3732,
"ko": "가디언..! 어느 틈에 신전에 침입을..!?",
"kind": "dialog",
"src": "scn:n0016_scn:1",
"speaker": "루레인",
"cap": 254
},
{
"id": 3733,
"ko": "<이것은 환영에 불과하다..;;가디언, 수호자로서;싸워야 할 적에 대한..",
"kind": "dialog",
"src": "scn:n0016_scn:2",
"cap": 254
},
{
"id": 3734,
"ko": "<증명하라,;;모든 전승을 받아들일;스스로의 의지를!",
"kind": "dialog",
"src": "scn:n0016_scn:3",
"cap": 254
},
{
"id": 3735,
"ko": "<그러나..;네베드의 후손들은;강림자들을 실망시켰다..",
"kind": "dialog",
"src": "scn:n0016_scn:4",
"cap": 254
},
{
"id": 3736,
"ko": "<실망한 그들은;다친 몸을 이끌고;자신들의 세상으로 돌아갔다.",
"kind": "dialog",
"src": "scn:n0016_scn:5",
"cap": 254
},
{
"id": 3737,
"ko": "<네베드의 후손들은..;자신들의 부모나 다름없는;강림자들이 실망한;이유를 알지 못했다..",
"kind": "dialog",
"src": "scn:n0016_scn:6",
"cap": 254
},
{
"id": 3738,
"ko": "<왜 버림 받은 것인가?..",
"kind": "dialog",
"src": "scn:n0016_scn:7",
"cap": 254
},
{
"id": 3739,
"ko": "<그들의 빈약한 머리로;생각한 것은 하나..",
"kind": "dialog",
"src": "scn:n0016_scn:8",
"cap": 254
},
{
"id": 3740,
"ko": "<그렇다..;신들이, 강림자들이;실망했다면..",
"kind": "dialog",
"src": "scn:n0016_scn:9",
"cap": 254
},
{
"id": 3741,
"ko": "<우리는 우리의 가치를;증명해야 한다..",
"kind": "dialog",
"src": "scn:n0016_scn:10",
"cap": 254
},
{
"id": 3742,
"ko": "<그렇게 한다면;그들은 돌아올 것이다..",
"kind": "dialog",
"src": "scn:n0016_scn:11",
"cap": 254
},
{
"id": 3743,
"ko": "<그러기 위해..;신들의 가장 강대한 적..;악몽을 굴복시키자..",
"kind": "dialog",
"src": "scn:n0016_scn:12",
"cap": 254
},
{
"id": 3744,
"ko": "<그래서 그들은..;강림자들이 남긴 보석,;진정한 마법을 사용하여..",
"kind": "dialog",
"src": "scn:n0016_scn:13",
"cap": 254
},
{
"id": 3745,
"ko": "<강림자들이;성지에 설치한 봉인에;구멍을 내었다..",
"kind": "dialog",
"src": "scn:n0016_scn:14",
"cap": 254
},
{
"id": 3746,
"ko": "<진정한 마법은;진정한 마법만으로;상처를 낼 수 있었기에..",
"kind": "dialog",
"src": "scn:n0016_scn:15",
"cap": 254
},
{
"id": 3747,
"ko": "<강림자들이;만일을 위해 남겨둔;크리스탈을 사용하여..",
"kind": "dialog",
"src": "scn:n0016_scn:16",
"cap": 254
},
{
"id": 3748,
"ko": "<그들 스스로의 손으로..",
"kind": "dialog",
"src": "scn:n0016_scn:17",
"cap": 254
},
{
"id": 3749,
"ko": "<구멍에서 흘러나오는;고대신의 힘을 퍼내어..",
"kind": "dialog",
"src": "scn:n0016_scn:18",
"cap": 254
},
{
"id": 3750,
"ko": "<그들이;소환수라고 부르는,;고대신의 파편을 통해;사용했다..",
"kind": "dialog",
"src": "scn:n0016_scn:19",
"cap": 254
},
{
"id": 3751,
"ko": "<한 때..;그들의 적이었던 힘을..",
"kind": "dialog",
"src": "scn:n0016_scn:20",
"cap": 254
},
{
"id": 3752,
"ko": "<그러니..;명심하라.;;이것이 수호자의 책무.",
"kind": "dialog",
"src": "scn:n0016_scn:21",
"cap": 254
},
{
"id": 3753,
"ko": "<마법의 본질을 이해하라..;;봉인을 지켜라..",
"kind": "dialog",
"src": "scn:n0016_scn:22",
"cap": 254
},
{
"id": 3754,
"ko": "<잠든 고대신이;깨어나지 않도록;봉인을 수호하라..",
"kind": "dialog",
"src": "scn:n0016_scn:23",
"cap": 254
},
{
"id": 3755,
"ko": "스스로.. 봉인에 구멍을 냈다고..?",
"kind": "dialog",
"src": "scn:n0016_scn:24",
"speaker": "루레인",
"cap": 254
},
{
"id": 3756,
"ko": "그래서.. 케프네스가 }봉인{을 파괴하지 못한 거구나.. 그가 파괴한 건 }우리가 설치한 것{ 뿐..",
"kind": "dialog",
"src": "scn:n0016_scn:25",
"speaker": "루레인",
"cap": 254
},
{
"id": 3757,
"ko": "그래서.. 그가 }크리스탈{을 찾고 있는 거야.",
"kind": "dialog",
"src": "scn:n0016_scn:26",
"speaker": "루레인",
"cap": 254
},
{
"id": 3758,
"ko": "그래서 그가.. 소환수로 우리를 타락시킬 수 있는 거야..",
"kind": "dialog",
"src": "scn:n0016_scn:27",
"speaker": "루레인",
"cap": 254
},
{
"id": 3759,
"ko": "크리스탈이 }진정한 마법{이라면.. 정말, 죽은 자를 살릴 수 있을 거야.",
"kind": "dialog",
"src": "scn:n0016_scn:28",
"speaker": "루레인",
"cap": 254
},
{
"id": 3760,
"ko": "돌아가서.. 크리스탈을 찾자.",
"kind": "dialog",
"src": "scn:n0016_scn:29",
"speaker": "루레인",
"cap": 254
},
{
"id": 3761,
"ko": "<티르{... 케프네스를 따르던 그라면 뭔가를 알고 있을거야.",
"kind": "dialog",
"src": "scn:n0016_scn:30",
"speaker": "루레인",
"cap": 254
},
{
"id": 3762,
"ko": "&아눈 신전;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:n0016_scn:31",
"cap": 254
},
{
"id": 3763,
"ko": "&크리스탈;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:n0016_scn:32",
"cap": 254
},
{
"id": 3764,
"ko": "&크리스탈의 단서;$...........{퀘스트 입수!",
"kind": "dialog",
"src": "scn:n0016_scn:33",
"cap": 254
},
{
"id": 3765,
"ko": "루레인 언니..",
"kind": "dialog",
"src": "scn:n0016_scn:34",
"speaker": "엘렌",
"cap": 254
},
{
"id": 3766,
"ko": "미안.. 미안해.",
"kind": "dialog",
"src": "scn:n0016_scn:35",
"speaker": "루레인",
"cap": 254
},
{
"id": 3767,
"ko": "그만 둬라!",
"kind": "dialog",
"src": "scn:n0016_scn:36",
"speaker": "브레스",
"cap": 254
},
{
"id": 3768,
"ko": "장로님..",
"kind": "dialog",
"src": "scn:n0016_scn:37",
"speaker": "루레인",
"cap": 254
},
{
"id": 3769,
"ko": "어리석은 것! 지금 무슨 짓을 하는 지 알고 있는거냐!",
"kind": "dialog",
"src": "scn:n0016_scn:38",
"speaker": "브레스",
"cap": 254
},
{
"id": 3770,
"ko": "이 아이는..",
"kind": "dialog",
"src": "scn:n0016_scn:39",
"speaker": "루레인",
"cap": 254
},
{
"id": 3771,
"ko": "설령 그 아이를 죽여서 케프네스를 막을 수 있다고 해도, 그런 짓은 하지 않아! 그것은 가디언들, }저주 받은 자{들의 방식이다!",
"kind": "dialog",
"src": "scn:n0016_scn:40",
"speaker": "브레스",
"cap": 254
},
{
"id": 3772,
"ko": "이게.. 가장 빠른 방법이에요.",
"kind": "dialog",
"src": "scn:n0016_scn:41",
"speaker": "엘렌",
"cap": 254
},
{
"id": 3773,
"ko": "그리고 가장 그릇된 방법이지. 건방진 꼬마. 쉽고, 빠르고, 편한 길. 그렇게 유혹하지. 네가 죽으면?",
"kind": "dialog",
"src": "scn:n0016_scn:42",
"speaker": "브레스",
"cap": 254
},
{
"id": 3774,
"ko": "그 다음에는 누구를 희생시키면 되는거냐?",
"kind": "dialog",
"src": "scn:n0016_scn:43",
"speaker": "브레스",
"cap": 254
},
{
"id": 3775,
"ko": "천년도 전부터 그 악마는 그런 식으로 우리를 타락시켜 왔다. 어떠한 일이 있어도, 마음만은, 정신만은 그 자의 뜻대로 굽히지 않는다!",
"kind": "dialog",
"src": "scn:n0016_scn:44",
"speaker": "브레스",
"cap": 254
},
{
"id": 3776,
"ko": "그리고 너! 루레인! 노덴스가 한 번도 너를 자신의 딸이 아니라고 한 적이 있느냐! 그는 너를 위해 목숨을 희생..",
"kind": "dialog",
"src": "scn:n0016_scn:45",
"speaker": "브레스",
"cap": 254
},
{
"id": 3777,
"ko": "낯간지러운 연설은 거기까지 하시지, 늙은이.",
"kind": "dialog",
"src": "scn:n0016_scn:46",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3778,
"ko": "장로님!",
"kind": "dialog",
"src": "scn:n0016_scn:47",
"speaker": "루레인",
"cap": 254
},
{
"id": 3779,
"ko": "장로님...!",
"kind": "dialog",
"src": "scn:n0016_scn:48",
"speaker": "루레인",
"cap": 254
},
{
"id": 3780,
"ko": "멍청한 것.. 나한테 올 때냐.. 어서 저 자를 막아라.. 그리고 }디어드리{를..",
"kind": "dialog",
"src": "scn:n0016_scn:49",
"speaker": "브레스",
"cap": 254
},
{
"id": 3781,
"ko": "장로님.. 장로님!",
"kind": "dialog",
"src": "scn:n0016_scn:50",
"speaker": "루레인",
"cap": 254
},
{
"id": 3782,
"ko": "늦는군.",
"kind": "dialog",
"src": "scn:n0016_scn:51",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3783,
"ko": "뭐, 대장처럼 여기서 `뿅{, 저기서 <뿅{하고 등장하지 못하니까.. 이해해 주시지 말입니다?",
"kind": "dialog",
"src": "scn:n0016_scn:52",
"speaker": "루칸",
"cap": 254
},
{
"id": 3784,
"ko": "나의 분신이 }예정대로{ 날 크리스탈에게 인도해주었다.",
"kind": "dialog",
"src": "scn:n0016_scn:53",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3785,
"ko": "}크리스탈{은 손에 넣었으니, 이제 }필요 없어{.",
"kind": "dialog",
"src": "scn:n0016_scn:54",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3786,
"ko": "... 내가..?",
"kind": "dialog",
"src": "scn:n0016_scn:55",
"cap": 254
},
{
"id": 3787,
"ko": "예정대로?;인도했다고?",
"kind": "dialog",
"src": "scn:n0016_scn:56",
"cap": 254
},
{
"id": 3788,
"ko": "나는 그런 존재였나?",
"kind": "dialog",
"src": "scn:n0016_scn:57",
"cap": 254
},
{
"id": 3789,
"ko": "내가..;내가 모든 걸 망친거야?",
"kind": "dialog",
"src": "scn:n0016_scn:58",
"cap": 254
},
{
"id": 3790,
"ko": "벗어날 수 없는거야?;저 악마의 의지 속에서?",
"kind": "dialog",
"src": "scn:n0016_scn:59",
"cap": 254
},
{
"id": 3791,
"ko": "나는... 나는..!!",
"kind": "dialog",
"src": "scn:n0016_scn:60",
"cap": 254
},
{
"id": 3792,
"ko": "`허가한다.;마음대로 날뛰어라.",
"kind": "dialog",
"src": "scn:n0016_scn:62",
"cap": 254
},
{
"id": 3793,
"ko": "`그리고 그.건.;이제 쓸모가 없으니;폐기해도 된다.",
"kind": "dialog",
"src": "scn:n0016_scn:63",
"cap": 254
},
{
"id": 3794,
"ko": "안돼!",
"kind": "dialog",
"src": "scn:n0016_scn:65",
"speaker": "디어드리",
"cap": 254
},
{
"id": 3795,
"ko": "오호, 아직 살아계셨어요?",
"kind": "dialog",
"src": "scn:n0016_scn:66",
"speaker": "루칸",
"cap": 254
},
{
"id": 3796,
"ko": "루레인, 정신차려..!",
"kind": "dialog",
"src": "scn:n0016_scn:67",
"speaker": "디어드리",
"cap": 254
},
{
"id": 3797,
"ko": "아우 너무 `강<력{하시네. 죽이고 온 줄 알았더니 또 달려들고.",
"kind": "dialog",
"src": "scn:n0016_scn:68",
"speaker": "루칸",
"cap": 254
},
{
"id": 3798,
"ko": "루.. 레인.. 도망...",
"kind": "dialog",
"src": "scn:n0016_scn:69",
"speaker": "디어드리",
"cap": 254
},
{
"id": 3799,
"ko": "또 일어나면 무서우니까 아예 재로 만들어 드릴게요?",
"kind": "dialog",
"src": "scn:n0016_scn:70",
"speaker": "루칸",
"cap": 254
},
{
"id": 3800,
"ko": "^아.. 아..",
"kind": "dialog",
"src": "scn:n0016_scn:71",
"speaker": "루레인",
"cap": 254
},
{
"id": 3801,
"ko": "자, 자, 이제 살아 숨쉬는 건 한명 뿐이죠?",
"kind": "dialog",
"src": "scn:n0016_scn:72",
"speaker": "루칸",
"cap": 254
},
{
"id": 3802,
"ko": "^아아아아악!",
"kind": "dialog",
"src": "scn:n0016_scn:73",
"speaker": "루레인",
"cap": 254
},
{
"id": 3803,
"ko": "이젠 모르겠어..",
"kind": "dialog",
"src": "scn:n0016_scn:74",
"cap": 254
},
{
"id": 3804,
"ko": "이젠...",
"kind": "dialog",
"src": "scn:n0016_scn:75",
"cap": 254
},
{
"id": 3805,
"ko": "&크리스탈 파괴;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:n0016_scn:82",
"cap": 254
},
{
"id": 3806,
"ko": "케프네스..!",
"kind": "dialog",
"src": "scn:n0017_scn:1",
"speaker": "루레인",
"cap": 254
},
{
"id": 3807,
"ko": "겨우 찾아왔나. 기다리다 지쳤다.",
"kind": "dialog",
"src": "scn:n0017_scn:2",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3808,
"ko": "여전히 성격은 급하군.",
"kind": "dialog",
"src": "scn:n0017_scn:3",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3809,
"ko": "무슨 속셈이지..?",
"kind": "dialog",
"src": "scn:n0017_scn:4",
"speaker": "루레인",
"cap": 254
},
{
"id": 3810,
"ko": "글쎄.. 무슨 속셈일까? }크래드의 일기{는 다 읽어봤나?",
"kind": "dialog",
"src": "scn:n0017_scn:5",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3811,
"ko": "어떻게 그걸..!",
"kind": "dialog",
"src": "scn:n0017_scn:6",
"speaker": "루레인",
"cap": 254
},
{
"id": 3812,
"ko": "|(설마 }티르|가.. 여전히 이 자의 부하.. 속은 건가?)",
"kind": "dialog",
"src": "scn:n0017_scn:7",
"speaker": "루레인",
"cap": 254
},
{
"id": 3813,
"ko": "}티르{가 여전히 내 부하라서 널 속였다고 생각하는군.",
"kind": "dialog",
"src": "scn:n0017_scn:8",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3814,
"ko": "`그래.;너의 생각을 읽고 있다.",
"kind": "dialog",
"src": "scn:n0017_scn:9",
"cap": 254
},
{
"id": 3815,
"ko": "`말을 하는 것도 가능하지..;;이렇게 말이다.",
"kind": "dialog",
"src": "scn:n0017_scn:10",
"cap": 254
},
{
"id": 3816,
"ko": "어떻게..",
"kind": "dialog",
"src": "scn:n0017_scn:11",
"speaker": "루레인",
"cap": 254
},
{
"id": 3817,
"ko": "스스로 부정하지만 않았으면 벌써 깨달았을 문제인데.",
"kind": "dialog",
"src": "scn:n0017_scn:12",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3818,
"ko": "}대홍수 말기{의 일이다. 전황이 불리해지자 고대신은.. 자신의 모든 능력을 동원해서 }완벽한 부하{를 만들어 내려고 했지.",
"kind": "dialog",
"src": "scn:n0017_scn:13",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3819,
"ko": "죽지 않는.. }괴물{을. 하지만 그것은 신이 아니었어. 한없이 신에 가깝긴 하지만.. 신은 아니었지.",
"kind": "dialog",
"src": "scn:n0017_scn:14",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3820,
"ko": "그래서 만들어진 것은 어설픈 괴물에 불과했다. }무한히 분열하는 괴물의 군체.{ 모두의 기억과 경험을 공유하는.. 한없이 불사에 가깝지만 결코 죽지 않는 것은 아닌.",
"kind": "dialog",
"src": "scn:n0017_scn:15",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3821,
"ko": "쓸모없는 노력이었지. 그것 역시 대홍수 때에 고대신과 함께 }봉인{되었다. 다시 }발견{된 것은.. }28년 전{..",
"kind": "dialog",
"src": "scn:n0017_scn:16",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3822,
"ko": "당신이 정체 따위, 이미 알고 있어요!",
"kind": "dialog",
"src": "scn:n0017_scn:17",
"speaker": "루레인",
"cap": 254
},
{
"id": 3823,
"ko": "또, 스스로 부정하는군. 내가 내 정체를 내 입으로 말하고 있다고? 그것 뿐일까?",
"kind": "dialog",
"src": "scn:n0017_scn:18",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3824,
"ko": "나는 }우리{의 정체를 말하고 있는거야.",
"kind": "dialog",
"src": "scn:n0017_scn:19",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3825,
"ko": "무슨...!",
"kind": "dialog",
"src": "scn:n0017_scn:20",
"speaker": "루레인",
"cap": 254
},
{
"id": 3826,
"ko": "인간들은 그 생물을 잡아다가 연구했다. 바로 이곳에서. 뭐, 이유는 여러가지가 있었겠지. 나 역시 다 알지는 못해.",
"kind": "dialog",
"src": "scn:n0017_scn:21",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3827,
"ko": "그들은 무수히 분열하는 성질을 이용해서 수많은 }복제체{들을 만들었다. 그 중의 하나..",
"kind": "dialog",
"src": "scn:n0017_scn:22",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3828,
"ko": "}크래드{가 }크리스탈과 함께{ 가지고 도망친.. }복제체{가 하나 있었다. 크래드는 그걸 }노덴스{에게 넘겼지..",
"kind": "dialog",
"src": "scn:n0017_scn:23",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3829,
"ko": "그리고 그것은 }네베드{의 모습으로 }의태{를 시작했다. 노덴스는 거기에 이름을 붙였지.. <루레인{, 이라고 말이야.",
"kind": "dialog",
"src": "scn:n0017_scn:24",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3830,
"ko": "그런 소릴 믿을 줄 알고?",
"kind": "dialog",
"src": "scn:n0017_scn:25",
"speaker": "루레인",
"cap": 254
},
{
"id": 3831,
"ko": "`고대신의 음성{이, `나의 의지{가, `고대종의 저주{가. 이미 너에게 진실을 가르쳐 주었을 터다.",
"kind": "dialog",
"src": "scn:n0017_scn:26",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3832,
"ko": "닥쳐! 나는 네베드의 수호자 노덴스와 자비로운 다누의 딸...",
"kind": "dialog",
"src": "scn:n0017_scn:27",
"speaker": "루레인",
"cap": 254
},
{
"id": 3833,
"ko": "알고 있잖은가? 너는 노덴스의 친자식이 아니라고. 누아다는 친오빠가 아니라고.",
"kind": "dialog",
"src": "scn:n0017_scn:28",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3834,
"ko": "노덴스의 부인인 }다누{는 28년 전의 }그 사건{때 이미 죽었어, 그 이야기도 들었을 텐데?",
"kind": "dialog",
"src": "scn:n0017_scn:29",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3835,
"ko": "거짓말! 거짓말이야!",
"kind": "dialog",
"src": "scn:n0017_scn:30",
"speaker": "루레인",
"cap": 254
},
{
"id": 3836,
"ko": "끝까지 부정하려한다면.",
"kind": "dialog",
"src": "scn:n0017_scn:31",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3837,
"ko": "자.. 어떤가? 이제 믿을 수 있나?",
"kind": "dialog",
"src": "scn:n0017_scn:32",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3838,
"ko": "닥치라고!!",
"kind": "dialog",
"src": "scn:n0017_scn:33",
"speaker": "루레인",
"cap": 254
},
{
"id": 3839,
"ko": "나는.. 나는..",
"kind": "dialog",
"src": "scn:n0017_scn:34",
"speaker": "루레인",
"cap": 254
},
{
"id": 3840,
"ko": "너는 나의 }분신{에 지나지 않아. 아니, }내{가 }너{의 분신인 걸까. 그렇다면 너를 }어머니{라고 불러야 하나?",
"kind": "dialog",
"src": "scn:n0017_scn:35",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3841,
"ko": "^사라져 버려!",
"kind": "dialog",
"src": "scn:n0017_scn:36",
"speaker": "루레인",
"cap": 254
},
{
"id": 3842,
"ko": "내게.. 내게 이런 이야기를 하는 이유가 뭐야!",
"kind": "dialog",
"src": "scn:n0017_scn:37",
"speaker": "루레인",
"cap": 254
},
{
"id": 3843,
"ko": "`여흥이다..;멸망을 안겨주기 전.",
"kind": "dialog",
"src": "scn:n0017_scn:38",
"cap": 254
},
{
"id": 3844,
"ko": "`나는 악몽의 사도.;;그렇다면..",
"kind": "dialog",
"src": "scn:n0017_scn:39",
"cap": 254
},
{
"id": 3845,
"ko": "`최고의 악몽을;안겨주는 것이;당연하지 않나?",
"kind": "dialog",
"src": "scn:n0017_scn:40",
"cap": 254
},
{
"id": 3846,
"ko": "`아니면;또 이야기 해줄까?",
"kind": "dialog",
"src": "scn:n0017_scn:42",
"cap": 254
},
{
"id": 3847,
"ko": "`누아다를 살리는 법..;이라던가?",
"kind": "dialog",
"src": "scn:n0017_scn:43",
"cap": 254
},
{
"id": 3848,
"ko": "그것 역시.. 그것 역시 너였나?",
"kind": "dialog",
"src": "scn:n0017_scn:44",
"speaker": "루레인",
"cap": 254
},
{
"id": 3849,
"ko": "`잠시나마;즐거운 꿈을 꾸었나?",
"kind": "dialog",
"src": "scn:n0017_scn:45",
"cap": 254
},
{
"id": 3850,
"ko": "꺼져 버려..",
"kind": "dialog",
"src": "scn:n0017_scn:46",
"speaker": "루레인",
"cap": 254
},
{
"id": 3851,
"ko": "`크래드가 가지고 간;크리스탈은;그가 데리고 있는 아이..;엘렌에게 있다.",
"kind": "dialog",
"src": "scn:n0017_scn:47",
"cap": 254
},
{
"id": 3852,
"ko": "`좀 더 발버둥 쳐라.;좀 더.",
"kind": "dialog",
"src": "scn:n0017_scn:48",
"cap": 254
},
{
"id": 3853,
"ko": "`그렇지 않으면..;;널 파멸시키는;즐거움이 없으니까.",
"kind": "dialog",
"src": "scn:n0017_scn:49",
"cap": 254
},
{
"id": 3854,
"ko": "저 자의 말이 진실이라면.. 난..",
"kind": "dialog",
"src": "scn:n0017_scn:50",
"speaker": "루레인",
"cap": 254
},
{
"id": 3855,
"ko": "&매도우힐의 연구소;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:n0017_scn:51",
"cap": 254
},
{
"id": 3856,
"ko": "어서오시오..",
"kind": "dialog",
"src": "scn:n0018_scn:1",
"speaker": "래비",
"cap": 254
},
{
"id": 3857,
"ko": "피차 긴 말은 필요없을터!",
"kind": "dialog",
"src": "scn:n0018_scn:2",
"speaker": "래비",
"cap": 254
},
{
"id": 3858,
"ko": "나의 패배요. 끝을 내시오.",
"kind": "dialog",
"src": "scn:n0018_scn:3",
"speaker": "래비",
"cap": 254
},
{
"id": 3859,
"ko": "..어째, 순순히.. 말하는군요.",
"kind": "dialog",
"src": "scn:n0018_scn:4",
"speaker": "루레인",
"cap": 254
},
{
"id": 3860,
"ko": "오직 이 순간만을 기다려 왔으니까..",
"kind": "dialog",
"src": "scn:n0018_scn:5",
"speaker": "래비",
"cap": 254
},
{
"id": 3861,
"ko": "당신은.. 그렇군요. }배신자{.. 강림자와 고대신 간의 전쟁에서 고대신에게 붙은.. 네베드의 후손이군요?",
"kind": "dialog",
"src": "scn:n0018_scn:6",
"speaker": "루레인",
"cap": 254
},
{
"id": 3862,
"ko": "나에 대해 알고 있나요?",
"kind": "dialog",
"src": "scn:n0018_scn:7",
"speaker": "루레인",
"cap": 254
},
{
"id": 3863,
"ko": "당신과 케프네스에 대해? 물론.",
"kind": "dialog",
"src": "scn:n0018_scn:8",
"speaker": "래비",
"cap": 254
},
{
"id": 3864,
"ko": "내가 이제부터 하려는 일도?",
"kind": "dialog",
"src": "scn:n0018_scn:9",
"speaker": "루레인",
"cap": 254
},
{
"id": 3865,
"ko": "알고 있소.",
"kind": "dialog",
"src": "scn:n0018_scn:10",
"speaker": "래비",
"cap": 254
},
{
"id": 3866,
"ko": "가능하다고 생각하나요?",
"kind": "dialog",
"src": "scn:n0018_scn:11",
"speaker": "루레인",
"cap": 254
},
{
"id": 3867,
"ko": "모르겠소.",
"kind": "dialog",
"src": "scn:n0018_scn:12",
"speaker": "래비",
"cap": 254
},
{
"id": 3868,
"ko": "무슨 짓이오!",
"kind": "dialog",
"src": "scn:n0018_scn:13",
"speaker": "래비",
"cap": 254
},
{
"id": 3869,
"ko": "죽는 것이 당신의 소원이라면, 난 그걸 들어주지 않겠어요.",
"kind": "dialog",
"src": "scn:n0018_scn:14",
"speaker": "루레인",
"cap": 254
},
{
"id": 3870,
"ko": "하나도 변하지 않았군..",
"kind": "dialog",
"src": "scn:n0018_scn:15",
"speaker": "래비",
"cap": 254
},
{
"id": 3871,
"ko": "크래드의 말을 믿고 왔나?",
"kind": "dialog",
"src": "scn:n0018_scn:16",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3872,
"ko": "어리석군.",
"kind": "dialog",
"src": "scn:n0018_scn:17",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3873,
"ko": "왜 이런 일을 하는거죠? 당신은.. 어째서?",
"kind": "dialog",
"src": "scn:n0018_scn:18",
"speaker": "루레인",
"cap": 254
},
{
"id": 3874,
"ko": "할 수 있으니까.",
"kind": "dialog",
"src": "scn:n0018_scn:19",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3875,
"ko": ".. 네?",
"kind": "dialog",
"src": "scn:n0018_scn:20",
"speaker": "루레인",
"cap": 254
},
{
"id": 3876,
"ko": "이것이 나의 }존재 목적{이고 }이유{니까. 내가 세상을 멸망시킬 수 있으니까. 그래서 하는 것 뿐이지.",
"kind": "dialog",
"src": "scn:n0018_scn:21",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3877,
"ko": "너는 숨을 쉬면서 네가 왜 숨을 쉬는지 그 이유를 생각하나?",
"kind": "dialog",
"src": "scn:n0018_scn:22",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3878,
"ko": "먹이를 먹으며 그 이유를 생각하나? 아니. 그럴 수 있으니까 그러는 것 뿐이야.",
"kind": "dialog",
"src": "scn:n0018_scn:23",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3879,
"ko": "내가 욕망하는 것은 오히려.. 네게 }절망{을 알려주는 거지..",
"kind": "dialog",
"src": "scn:n0018_scn:24",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3880,
"ko": "널 죽 보고 있었다. 네가 노덴스와 누아다의 손에서 자라는 것을.",
"kind": "dialog",
"src": "scn:n0018_scn:25",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3881,
"ko": "남에게 따뜻한 마음을 주면 그 보답을 받을 수 있다고 생각하며 자라나는 것을.",
"kind": "dialog",
"src": "scn:n0018_scn:26",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3882,
"ko": "네가? 나와 마찬가지로 }절망의 파편{인 네가? 그럴 수 있다고? 아니.",
"kind": "dialog",
"src": "scn:n0018_scn:27",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3883,
"ko": "너는 나처럼 }재앙의 신{이야. 너와 관계된 모든 자는 죽었지. 그렇지만 너는 왜 포기하지 않지?",
"kind": "dialog",
"src": "scn:n0018_scn:28",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3884,
"ko": "아직도 내가 빼앗지 않은 것이 남았나?",
"kind": "dialog",
"src": "scn:n0018_scn:29",
"speaker": "케프네스",
"cap": 254
},
{
"id": 3885,
"ko": "당신이 나와.. 한 때는 같은 존재였다는 것. 역시 믿지 못하겠어요.",
"kind": "dialog",
"src": "scn:n0018_scn:30",
"speaker": "루레인",
"cap": 254
},
{
"id": 3886,
"ko": "당신의 존재 그 자체를 부정해 드리죠. 내 모든 것을 걸고!",
"kind": "dialog",
"src": "scn:n0018_scn:31",
"speaker": "루레인",
"cap": 254
},
{
"id": 3887,
"ko": "`가능할까?;네가 나를 집어 삼키는 것이 가능할까?;",
"kind": "dialog",
"src": "scn:n0018_scn:32",
"cap": 254
},
{
"id": 3888,
"ko": "`네 십 칠년의 인생이,; 나의,; 우리의...",
"kind": "dialog",
"src": "scn:n0018_scn:33",
"cap": 254
},
{
"id": 3889,
"ko": "`천년 동안의 기다림보다;가치가 있다는 거냐?",
"kind": "dialog",
"src": "scn:n0018_scn:34",
"cap": 254
},
{
"id": 3890,
"ko": "`내 증오를;다 집어 삼킬 수 있을까?;증명해 봐라!",
"kind": "dialog",
"src": "scn:n0018_scn:35",
"cap": 254
},
{
"id": 3891,
"ko": "`네베드를 증오..해라",
"kind": "dialog",
"src": "scn:n0018_scn:36",
"cap": 254
},
{
"id": 3892,
"ko": "`강림자들을 증오..해라",
"kind": "dialog",
"src": "scn:n0018_scn:37",
"cap": 254
},
{
"id": 3893,
"ko": "`우리에게서;이 세계를 빼앗은 그들을;저주..해라",
"kind": "dialog",
"src": "scn:n0018_scn:38",
"cap": 254
},
{
"id": 3894,
"ko": "`인간들을 저주해라..;저주한다",
"kind": "dialog",
"src": "scn:n0018_scn:39",
"cap": 254
},
{
"id": 3895,
"ko": "`인간들이 내게 한 짓을;증오해라.. 증오한다",
"kind": "dialog",
"src": "scn:n0018_scn:40",
"cap": 254
},
{
"id": 3896,
"ko": "`그만, 그만, 그만.;아파.. 아파요.;제발.",
"kind": "dialog",
"src": "scn:n0018_scn:41",
"cap": 254
},
{
"id": 3897,
"ko": "`이 재생력을 봐.",
"kind": "dialog",
"src": "scn:n0018_scn:42",
"cap": 254
},
{
"id": 3898,
"ko": "`어디까지 분열하는 걸까?",
"kind": "dialog",
"src": "scn:n0018_scn:43",
"cap": 254
},
{
"id": 3899,
"ko": "`이봐, 그만 둬.",
"kind": "dialog",
"src": "scn:n0018_scn:44",
"cap": 254
},
{
"id": 3900,
"ko": "`뭐 어때.;어차피 죽지도 않는걸.",
"kind": "dialog",
"src": "scn:n0018_scn:45",
"cap": 254
},
{
"id": 3901,
"ko": "`인간도 아니잖아?",
"kind": "dialog",
"src": "scn:n0018_scn:46",
"cap": 254
},
{
"id": 3902,
"ko": "그만.. 그만.. 그만!",
"kind": "dialog",
"src": "scn:n0018_scn:47",
"speaker": "루레인",
"cap": 254
},
{
"id": 3903,
"ko": "`머리가 아프다.",
"kind": "dialog",
"src": "scn:n0018_scn:48",
"cap": 254
},
{
"id": 3904,
"ko": "`머리 속에 울리는 건;오직 증오하라. 저주하라.",
"kind": "dialog",
"src": "scn:n0018_scn:49",
"cap": 254
},
{
"id": 3905,
"ko": "`고통의 기억들..;그가 당한..;아니 내가 당한..",
"kind": "dialog",
"src": "scn:n0018_scn:50",
"cap": 254
},
{
"id": 3906,
"ko": "지지 말아요.",
"kind": "dialog",
"src": "scn:n0018_scn:51",
"speaker": "???",
"cap": 254
},
{
"id": 3907,
"ko": "이 목소리..는?",
"kind": "dialog",
"src": "scn:n0018_scn:52",
"speaker": "루레인",
"cap": 254
},
{
"id": 3908,
"ko": "잊지 말아요.",
"kind": "dialog",
"src": "scn:n0018_scn:53",
"speaker": "엘렌",
"cap": 254
},
{
"id": 3909,
"ko": "지면.. 언니가 케프네스에게 먹히면.. 언니는 나를 잊게 돼요. 나만이 아니라, 노덴스 아저씨도, 누아다 오빠도, 브레스 할아버지도, 디어드리 언니도..",
"kind": "dialog",
"src": "scn:n0018_scn:54",
"speaker": "엘렌",
"cap": 254
},
{
"id": 3910,
"ko": "지지말아요. 잊지 말아요.",
"kind": "dialog",
"src": "scn:n0018_scn:55",
"speaker": "엘렌",
"cap": 254
},
{
"id": 3911,
"ko": ".. 응.",
"kind": "dialog",
"src": "scn:n0018_scn:56",
"speaker": "루레인",
"cap": 254
},
{
"id": 3912,
"ko": "기억해.. 아버지가 너의 손에 죽은 걸. 오라버니의 죽음도, 장로님의 죽음도.. 디어드리의 죽음도..",
"kind": "dialog",
"src": "scn:n0018_scn:57",
"speaker": "루레인",
"cap": 254
},
{
"id": 3913,
"ko": "이 슬픔도, 이 괴로움도, 이 고통도,... 전부 }나의 것{이야. 이 기억들은 모두 너의 쓸모없는 증오보다 }가치있어.{",
"kind": "dialog",
"src": "scn:n0018_scn:58",
"speaker": "루레인",
"cap": 254
},
{
"id": 3914,
"ko": "털끝만큼도.. 네게 주지는 않아!",
"kind": "dialog",
"src": "scn:n0018_scn:59",
"speaker": "루레인",
"cap": 254
},
{
"id": 3915,
"ko": "인간 놈들, 여기까지..!!",
"kind": "dialog",
"src": "scn:n0020_scn:1",
"speaker": "병사",
"cap": 254
},
{
"id": 3916,
"ko": "섬 전체에 결계... 역시 아버님은 스케일이 크시다니까..",
"kind": "dialog",
"src": "scn:n0020_scn:2",
"speaker": "루레인",
"cap": 254
},
{
"id": 3917,
"ko": "일단 한시름 놓은거 같은데.. 돌아갈까.",
"kind": "dialog",
"src": "scn:n0020_scn:3",
"speaker": "루레인",
"cap": 254
},
{
"id": 3918,
"ko": "아냐, 반대쪽.. <선착장{으로 가는 길을 열어야 해.",
"kind": "dialog",
"src": "scn:n0022_scn:1",
"speaker": "루레인",
"cap": 254
},
{
"id": 3919,
"ko": "뒤를 조심해. 아직 신전에 그 놈이 남아있어.",
"kind": "dialog",
"src": "scn:n0022_scn:2",
"speaker": "루레인",
"cap": 254
},
{
"id": 3920,
"ko": "마력이 부족해서 치료는 못하지만...",
"kind": "dialog",
"src": "scn:n0022_scn:3",
"speaker": "디어드리",
"cap": 254
},
{
"id": 3921,
"ko": "서두르자. 혹시 급하게 필요한 게 있으면 말해.",
"kind": "dialog",
"src": "scn:n0022_scn:4",
"speaker": "디어드리",
"cap": 254
},
{
"id": 3922,
"ko": "마력을 좀 더 축적해 놨으면 신수로 변신해 도와드릴 수 있을 텐데..",
"kind": "dialog",
"src": "scn:n0022_scn:5",
"speaker": "병사",
"cap": 254
},
{
"id": 3923,
"ko": "신전에서 놈이 나오는지만 감시해 주세요.",
"kind": "dialog",
"src": "scn:n0022_scn:6",
"speaker": "루레인",
"cap": 254
},
{
"id": 3924,
"ko": "인간들한테 빼앗은 겁니다. 마법이 부족한 상황에서는 이거라도..",
"kind": "dialog",
"src": "scn:n0022_scn:7",
"speaker": "병사",
"cap": 254
},
{
"id": 3925,
"ko": "죄송합니다.. 이럴 때에 마력이 바닥나다니..",
"kind": "dialog",
"src": "scn:n0022_scn:8",
"speaker": "병사",
"cap": 254
},
{
"id": 3926,
"ko": "신경쓰지 말아요.",
"kind": "dialog",
"src": "scn:n0022_scn:9",
"speaker": "루레인",
"cap": 254
},
{
"id": 3927,
"ko": "이거라도 도움이 되었으면 좋겠네요.",
"kind": "dialog",
"src": "scn:n0022_scn:10",
"speaker": "병사",
"cap": 254
},
{
"id": 3928,
"ko": "&활로 1;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:n0022_scn:11",
"cap": 254
},
{
"id": 3929,
"ko": "이 앞은 세이브를 할 수 없는 지역입니다. 계속하시겠습니까?",
"kind": "dialog",
"src": "scn:n0023_scn:1",
"cap": 254
},
{
"id": 3930,
"ko": "조금만 더가면..!",
"kind": "dialog",
"src": "scn:n0023_scn:9",
"speaker": "루레인",
"cap": 254
},
{
"id": 3931,
"ko": "&활로 2;$...........{퀘스트 입수!",
"kind": "dialog",
"src": "scn:n0023_scn:10",
"cap": 254
},
{
"id": 3932,
"ko": "&활로 2;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:n0023_scn:11",
"cap": 254
},
{
"id": 3933,
"ko": "|(성지는.. 이미 인간들에게 장악당한거야. 후퇴하는 것만 생각하자.)",
"kind": "dialog",
"src": "scn:n0024_scn:1",
"speaker": "루레인",
"cap": 254
},
{
"id": 3934,
"ko": "일단 도주로는 확보되어서 다행입니다..",
"kind": "dialog",
"src": "scn:n0024_scn:2",
"speaker": "병사",
"cap": 254
},
{
"id": 3935,
"ko": "우리들의 성지가 이런 식으로 함락될 줄은..",
"kind": "dialog",
"src": "scn:n0024_scn:3",
"speaker": "병사",
"cap": 254
},
{
"id": 3936,
"ko": "}일계급 특진{하고 }특제 강화복{을 받은 이 ^그<라'함{님이 있는 한 지나가지 못하시지 말입니다!",
"kind": "dialog",
"src": "scn:n0024_scn:4",
"speaker": "그라함",
"cap": 254
},
{
"id": 3937,
"ko": "&활로 3;$...........{퀘스트 입수!",
"kind": "dialog",
"src": "scn:n0024_scn:5",
"cap": 254
},
{
"id": 3938,
"ko": "헉.",
"kind": "dialog",
"src": "scn:n0024_scn:6",
"speaker": "그라함",
"cap": 254
},
{
"id": 3939,
"ko": "^강<화}복{이 지네.",
"kind": "dialog",
"src": "scn:n0024_scn:7",
"speaker": "그라함",
"cap": 254
},
{
"id": 3940,
"ko": "살려주세요 대장!",
"kind": "dialog",
"src": "scn:n0024_scn:8",
"speaker": "그라함",
"cap": 254
},
{
"id": 3941,
"ko": "하여간 네 놈은.. 일생에 도움이 안되는구나.",
"kind": "dialog",
"src": "scn:n0024_scn:9",
"speaker": "???",
"cap": 254
},
{
"id": 3942,
"ko": "갈 길이 바쁘지만 잠깐 어울려 주도록 할까?",
"kind": "dialog",
"src": "scn:n0024_scn:10",
"speaker": "???",
"cap": 254
},
{
"id": 3943,
"ko": "제법인데.. 아직 이런 인물이 남아 있을 줄이야..",
"kind": "dialog",
"src": "scn:n0024_scn:11",
"speaker": "???",
"cap": 254
},
{
"id": 3944,
"ko": "남은 병력을 탈출시키려는 건가?",
"kind": "dialog",
"src": "scn:n0024_scn:12",
"speaker": "???",
"cap": 254
},
{
"id": 3945,
"ko": "가라.",
"kind": "dialog",
"src": "scn:n0024_scn:13",
"speaker": "???",
"cap": 254
},
{
"id": 3946,
"ko": "..무슨 생각이죠?",
"kind": "dialog",
"src": "scn:n0024_scn:14",
"speaker": "루레인",
"cap": 254
},
{
"id": 3947,
"ko": "}바쁜 일{이 있어서 끝까지 상대해줄 수가 없군.",
"kind": "dialog",
"src": "scn:n0024_scn:15",
"speaker": "???",
"cap": 254
},
{
"id": 3948,
"ko": "가지 않을건가? 그렇다고 해도 나는 상관 없지만.",
"kind": "dialog",
"src": "scn:n0024_scn:16",
"speaker": "???",
"cap": 254
},
{
"id": 3949,
"ko": "`(뭘 우물쭈물 거리고 있는거지? 그냥 확 쳐버릴까? 뒤에 따라오는 사람을 공격할 거라고 걱정하는 건가?)",
"kind": "dialog",
"src": "scn:n0024_scn:17",
"speaker": "???",
"cap": 254
},
{
"id": 3950,
"ko": "`(제길, 더 시간을 끌면 케프네스가 캐스팅 중인 시간을 노릴 수 없는데..)",
"kind": "dialog",
"src": "scn:n0024_scn:18",
"speaker": "???",
"cap": 254
},
{
"id": 3951,
"ko": "|(뭐라는 거지..?)",
"kind": "dialog",
"src": "scn:n0024_scn:19",
"speaker": "루레인",
"cap": 254
},
{
"id": 3952,
"ko": "흠.. 지켜야 할 사람이라. 피차 지금은 싸워야 할 때가 아니군.",
"kind": "dialog",
"src": "scn:n0024_scn:20",
"speaker": "???",
"cap": 254
},
{
"id": 3953,
"ko": "어? 어? 기다려요! 날 버리고 가지 마세요!",
"kind": "dialog",
"src": "scn:n0024_scn:21",
"speaker": "그라함",
"cap": 254
},
{
"id": 3954,
"ko": "|(뭐지, 저 남자는...)",
"kind": "dialog",
"src": "scn:n0024_scn:22",
"speaker": "루레인",
"cap": 254
},
{
"id": 3955,
"ko": "&활로 3;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:n0024_scn:23",
"cap": 254
},
{
"id": 3956,
"ko": "이제 어떻게 하지?",
"kind": "dialog",
"src": "scn:n0024_scn:24",
"speaker": "디어드리",
"cap": 254
},
{
"id": 3957,
"ko": "인간들의 <배{를 빼앗아야겠어. 여기서 기다리고 있어.",
"kind": "dialog",
"src": "scn:n0024_scn:25",
"speaker": "루레인",
"cap": 254
},
{
"id": 3958,
"ko": "하지만..",
"kind": "dialog",
"src": "scn:n0024_scn:26",
"speaker": "디어드리",
"cap": 254
},
{
"id": 3959,
"ko": "마법이 완전히 사라진 것은 아니니까.. 가까운 배까지는 갈 수 있을 거야.",
"kind": "dialog",
"src": "scn:n0024_scn:27",
"speaker": "루레인",
"cap": 254
},
{
"id": 3960,
"ko": "조심해.",
"kind": "dialog",
"src": "scn:n0024_scn:28",
"speaker": "디어드리",
"cap": 254
},
{
"id": 3962,
"ko": "그래도 루레인님이 계셔서 다행입니다..",
"kind": "dialog",
"src": "scn:n0025_scn:1",
"speaker": "병사",
"cap": 254
},
{
"id": 3963,
"ko": "인간들... 정말 갈데까지 가보자는 거로군요..",
"kind": "dialog",
"src": "scn:n0025_scn:2",
"speaker": "병사",
"cap": 254
},
{
"id": 3964,
"ko": "선주종! 어떻게 여기까지!",
"kind": "dialog",
"src": "scn:n0025_scn:3",
"speaker": "병사",
"cap": 254
},
{
"id": 3965,
"ko": "&선박 탈취;$...........{퀘스트 입수!",
"kind": "dialog",
"src": "scn:n0025_scn:4",
"cap": 254
},
{
"id": 3966,
"ko": "그만, 그만! 항복하겠어! 죽이지 마!",
"kind": "dialog",
"src": "scn:n0025_scn:5",
"speaker": "병사",
"cap": 254
},
{
"id": 3967,
"ko": "배를 선착장에 대세요.",
"kind": "dialog",
"src": "scn:n0025_scn:6",
"speaker": "루레인",
"cap": 254
},
{
"id": 3968,
"ko": "시키는대로 할 테니..",
"kind": "dialog",
"src": "scn:n0025_scn:7",
"speaker": "병사",
"cap": 254
},
{
"id": 3969,
"ko": "&선박 탈취;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:n0025_scn:8",
"cap": 254
},
{
"id": 3970,
"ko": "어떻게 빠져나오기는 했네.",
"kind": "dialog",
"src": "scn:n0025_scn:9",
"speaker": "디어드리",
"cap": 254
},
{
"id": 3971,
"ko": "그런데, 어디로 가는 거야? }검은 바위 섬?{",
"kind": "dialog",
"src": "scn:n0025_scn:10",
"speaker": "디어드리",
"cap": 254
},
{
"id": 3972,
"ko": "}아눈 섬{으로.. 검은 바위 섬은 좀 더 버틸 수 있을 거야. 우선 }브레스 장로님{한테 이 일을..",
"kind": "dialog",
"src": "scn:n0025_scn:11",
"speaker": "루레인",
"cap": 254
},
{
"id": 3973,
"ko": "}아버님{의.. }성지{의.. 일을..",
"kind": "dialog",
"src": "scn:n0025_scn:12",
"speaker": "루레인",
"cap": 254
},
{
"id": 3974,
"ko": "루레인.. 괜찮아?",
"kind": "dialog",
"src": "scn:n0025_scn:13",
"speaker": "디어드리",
"cap": 254
},
{
"id": 3975,
"ko": "난.. 아버님을 지키지 못했어..",
"kind": "dialog",
"src": "scn:n0025_scn:14",
"speaker": "루레인",
"cap": 254
},
{
"id": 3976,
"ko": "^복수.. 복수를 해야 해.",
"kind": "dialog",
"src": "scn:n0025_scn:15",
"speaker": "루레인",
"cap": 254
},
{
"id": 3977,
"ko": "아까, 이제 너 밖에 믿을 사람이 없다고 했잖아. 노덴스 아저씨도, 그렇게 말했지? 틀림없이.",
"kind": "dialog",
"src": "scn:n0025_scn:16",
"speaker": "디어드리",
"cap": 254
},
{
"id": 3978,
"ko": "<수호자{의 직위를 이어받고 <브레스 장로님{의 도움을 받으라고.. 하셨어.",
"kind": "dialog",
"src": "scn:n0025_scn:17",
"speaker": "루레인",
"cap": 254
},
{
"id": 3979,
"ko": "네 심정은 이해해. 나도, 아빠한테 무슨 일이 생긴다면... 그러니까 난 복수를 말리지는않을 거야.",
"kind": "dialog",
"src": "scn:n0025_scn:18",
"speaker": "디어드리",
"cap": 254
},
{
"id": 3980,
"ko": "하지만, 복수를 말리지는 않지만.. 그러기 위해서 널 내팽겨치지마. 좀 더 소중하게 생각해. 그리고 신중하게 행동해 줘.",
"kind": "dialog",
"src": "scn:n0025_scn:19",
"speaker": "디어드리",
"cap": 254
},
{
"id": 3981,
"ko": "나나, 우리 아빠나, 아니면 다른 모든 사람들이 죽는다면 복수를 해도 무슨 소용이야?",
"kind": "dialog",
"src": "scn:n0025_scn:20",
"speaker": "디어드리",
"cap": 254
},
{
"id": 3982,
"ko": "아저씨도 그런 걸 바라지는 않으셨을 거야. 그래서 너한테.. <수호자{가 되라고 한 게 아닐까?",
"kind": "dialog",
"src": "scn:n0025_scn:21",
"speaker": "디어드리",
"cap": 254
},
{
"id": 3983,
"ko": "}자신이 못다한 일{을 네가 해주길 바랬던 거야. 틀림없이.",
"kind": "dialog",
"src": "scn:n0025_scn:22",
"speaker": "디어드리",
"cap": 254
},
{
"id": 3984,
"ko": "부디 그 기대를 져버리지 마.",
"kind": "dialog",
"src": "scn:n0025_scn:23",
"speaker": "디어드리",
"cap": 254
},
{
"id": 3985,
"ko": "나는.. 그럴 능력이 없어. 자신도 없고.",
"kind": "dialog",
"src": "scn:n0025_scn:24",
"speaker": "루레인",
"cap": 254
},
{
"id": 3986,
"ko": "걱정마. 내가 도와줄게. 난 네 편이니까.",
"kind": "dialog",
"src": "scn:n0025_scn:25",
"speaker": "디어드리",
"cap": 254
},
{
"id": 3987,
"ko": "무슨 일이 있어도! 말야.",
"kind": "dialog",
"src": "scn:n0025_scn:26",
"speaker": "디어드리",
"cap": 254
},
{
"id": 3988,
"ko": "&탈주;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:n0025_scn:27",
"cap": 254
},
{
"id": 3991,
"ko": "이쪽은 인간들의 주둔지야, 위험해.",
"kind": "dialog",
"src": "scn:n0029_scn:1",
"speaker": "루레인",
"cap": 254
},
{
"id": 3992,
"ko": "이런 곳까지 와서...",
"kind": "dialog",
"src": "scn:n0029_scn:2",
"speaker": "루레인",
"cap": 254
},
{
"id": 3993,
"ko": "유품... 이것만이라도 전해주자...",
"kind": "dialog",
"src": "scn:n0029_scn:3",
"speaker": "루레인",
"cap": 254
},
{
"id": 3994,
"ko": "&유품;$...........{퀘스트 입수!",
"kind": "dialog",
"src": "scn:n0029_scn:4",
"cap": 254
},
{
"id": 3996,
"ko": "처음 보는 동굴인데.. 호기심에 시간을 뺏기지 말자.",
"kind": "dialog",
"src": "scn:n0030_scn:1",
"speaker": "루레인",
"cap": 254
},
{
"id": 3997,
"ko": "인간들의 방어 기계들은 그렇다치고..",
"kind": "dialog",
"src": "scn:n0030_scn:2",
"speaker": "루레인",
"cap": 254
},
{
"id": 3998,
"ko": "처음 보는 몬스터들이 있는데.. 저건 뭐지..?",
"kind": "dialog",
"src": "scn:n0030_scn:3",
"speaker": "루레인",
"cap": 254
},
{
"id": 4000,
"ko": "&특별한 것이 없다.",
"kind": "dialog",
"src": "scn:n0031_scn:1",
"cap": 254
},
{
"id": 4001,
"ko": "`... 시... 에... 네... .. 드...",
"kind": "dialog",
"src": "scn:n0031_scn:2",
"speaker": "???",
"cap": 254
},
{
"id": 4002,
"ko": "`... 케.. 를.... 솔... .. 배... .. 신..",
"kind": "dialog",
"src": "scn:n0031_scn:3",
"speaker": "???",
"cap": 254
},
{
"id": 4003,
"ko": "말을 한다..? 뭐라고 하는지는 모르겠지만...",
"kind": "dialog",
"src": "scn:n0031_scn:4",
"speaker": "루레인",
"cap": 254
},
{
"id": 4004,
"ko": "`증.. 오... .. 주.. 죽인...!",
"kind": "dialog",
"src": "scn:n0031_scn:5",
"speaker": "???",
"cap": 254
},
{
"id": 4005,
"ko": "뭐 이래.. 나쁜 단어만 제대로 들리네..",
"kind": "dialog",
"src": "scn:n0031_scn:6",
"speaker": "루레인",
"cap": 254
},
{
"id": 4006,
"ko": "&괴물들;$...........{퀘스트 입수!",
"kind": "dialog",
"src": "scn:n0031_scn:7",
"cap": 254
},
{
"id": 4007,
"ko": "아무래도 이 괴물들에게 }습격{을 받은 것 같은데..",
"kind": "dialog",
"src": "scn:n0031_scn:8",
"speaker": "루레인",
"cap": 254
},
{
"id": 4008,
"ko": "}시체{가 없어... 도망친걸까? 아니면... 어디론가 잡혀간 건가?",
"kind": "dialog",
"src": "scn:n0031_scn:9",
"speaker": "루레인",
"cap": 254
},
{
"id": 4009,
"ko": "이대로 돌아갈 수는 없어.",
"kind": "dialog",
"src": "scn:n0031_scn:10",
"speaker": "루레인",
"cap": 254
},
{
"id": 4010,
"ko": "<막사{들을 <조사{해 보자... 뭔가 단서가 남아 있을지도...",
"kind": "dialog",
"src": "scn:n0031_scn:11",
"speaker": "루레인",
"cap": 254
},
{
"id": 4011,
"ko": "&괴물들;$...........{퀘스트 완료!",
"kind": "dialog",
"src": "scn:n0031_scn:12",
"cap": 254
},
{
"id": 4012,
"ko": "&사라진 병사들;$...........{퀘스트 입수!",
"kind": "dialog",
"src": "scn:n0031_scn:13",
"cap": 254
},
{
"id": 4013,
"ko": "&흔적들;$...........{퀘스트 입수!",
"kind": "dialog",
"src": "scn:n0031_scn:14",
"cap": 254
},
{
"id": 4014,
"ko": "&찢어진 일지가;흩어져 있다.",
"kind": "dialog",
"src": "scn:n0031_scn:15",
"cap": 254
},
{
"id": 4015,
"ko": "998년 적의 달, 10일",
"kind": "dialog",
"src": "scn:n0031_scn:16",
"cap": 254
},
{
"id": 4016,
"ko": "인간들이 주둔지 앞에;거점을 설치했다.",
"kind": "dialog",
"src": "scn:n0031_scn:17",
"cap": 254
},
{
"id": 4017,
"ko": "뭘 하나 했더니;거기 있는 동굴을;하나 파내고 있었다.",
"kind": "dialog",
"src": "scn:n0031_scn:18",
"cap": 254
},
{
"id": 4018,
"ko": "정찰대를 보내봤으나;돌아오지 않는다.",
"kind": "dialog",
"src": "scn:n0031_scn:19",
"cap": 254
},
{
"id": 4019,
"ko": "동굴.. 올 때 봤던 그 곳인가? 하지만 인간 병사들은 없었는데..",
"kind": "dialog",
