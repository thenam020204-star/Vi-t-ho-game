/* Bảng "bật dần" state -> hàm Paint/Touch/Move mới (X-macro; KHÔNG con trỏ => không relocation):
 *   MUI_STATE(LỚP, tên, điều_kiện(self), paint, touch, move)
 *   - Lớp (GAME/POPUP/INGAME/NPC/MAIN/EXPERT/MAP/CASH) chưa có dòng nào => inject_menu.py KHÔNG vá ô vtable của lớp đó (đường gốc y hệt).
 *   - Lớp có dòng: ô Paint/TouchPressed/TouchMoved/TouchReleased -> thunk (dispatch.c); nếu không dòng nào khớp điều kiện => gọi hàm gốc.
 *   - Dòng khớp đầu tiên (theo thứ tự file) thắng. paint: void f(void*self); touch/move: int f(void*self,int x,int y).
 *   - c1..c7 thêm dòng ở đây (và file .c của gói). Gói chưa làm thì không có dòng.
 * Bản harness (-DMUI_DEBUG): thêm một dòng chỉ dùng cờ mui_flags&MUI_F_DBG (trang widget thử, gắn vào StateMainMenu vì tới được sau ~100 khung harness; bản phát hành KHÔNG có dòng này. */
/* T17c1: InGameMenu lưới 3x3 (0), Nhân vật (1), Hệ thống (9); popup chung loại 1-3 (1-2 nút) và 7 (menu dọc) */
MUI_STATE(INGAME, ig, (GS(self) == 0 || GS(self) == 1 || GS(self) == 2 || GS(self) == 3 || GS(self) == 6 || GS(self) == 9), ig_paint, ig_touch, ig_move)
MUI_STATE(POPUP, pop, ((POP_TYPE(self) >= 1 && POP_TYPE(self) <= 3 && POP_NBTN(self) >= 1 && POP_NBTN(self) <= 2) || (POP_TYPE(self) == 7 && POP_NBTN(self) >= 1 && POP_NBTN(self) <= 6) || (POP_TYPE(self) == 10 && *(u8 **)((u8 *)(self) + 0x814))), pop_paint, pop_touch, ig_move)
/* T17c3b: Đặc tính (InGameMenu tab 5) */
MUI_STATE(INGAME, prop, (GS(self) == 5), prop_paint, prop_touch, prop_move)
/* T17c3c: Kỹ năng (state 4): sub 0 chọn tab con, 1..5 lưới, 6 chọn ô nhanh; sub 7..10 (mua/ghép sách) giữ đường gốc */
MUI_STATE(INGAME, sk, (GS(self) == 4 && *((s8 *)(self) + 0xd) >= 0 && *((s8 *)(self) + 0xd) <= 6), sk_paint, sk_touch, sk_move)
/* L1/T17c6: Cash shop (state 0) */
MUI_STATE(CASH, cash, (GS(self) == 0), cash_paint, cash_touch, cash_move)
/* L2/T17c5: NPC (StateInNpcMenu [this+0xe]): 0 mua kỹ năng, 1 mua vật phẩm, 2 bán; popup NPC = StatePopup loại 4 có cha là NPC */
MUI_STATE(NPC, npc, ((*((s8 *)(self) + 0xe) >= 0 && *((s8 *)(self) + 0xe) <= 6) || (*((s8 *)(self) + 0xe) == 7 && *((s8 *)(self) + 0xf) >= 0 && *((s8 *)(self) + 0xf) <= 8)), npc_paint, npc_touch, npc_move)
MUI_STATE(POPUP, npcpop, (NPC_POPUP(self) && POP_NBTN(self) >= 1 && POP_NBTN(self) <= 2), npcpop_paint, npcpop_touch, ig_move)
MUI_STATE(POPUP, qty, (NPC_POPUP5(self) && POP_NBTN(self) >= 1 && POP_NBTN(self) <= 2), qty_paint, qty_touch, ig_move)
/* L1/T17c4: Tinh linh (InGameMenu state 7): sub 0 tab con, 1 ô trang bị, 2 bộ lọc, 3 kỹ năng; sub 4 giữ đường gốc */
MUI_STATE(INGAME, spirit, (GS(self) == 7 && *((s8 *)(self) + 0xd) >= 0 && *((s8 *)(self) + 0xd) <= 3), spirit_paint, spirit_touch, spirit_move)
/* L1/T17c6: popup StateGame: 1 = hồi sinh Có/Không, 4 = hồi sinh thành công (Paint gốc rồi popup đè) */
MUI_STATE(GAME, gpop, (GS(self) == 1 || GS(self) == 4), gpop_paint, gpop_touch, gpop_move)
/* L1/T17c4: Nhiệm vụ (InGameMenu state 8): sub 0 tab con, 1 danh sách, 2 cây nhánh, 3 chi tiết; sub 4 (phần thưởng) và 5/6 (bản đồ) giữ đường gốc */
MUI_STATE(INGAME, quest, (GS(self) == 8 && *((s8 *)(self) + 0xd) >= 0 && *((s8 *)(self) + 0xd) <= 3), quest_paint, quest_touch, quest_move)
/* L1/T17c6: Chuyên gia (StateInExpertMenu): state 0 chuẩn bị, 1 cửa hàng */
MUI_STATE(EXPERT, expert, (GS(self) == 0 || GS(self) == 1), expert_paint, expert_touch, expert_move)
/* L1/T17c6: popup của Chuyên gia (StatePopup cha = StateInExpertMenu): loại 4 Có/Không + loại 5 nhập số lượng, dùng widget npcpop/qty (npc.c) */
MUI_STATE(POPUP, expop, (EXPERT_POPUP(self, 4) && POP_NBTN(self) >= 1 && POP_NBTN(self) <= 2), npcpop_paint, npcpop_touch, ig_move)
MUI_STATE(POPUP, expqty, (EXPERT_POPUP(self, 5) && POP_NBTN(self) >= 1 && POP_NBTN(self) <= 2), qty_paint, qty_touch, ig_move)
/* L1/T17c6: StateGame state 2 (Expert) sub 1 hộp thắng/thua, sub 2 bảng kết quả; sub 0 (biểu ngữ ảnh) giữ gốc */
MUI_STATE(GAME, gres, (GS(self) == 2 && *((s8 *)(self) + 0xd) >= 1 && *((s8 *)(self) + 0xd) <= 2), gres_paint, gpop_touch, gpop_move)
/* T16: hội thoại cốt truyện/NPC (StateGame state 0 khi [EventProc+0x75] != 0): Paint = Paint gốc (khung thoại vẽ bằng điểm móc hooks.def/dialog.c); chạm: nút Bỏ qua -> KeyPressed(35), chạm khác -> KeyPressed(-5) */
MUI_STATE(GAME, dlg, (GS(self) == 0 && *(u8 **)(gv + 5204) && *(*(u8 **)(gv + 5204) + 0x75)), dlg_paint, dlg_touch, dlg_move)
/* T14b: HUD chiến đấu mới (StateGame state 0, không hội thoại): Paint gốc + nút mới; chạm dịch về nút gốc; nhấn giữ nút tạm dừng = sửa bố cục (hud.c) */
MUI_STATE(GAME, hud, (GS(self) == 0), hud_paint, hud_touch, hud_move)
/* L3/T17c7: MainMenu: state 4 lưới 6 ô; 5 sub 0 slot / sub 1 lớp; 6 sub 0 Chuyên Gia = chọn slot; 9 sub 0 Cài đặt (10 mục); popup lớp = StatePopup loại 8 (cha MainMenu). State 2/3 (logo/tiêu đề), 10/11/12 (Thành tựu/Trợ giúp/Hỗ trợ), 0/1/7/8 (mạng), Cài đặt sub 1: đường gốc. */
MUI_STATE(MAIN, mm4, (GS(self) == 4), mm_grid_paint, mm_touch, mm_move)
MUI_STATE(MAIN, mm5a, (GS(self) == 5 && *((s8 *)(self) + 0xd) == 0), mm_slot_paint, mm_touch, mm_move)
MUI_STATE(MAIN, mm5b, (GS(self) == 5 && *((s8 *)(self) + 0xd) == 1), mm_class_paint, mm_touch, mm_move)
MUI_STATE(MAIN, mm6, (GS(self) == 6 && *((s8 *)(self) + 0xd) == 0), mm_slot_paint, mm_touch, mm_move)
MUI_STATE(MAIN, mm9, (GS(self) == 9 && *((s8 *)(self) + 0xd) == 0), mm_option_paint, mm_touch, mm_move)
MUI_STATE(POPUP, mmpop, (MAIN_POPUP8(self) && POP_NBTN(self) == 2), mmpop_paint, mmpop_touch, mmpop_move)
/* L1b/T17c8: StateMap: chế độ 0 bản đồ lớn / 1 khu vực (ctor tham số 1 = [+0xd]==1 chỉ vẽ ảnh: giữ đường gốc) */
MUI_STATE(MAP, map, ((GS(self) == 0 || GS(self) == 1) && *((s8 *)(self) + 0xd) == 0), map_paint, map_touch, map_move)
#ifdef MUI_DEBUG
MUI_STATE(MAIN, dbg, (mui_flags & MUI_F_DBG), dbg_paint, dbg_touch, dbg_move)
#endif
