# T17c2: điểm móc call-site (mỗi dòng: HOOK_BL(vaddr_của_lệnh_bl, đích_gốc, hàm_mới_trong_đoạn_menu)); inject_menu.py kiểm lệnh gốc là `bl đích_gốc` rồi sinh dòng so_patches.tsv.
# CommonUi::DrawItemDiscription 0x777a4: lời gọi BFont::DrawTextLine duy nhất (0x77abc) -> mui_cap_line: ở chế độ bắt (mui_cap_on) sao chép bộ đệm văn bản thay vì vẽ, ngược lại gọi BFont::DrawTextLine gốc (cùng 8 tham số).
HOOK_BL(0x77abc, 0x41940, mui_cap_line)
# L1/T7: cash shop miễn phí + hồi sinh offline (t7.c). 0xd9330 = bl NETWORK::netConnect(3) trong StateCashShop::Process; 0xd9350 = bl StateCashShop::SetPopupState (đóng popup sau netConnect); 0xdc188 = bl netConnect(5) trong StateGame::Process.
HOOK_BL(0xd9330, 0xc6428, t7_cash_netconnect)
HOOK_BL(0xd9350, 0xd7e50, t7_cash_popup)
HOOK_BL(0xdc188, 0xc6428, t7_game_revive)
HOOK_BL(0xd9a24, 0xd7e50, t7_cash_confirm)   # KeyPressed: popup xác nhận (loại 2) với chữ "Miễn phí"
# T16/dialog.c: khung hội thoại mới. 0x6f5c4 = bl DIALOG_INFO::SetFacePosition cuối EventProc::Event_SituateDialogText (ghi hình học hộp/chữ); 0x6df6c, 0x6dfa4 = bl EventProc::Event_DialogWindow
# trong Event_Draw (hộp + chữ + tên); 0x6df44, 0x6df7c = bl DIALOG_INFO::Draw_Face (chân dung); 0x68058, 0x68094 = hai bl Graphic::DrawImageBlending trong EventProc::EventSkipDraw (ảnh "#: Skip" -> nút Bỏ qua).
HOOK_BL(0x6f5c4, 0x6f370, dlg_setface)
HOOK_BL(0x6df6c, 0x6afd0, dlg_window)
HOOK_BL(0x6dfa4, 0x6afd0, dlg_window)
HOOK_BL(0x6df44, 0x6dd1c, dlg_face)
HOOK_BL(0x6df7c, 0x6dd1c, dlg_face)
HOOK_BL(0x68058, 0x5ae20, dlg_skip_a)
HOOK_BL(0x68094, 0x5ae20, dlg_skip_b)
# T16/dialog.c: Event_Key nhánh hội thoại ([this+0xa8]==57): 0x6d39c = bl BFont::IsTextFieldDrawComplete, 0x6d408 = bl BFont::GetTextFieldPageLen (bọc bằng cờ vn_state.force0 ở HD)
HOOK_BL(0x6d39c, 0x4112c, dlg_iscomplete)
HOOK_BL(0x6d408, 0x41080, dlg_pagelen)
# L3/T17c7: KeyMainMenu 0x11fc00 = bl StaticUtil::NumKeyToNaviKey: lưới 6 ô (phím điều hướng nhảy qua ô ẩn)
# [tạm dừng L3: chưa kiểm] HOOK_BL(0x11fc00, 0x140ae8, mm_navkey)
# T14/hud.c: HUD chiến đấu mới. 0x4492c = bl GMenu::DrawSkillBelt (Battle::Paint); trong DrawSkillBelt: 0x7fc84 khung ô (0x7fc1c/0x7fcd0 = biểu tượng ô rỗng/đang chọn: giữ để chụp), 0x7fd34 nút đổi (bl DrawEffect); trong DrawTouchUi: 0xdc29c/0xdc304 nút tấn công, 0xdc394/0xdc3f4 DASH (bl DrawImageBlending), 0xdcf9c/0xdcff0 thanh bản đồ-cửa hàng-lưu (DrawInfoRect/DrawText); 0x73dc4 = DrawImageBlending trong CommonUi::DrawTouchCancelUi (nút tạm dừng)
HOOK_BL(0x4492c, 0x7f9f8, hud_belt)
HOOK_BL(0x7fc84, 0x5b328, hud_fx_frame)
HOOK_BL(0x7fd34, 0x5b328, hud_fx_swap)
HOOK_BL(0xdc29c, 0x5ae20, hud_blend_att)
HOOK_BL(0xdc304, 0x5ae20, hud_blend_att)
HOOK_BL(0xdc394, 0x5ae20, hud_blend_dash)
HOOK_BL(0xdc3f4, 0x5ae20, hud_blend_dash)
HOOK_BL(0x73dc4, 0x5ae20, hud_blend_pause)
HOOK_BL(0xdcf9c, 0x74888, hud_rect_tab)
HOOK_BL(0xdcff0, 0x41d78, hud_text_tab)
