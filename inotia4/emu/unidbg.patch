+package com.github.unidbg.linux.android.dvm;
+
+import com.github.unidbg.pointer.UnidbgPointer;
+
+/** java.nio.ByteBuffer.allocateDirect gia: bo nho nam trong emulator. (them cho du an Inotia4) */
+public class DirectBuffer extends DvmObject<UnidbgPointer> {
+    public final long capacity;
+    public DirectBuffer(VM vm, UnidbgPointer ptr, long capacity) {
+        super(vm.resolveClass("java/nio/DirectByteBuffer"), ptr);
+        this.capacity = capacity;
+    }
